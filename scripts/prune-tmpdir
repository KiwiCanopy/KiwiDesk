#!/usr/bin/env python3
"""Remove the empty `TemporaryDirectory.*` folders Apple's build
tools leave in the per-user temp dir. A dry run by default;
--apply deletes.

Usage: scripts/prune-tmpdir [--apply] [--age-minutes N] [--dir D]
       [--timeout S]

A folder goes only when every clause holds:

  1. Its name starts `TemporaryDirectory.` and it is a real
     directory, never a symlink, directly under the temp dir.
  2. It holds nothing, or only regular files named
     `.keep-directory` or `inputs-<digits>.LinkFileList`: no
     subfolder, no symlink, no other name.
  3. The folder and every file in it are older than N minutes
     (default 60). This guard protects a build that another
     session is running at the same moment.

Nothing else in the temp dir is read past its name. Removal
unlinks the vetted files through the folder's own descriptor and
then calls rmdir, so a file that appears after the check keeps
the folder. The default temp dir is `getconf
DARWIN_USER_TEMP_DIR`. --timeout S ends the process after S
seconds (SIGALRM), keeping what it has removed.

`scripts/gate-lock` runs this inside its lock on the gated
command's temp dir, and a failure never fails the gate. Exit 1:
the temp dir cannot be read; 64: usage.
"""

import os
import re
import signal
import subprocess
import sys
import time

PREFIX = "TemporaryDirectory."
LEFTOVER = re.compile(r"\.keep-directory|inputs-[0-9]+\.LinkFileList")
USAGE = (
    "usage: scripts/prune-tmpdir [--apply] [--age-minutes N]"
    " [--dir D] [--timeout S]"
)


def user_temp_dir() -> str:
    try:
        out = subprocess.run(
            ["getconf", "DARWIN_USER_TEMP_DIR"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        out = ""
    return out or "/tmp/"


def leftovers(fd: int, cutoff: float) -> "list[str] | None":
    """The open folder's file names when clauses 2 and 3 hold,
    else None."""
    if os.fstat(fd).st_mtime >= cutoff:
        return None
    names = []
    with os.scandir(fd) as entries:
        for entry in entries:
            if not entry.is_file(follow_symlinks=False):
                return None
            if not LEFTOVER.fullmatch(entry.name):
                return None
            if entry.stat(follow_symlinks=False).st_mtime >= cutoff:
                return None
            names.append(entry.name)
    return names


def sweep(root: str, cutoff: float, apply: bool) -> int:
    """Removes (or counts) every qualifying folder under `root`.
    Each folder is opened without following a link and emptied
    through that descriptor, so a folder swapped for a symlink
    after the check is never followed."""
    removed = 0
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    try:
        with os.scandir(root) as entries:
            for entry in entries:
                if not entry.name.startswith(PREFIX):
                    continue
                try:
                    fd = os.open(entry.name, flags, dir_fd=root_fd)
                except OSError:
                    continue
                try:
                    names = leftovers(fd, cutoff)
                    if names is None:
                        continue
                    if apply:
                        for name in names:
                            os.unlink(name, dir_fd=fd)
                        os.rmdir(entry.name, dir_fd=root_fd)
                    removed += 1
                except OSError:
                    continue
                finally:
                    os.close(fd)
    finally:
        os.close(root_fd)
    return removed


def main(argv: "list[str]") -> int:
    apply, age, root, timeout = False, 60.0, None, None
    args = list(argv)
    while args:
        arg = args.pop(0)
        try:
            if arg == "--apply":
                apply = True
            elif arg == "--age-minutes":
                age = float(args.pop(0))
            elif arg == "--dir":
                root = args.pop(0)
            elif arg == "--timeout":
                timeout = float(args.pop(0))
            else:
                raise ValueError(arg)
        except (IndexError, ValueError):
            print(USAGE, file=sys.stderr)
            return 64
    root = root or user_temp_dir()
    if timeout is not None:
        # A hard deadline: SIGALRM's default action ends the
        # process, even one stalled inside a call.
        signal.alarm(max(1, int(timeout)))
    try:
        removed = sweep(root, time.time() - age * 60, apply)
    except OSError as error:
        print(f"prune-tmpdir: {error}", file=sys.stderr)
        return 1
    verb = "removed" if apply else "would remove"
    print(f"prune-tmpdir: {verb} {removed} {PREFIX}* folder(s) in {root}")
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
