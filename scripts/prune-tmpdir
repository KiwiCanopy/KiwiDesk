#!/usr/bin/env python3
"""Remove the empty `TemporaryDirectory.*` folders Apple's build
tools leave in the per-user temp dir. A dry run by default;
--apply deletes.

Usage: scripts/prune-tmpdir [--apply] [--age-minutes N] [--dir D]
       [--timeout S]

A folder goes only when every clause holds:

  1. Its name starts `TemporaryDirectory.` and it is a real
     directory, never a symlink, directly under the temp dir.
  2. It holds nothing, or only regular files named
     `.keep-directory` or `inputs-<digits>.LinkFileList`: no
     subfolder, no symlink, no other name.
  3. The folder and every file in it are older than N minutes
     (default 60). This guard protects a build that another
     session is running at the same moment.

Nothing else in the temp dir is read past its name. Removal
unlinks the vetted files and then calls rmdir, so a file that
appears after the check keeps the folder. The default temp dir is
`getconf DARWIN_USER_TEMP_DIR`, as in `scripts/gate-lock`.
--timeout S stops the sweep after S seconds, keeping what it has
removed. `scripts/gate-lock` runs this inside its lock on its own
lock dir, and a failure never fails the gate. Exit 64: usage.
"""

import os
import re
import subprocess
import sys
import time

PREFIX = "TemporaryDirectory."
LEFTOVER = re.compile(r"\.keep-directory|inputs-[0-9]+\.LinkFileList")
USAGE = (
    "usage: scripts/prune-tmpdir [--apply] [--age-minutes N]"
    " [--dir D] [--timeout S]"
)


def user_temp_dir() -> str:
    try:
        out = subprocess.run(
            ["getconf", "DARWIN_USER_TEMP_DIR"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        out = ""
    return out or "/tmp/"


def leftovers(folder: str, cutoff: float) -> "list[str] | None":
    """The folder's files when clauses 2 and 3 hold, else None."""
    if os.lstat(folder).st_mtime >= cutoff:
        return None
    files = []
    with os.scandir(folder) as entries:
        for entry in entries:
            if not entry.is_file(follow_symlinks=False):
                return None
            if not LEFTOVER.fullmatch(entry.name):
                return None
            if entry.stat(follow_symlinks=False).st_mtime >= cutoff:
                return None
            files.append(entry.path)
    return files


def main(argv: "list[str]") -> int:
    apply, age, root, timeout = False, 60.0, None, None
    args = list(argv)
    while args:
        arg = args.pop(0)
        try:
            if arg == "--apply":
                apply = True
            elif arg == "--age-minutes":
                age = float(args.pop(0))
            elif arg == "--dir":
                root = args.pop(0)
            elif arg == "--timeout":
                timeout = float(args.pop(0))
            else:
                raise ValueError(arg)
        except (IndexError, ValueError):
            print(USAGE, file=sys.stderr)
            return 64
    root = root or user_temp_dir()
    cutoff = time.time() - age * 60
    deadline = None if timeout is None else time.monotonic() + timeout
    removed = 0
    with os.scandir(root) as entries:
        for entry in entries:
            if not entry.name.startswith(PREFIX):
                continue
            if deadline is not None and time.monotonic() > deadline:
                break
            try:
                if not entry.is_dir(follow_symlinks=False):
                    continue
                files = leftovers(entry.path, cutoff)
                if files is None:
                    continue
                if apply:
                    for path in files:
                        os.unlink(path)
                    os.rmdir(entry.path)
                removed += 1
            except OSError:
                continue
    verb = "removed" if apply else "would remove"
    print(f"prune-tmpdir: {verb} {removed} {PREFIX}* folder(s) in {root}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
