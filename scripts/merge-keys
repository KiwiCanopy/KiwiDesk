#!/usr/bin/env python3
"""Fold a translated missing_<locale>.json back into
<locale>.json (issue #9) and delete the temp file.

Usage:
    scripts/merge-keys <locale>
    scripts/merge-keys --site <locale>

Add `--site` to fold into the marketing site's manifests
(`site/src/i18n/<locale>.json`) after `scripts/extract-keys
--site <locale>`, instead of the Swift app's locale dir. Every
other rule below is identical for both.

Run after `scripts/extract-keys <locale>` produced
`missing_<locale>.json` — a `{key: {"source": <English>,
"translation": ""}}` map — and a translator has filled each
entry's "translation" field in place (do not change the keys or
the "source" field).

Only entries whose "translation" is non-empty (after trimming
whitespace) are folded into `<locale>.json`; any left empty are
skipped so they re-surface the next time `scripts/extract-keys
<locale>` runs, instead of silently vanishing as "translated"
with a blank value. `<locale>.json` itself stays a flat `{key:
string}` map — the source/translation shape is scratch-file-only
and never reaches the file `LocaleCatalog` loads at runtime.
"""

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LOCALES_DIR = (
    ROOT / "Sources" / "KiwiDeskCore" / "Resources" / "Locales"
)


def main(argv: list[str]) -> int:
    global LOCALES_DIR
    args = argv[1:]
    site = "--site" in args
    flag = "--site " if site else ""
    if site:
        args = [a for a in args if a != "--site"]
        LOCALES_DIR = ROOT / "site" / "src" / "i18n"
    if len(args) != 1:
        print(__doc__)
        return 1
    locale = args[0]
    missing_file = LOCALES_DIR / f"missing_{locale}.json"
    locale_file = LOCALES_DIR / f"{locale}.json"

    if not missing_file.exists():
        print(
            f"merge-keys: {missing_file} does not exist — run "
            f"scripts/extract-keys {flag}{locale} first.",
            file=sys.stderr,
        )
        return 1

    entries = json.loads(missing_file.read_text(encoding="utf-8"))
    translated: dict[str, str] = {}
    skipped: list[str] = []
    for key, entry in entries.items():
        value = entry.get("translation", "").strip()
        if value:
            translated[key] = value
        else:
            skipped.append(key)

    existing: dict[str, str] = {}
    if locale_file.exists():
        existing = json.loads(
            locale_file.read_text(encoding="utf-8")
        )

    existing.update(translated)
    LOCALES_DIR.mkdir(parents=True, exist_ok=True)
    locale_file.write_text(
        json.dumps(
            existing, indent=2, sort_keys=True, ensure_ascii=False
        )
        + "\n",
        encoding="utf-8",
    )
    missing_file.unlink()
    print(
        f"merge-keys: merged {len(translated)} key(s) into "
        f"{locale_file} ({len(existing)} total); removed "
        f"{missing_file.name}."
    )
    if skipped:
        print(
            f"merge-keys: {len(skipped)} key(s) still had an "
            "empty \"translation\" and were skipped — they "
            f"will re-appear next time you run "
            f"scripts/extract-keys {flag}{locale}:"
        )
        for key in sorted(skipped):
            print(f"    - {key}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
