#!/usr/bin/env python3
"""Fold a translated missing_<locale>.json back into
<locale>.json (issue #9) and delete the temp file.

Usage:
    scripts/merge-keys <locale>
    scripts/merge-keys --site <locale>

Add `--site` to fold into the marketing site's manifests
(`site/src/i18n/<locale>.json`) after `scripts/extract-keys
--site <locale>`, instead of the Swift app's locale dir. Every
other rule below is identical for both.

Run after `scripts/extract-keys <locale>` produced
`locale-worksheets/missing_<locale>.json` — a `{key: {"source":
<English>, "translation": ""}}` map — and a translator has filled
each entry's "translation" field in place (do not change the keys
or the "source" field). The worksheet lives outside the catalog
directory on purpose; `<locale>.json` is written back into it.

Only entries whose "translation" is non-empty (after trimming
whitespace) are folded into `<locale>.json`; any left empty are
skipped so they re-surface the next time `scripts/extract-keys
<locale>` runs, instead of silently vanishing as "translated"
with a blank value. `<locale>.json` itself stays a flat `{key:
string}` map — the source/translation shape is scratch-file-only
and never reaches the file `LocaleCatalog` loads at runtime.

An entry is also skipped when the translation is broken *content* —
the wrong writing system for the locale, untranslated English
carrying a locale tag, or English words left inside an otherwise
translated sentence. These are the same predicates
`scripts/extract-keys --check` gates the whole corpus on
(`scripts/localization_guards`), applied per entry so a bad
worksheet never reaches a committed catalog. See
docs/translating.md.

An entry is also skipped when its stored "source" no longer
matches the key's current English in `en.json` (issue #252). A
worksheet is filled out over days; in that window the English
meaning can change in code and `scripts/drop-key` can retire the
old translations. Merging on non-emptiness alone would silently
resurrect a translation of the *old* meaning — defeating exactly
what drop-key retired, with nothing able to flag it afterwards.
Comparing against the stored source costs nothing (extract-keys
already writes it) and closes that window.

Three things that guard is deliberately NOT:

- It compares *text*, not meaning, so a cosmetic English edit (a
  typo, punctuation) also invalidates a finished entry. §5 says
  cosmetic edits keep translations, so this is stricter than the
  convention — kept anyway, because a script cannot tell the two
  apart and erring toward "re-translate" is the safe direction.
- Its authority is the committed `en.json`, not the `L()` call
  sites. An English edit that has not been re-extracted yet
  compares equal and merges. That window is bounded by
  `extract-keys --check`, which `scripts/lint.sh` and
  `scripts/pre-commit` run unconditionally and which hard-fails
  on a stale `en.json` — so relaxing *that* check would silently
  widen this race back open.
- Recovery is not universal. A skipped key re-surfaces on the
  next `extract-keys` run only because `write_missing` re-mints
  keys the locale file does not already have. If the key already
  carries a translation, nothing re-mints it and the skipped
  text is simply discarded. Every worksheet extract-keys itself
  mints satisfies that precondition; a hand-written entry for an
  already-translated key does not.
"""

# `dict | None` and `str | None` below are evaluated at def time, so
# without this the module will not import on the system python3
# (3.9) — see scripts/localization_guards.py.
from __future__ import annotations

import json
import sys
from pathlib import Path

from locale_paths import (
    site_override_conflict,
    worksheet_name,
    worksheets_dir,
)
from localization_guards import (
    dropped_product_names,
    english_residue,
    foreign_scripts,
    placeholder_drift,
    tagged_stub,
    untranslated_mode_names,
)

ROOT = Path(__file__).resolve().parent.parent
LOCALES_DIR = (
    ROOT / "Sources" / "KiwiDeskCore" / "Resources" / "Locales"
)
# Where `scripts/extract-keys` leaves the worksheet — read here
# and unlinked here; `<locale>.json` is still written under
# `LOCALES_DIR`. `scripts/locale_paths.py` is the one definition,
# imported rather than re-derived: a second literal would agree
# only until the override is set, and the symptom is this script
# reporting "does not exist" for a file just written.
WORKSHEETS_DIR = worksheets_dir(ROOT)
SITE_WORKSHEETS_DIR = worksheets_dir(ROOT, site=True)


def _load_map(path: Path, label: str) -> dict | None:
    """Decodes a JSON object, reporting a malformed file in the
    script's own voice instead of a raw traceback. Returns None
    on failure; every caller aborts before writing anything."""
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except (
        json.JSONDecodeError,
        UnicodeDecodeError,
        OSError,
    ) as error:
        # UnicodeDecodeError matters as much as bad JSON here: the
        # worksheet is the one file in this pipeline a non-developer
        # edits, and an editor that saves it as Latin-1 would
        # otherwise dump a traceback.
        print(
            f"merge-keys: {label} could not be read ({error}) — "
            "nothing was merged.",
            file=sys.stderr,
        )
        return None
    if not isinstance(loaded, dict):
        print(
            f"merge-keys: {label} must be a JSON object — "
            "nothing was merged.",
            file=sys.stderr,
        )
        return None
    return loaded


def _content_defect(
    locale: str, value: str, english: str, residue: bool = True
) -> str | None:
    """Why `value` must not be written to `<locale>.json`, or None.

    Shares its predicates with `extract-keys --check` through
    `scripts/localization_guards` rather than re-deriving them: a
    divergent copy here would admit exactly what the gate rejects,
    so a translator would merge cleanly and then be unable to
    commit.
    """
    scripts = foreign_scripts(locale, value)
    if scripts:
        return (
            f"contains {' + '.join(scripts)} characters, which "
            f"{locale} does not use"
        )
    tag = tagged_stub(locale, value)
    if tag:
        return f"is untranslated English tagged ({tag})"
    drift = placeholder_drift(value, english)
    if drift:
        return f"{drift} relative to the English"
    dropped = dropped_product_names(value, english)
    if dropped:
        return (
            "translates the untranslated feature name(s) "
            f"{', '.join(dropped)}"
        )
    # Ordered above the `residue` gate to match `check_content`:
    # the feature-name guard applies to every locale and every
    # corpus, so site mode runs it too.
    if not residue:
        return None
    left = english_residue(locale, value, english)
    if left:
        return (
            "still carries the English word(s) "
            f"{', '.join(left)}"
        )
    return None


def main(argv: list[str]) -> int:
    global LOCALES_DIR, WORKSHEETS_DIR
    args = argv[1:]
    site = "--site" in args
    flag = "--site " if site else ""
    conflict = site_override_conflict(site)
    if conflict:
        print(f"merge-keys --site: {conflict}", file=sys.stderr)
        return 1
    if site:
        args = [a for a in args if a != "--site"]
        LOCALES_DIR = ROOT / "site" / "src" / "i18n"
        WORKSHEETS_DIR = SITE_WORKSHEETS_DIR
    if len(args) != 1:
        print(__doc__)
        return 1
    locale = args[0]
    missing_file = WORKSHEETS_DIR / worksheet_name(locale)
    locale_file = LOCALES_DIR / f"{locale}.json"

    if not missing_file.exists():
        # Name the directory, not just the command. A translator
        # holding a worksheet that is somewhere else — handed
        # over, or minted before worksheets moved out of the
        # catalog directory — would otherwise follow the advice
        # literally, mint an empty one here, and leave the filled
        # file unread. Moving it is the whole recovery; nothing
        # but this path is read.
        print(
            f"merge-keys: {missing_file} does not exist — run "
            f"scripts/extract-keys {flag}{locale} first, or move "
            f"an existing worksheet into {missing_file.parent} "
            "(no other location is read).",
            file=sys.stderr,
        )
        return 1

    english_file = LOCALES_DIR / "en.json"
    if not english_file.exists():
        print(
            f"merge-keys: {english_file} does not exist — cannot "
            "verify that any worksheet entry still matches its "
            "English source, so nothing was merged.",
            file=sys.stderr,
        )
        return 1
    english = _load_map(english_file, "en.json")
    if english is None:
        return 1

    entries = _load_map(missing_file, missing_file.name)
    if entries is None:
        return 1

    translated: dict[str, str] = {}
    skipped: list[str] = []
    stale: list[str] = []
    unverifiable: list[str] = []
    broken: dict[str, str] = {}
    for key, entry in entries.items():
        if not isinstance(entry, dict):
            unverifiable.append(key)
            continue
        value = entry.get("translation")
        if not isinstance(value, str):
            # Not an empty translation — a malformed one. Report
            # it with the other unverifiable entries rather than
            # telling the user it was left blank.
            unverifiable.append(key)
            continue
        if not value.strip():
            skipped.append(key)
            continue
        # The stored source is the English the translator saw.
        # A non-string source is unverifiable, and so is a key
        # `en.json` no longer has — note both must be checked
        # explicitly: comparing `entry.get("source")` against
        # `english.get(key)` reads equal when BOTH are absent,
        # which would merge unverifiable text for a key the app
        # no longer ships (the one combination the guard most
        # needs to catch).
        source = entry.get("source")
        current = english.get(key)
        if not isinstance(source, str) or not isinstance(
            current, str
        ):
            unverifiable.append(key)
            continue
        if source != current:
            stale.append(key)
            continue
        text = value.strip()
        # The same predicates `extract-keys --check` gates on, run
        # per entry so contamination is never written in the first
        # place — the verify gate would catch it either way, but
        # only after it had landed in a committed catalog. These
        # keys are absent from <locale>.json by construction (that
        # is why the worksheet held them), so the re-mint recovery
        # above applies to them unchanged.
        defect = _content_defect(
            locale, text, current, residue=not site
        )
        if defect:
            broken[key] = defect
            continue
        translated[key] = text

    existing: dict[str, str] = {}
    if locale_file.exists():
        loaded = _load_map(locale_file, locale_file.name)
        if loaded is None:
            return 1
        existing = loaded

    # The mode-name guard runs as a SECOND pass, unlike the
    # per-value predicates above, because it reads this locale's
    # own `layout.<mode>.name` — which the same worksheet may be
    # translating. Judging each entry as it arrives would make the
    # verdict depend on worksheet key order: prose merged before
    # its picker would be checked against the old picker. So the
    # projected catalog (what the file will contain once every
    # candidate lands) is built first, and every candidate is
    # judged against that.
    projected = dict(existing)
    projected.update(translated)
    for key in sorted(translated):
        kept = untranslated_mode_names(
            translated[key], projected, english
        )
        if kept:
            broken[key] = (
                "keeps the English mode name(s) "
                f"{', '.join(kept)} while this locale's own "
                "picker translates them"
            )
            del translated[key]

    existing.update(translated)
    LOCALES_DIR.mkdir(parents=True, exist_ok=True)
    locale_file.write_text(
        json.dumps(
            existing, indent=2, sort_keys=True, ensure_ascii=False
        )
        + "\n",
        encoding="utf-8",
    )
    missing_file.unlink()
    # Leave no empty worksheet tree behind: `locale-worksheets/`
    # existing but empty reads as "a pass is open" to anyone who
    # looks. `rmdir` refuses a non-empty directory, so a second
    # locale still mid-translation keeps it.
    # Deepest first, deduped: site mode's worksheet sits one
    # level down, app mode's is the base itself. Never walks
    # above the base — `rmdir` on a repo root that happened to be
    # empty is not a thing this script should be able to do.
    for directory in dict.fromkeys(
        (missing_file.parent, worksheets_dir(ROOT))
    ):
        try:
            directory.rmdir()
        except OSError:
            break
    # The dropped count rides the summary line, because that is
    # the line a human skims and a wrapper captures — a bare
    # "merged 0 key(s)" reads as a clean success.
    dropped = len(stale) + len(unverifiable) + len(broken)
    tail = f" {dropped} dropped, see stderr." if dropped else ""
    print(
        f"merge-keys: merged {len(translated)} key(s) into "
        f"{locale_file} ({len(existing)} total); removed "
        f"{missing_file.name}.{tail}"
    )
    if skipped:
        print(
            f"merge-keys: {len(skipped)} key(s) still had an "
            "empty \"translation\" and were skipped — they "
            f"will re-appear next time you run "
            f"scripts/extract-keys {flag}{locale}:"
        )
        for key in sorted(skipped):
            print(f"    - {key}")
    # Two distinct reasons, reported apart: telling someone their
    # English changed when the entry simply never carried a
    # "source" reads as a tool bug.
    _report_dropped(
        stale,
        entries,
        "the English changed since extraction, so the "
        "translation would have been of the old meaning",
        flag,
        locale,
    )
    if broken:
        print(
            f"merge-keys: {len(broken)} key(s) were skipped "
            "because the translation itself is broken content "
            "(see docs/translating.md). Fix the text and re-run "
            f"scripts/extract-keys {flag}{locale} to get the "
            "entries back:",
            file=sys.stderr,
        )
        for key in sorted(broken):
            entry = entries.get(key)
            value = (
                entry.get("translation")
                if isinstance(entry, dict)
                else ""
            )
            print(
                f"    - {key}: {broken[key]} — {value!r}",
                file=sys.stderr,
            )
    _report_dropped(
        unverifiable,
        entries,
        "the entry carried no usable \"source\" (or was not in "
        "the worksheet's {\"source\", \"translation\"} shape at "
        "all), or the key is no longer in en.json — either way "
        "nothing could be verified",
        flag,
        locale,
    )
    return 0


def _report_dropped(
    keys: list[str],
    entries: dict,
    reason: str,
    flag: str,
    locale: str,
) -> None:
    """Warns about entries that were dropped rather than merged.
    Echoes each discarded translation: the worksheet is unlinked
    either way, so this transcript is the only copy left."""
    if not keys:
        return
    print(
        f"merge-keys: {len(keys)} key(s) were skipped because "
        f"{reason}. Re-run scripts/extract-keys {flag}{locale} "
        "to get them back with the current English (that only "
        "re-mints keys the locale file does not already have). "
        "The discarded text is echoed here — it is not saved "
        "anywhere else:",
        file=sys.stderr,
    )
    for key in sorted(keys):
        entry = entries.get(key)
        # A bare-string entry (`{"a.key": "Ein Text"}`) is the
        # likeliest hand-written shape, and it is exactly the one
        # the dict branch alone would echo as '' — which would
        # make this transcript silently lose the text it promises
        # to preserve.
        text = entry if isinstance(entry, str) else ""
        if isinstance(entry, dict):
            value = entry.get("translation")
            text = value if isinstance(value, str) else ""
        print(f"    - {key}: {text!r}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
