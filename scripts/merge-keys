#!/usr/bin/env python3
"""Fold a translated missing_<locale>.json back into
<locale>.json (issue #9) and delete the temp file.

Usage:
    scripts/merge-keys <locale>
    scripts/merge-keys --site <locale>

Add `--site` to fold into the marketing site's manifests
(`site/src/i18n/<locale>.json`) after `scripts/extract-keys
--site <locale>`, instead of the Swift app's locale dir. Every
other rule below is identical for both.

Run after `scripts/extract-keys <locale>` produced
`missing_<locale>.json` — a `{key: {"source": <English>,
"translation": ""}}` map — and a translator has filled each
entry's "translation" field in place (do not change the keys or
the "source" field).

Only entries whose "translation" is non-empty (after trimming
whitespace) are folded into `<locale>.json`; any left empty are
skipped so they re-surface the next time `scripts/extract-keys
<locale>` runs, instead of silently vanishing as "translated"
with a blank value. `<locale>.json` itself stays a flat `{key:
string}` map — the source/translation shape is scratch-file-only
and never reaches the file `LocaleCatalog` loads at runtime.

An entry is also skipped when its stored "source" no longer
matches the key's current English in `en.json` (issue #252). A
worksheet is filled out over days; in that window the English
meaning can change in code and `scripts/drop-key` can retire the
old translations. Merging on non-emptiness alone would silently
resurrect a translation of the *old* meaning — defeating exactly
what drop-key retired, with nothing able to flag it afterwards.
Comparing against the stored source costs nothing (extract-keys
already writes it) and closes that window: the stale entry is
skipped with a warning and re-surfaces on the next extract run,
carrying the new English.
"""

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LOCALES_DIR = (
    ROOT / "Sources" / "KiwiDeskCore" / "Resources" / "Locales"
)


def main(argv: list[str]) -> int:
    global LOCALES_DIR
    args = argv[1:]
    site = "--site" in args
    flag = "--site " if site else ""
    if site:
        args = [a for a in args if a != "--site"]
        LOCALES_DIR = ROOT / "site" / "src" / "i18n"
    if len(args) != 1:
        print(__doc__)
        return 1
    locale = args[0]
    missing_file = LOCALES_DIR / f"missing_{locale}.json"
    locale_file = LOCALES_DIR / f"{locale}.json"

    if not missing_file.exists():
        print(
            f"merge-keys: {missing_file} does not exist — run "
            f"scripts/extract-keys {flag}{locale} first.",
            file=sys.stderr,
        )
        return 1

    english_file = LOCALES_DIR / "en.json"
    if not english_file.exists():
        print(
            f"merge-keys: {english_file} does not exist — cannot "
            "verify that any worksheet entry still matches its "
            "English source, so nothing was merged.",
            file=sys.stderr,
        )
        return 1
    english: dict[str, str] = json.loads(
        english_file.read_text(encoding="utf-8")
    )

    entries = json.loads(missing_file.read_text(encoding="utf-8"))
    translated: dict[str, str] = {}
    skipped: list[str] = []
    stale: list[str] = []
    for key, entry in entries.items():
        value = entry.get("translation", "").strip()
        if not value:
            skipped.append(key)
            continue
        # The stored source is the English the translator saw.
        # A missing "source" is unverifiable, so it counts as a
        # mismatch — a hand-written worksheet gets the same guard
        # as a generated one rather than an exemption from it.
        if entry.get("source") != english.get(key):
            stale.append(key)
            continue
        translated[key] = value

    existing: dict[str, str] = {}
    if locale_file.exists():
        existing = json.loads(
            locale_file.read_text(encoding="utf-8")
        )

    existing.update(translated)
    LOCALES_DIR.mkdir(parents=True, exist_ok=True)
    locale_file.write_text(
        json.dumps(
            existing, indent=2, sort_keys=True, ensure_ascii=False
        )
        + "\n",
        encoding="utf-8",
    )
    missing_file.unlink()
    print(
        f"merge-keys: merged {len(translated)} key(s) into "
        f"{locale_file} ({len(existing)} total); removed "
        f"{missing_file.name}."
    )
    if skipped:
        print(
            f"merge-keys: {len(skipped)} key(s) still had an "
            "empty \"translation\" and were skipped — they "
            f"will re-appear next time you run "
            f"scripts/extract-keys {flag}{locale}:"
        )
        for key in sorted(skipped):
            print(f"    - {key}")
    if stale:
        print(
            f"merge-keys: {len(stale)} key(s) were skipped "
            "because the English changed since extraction — the "
            "translation would have been of the old meaning. "
            f"Re-run scripts/extract-keys {flag}{locale} to get "
            "them back with the new English:",
            file=sys.stderr,
        )
        for key in sorted(stale):
            print(f"    - {key}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
