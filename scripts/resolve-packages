#!/bin/bash
# CI's package resolve (#3591): strictly from Package.resolved, so
# a stale or broken pin fails; on failure, clear the clone folders
# and try exactly once more. The user-global SwiftPM clone cache
# is cleared only under CI=true, never on a developer's Mac.
#
# Usage: scripts/resolve-packages
# KIWIDESK_RESOLVE_SWIFT names the swift binary; a test seam.
set -uo pipefail

SWIFT="${KIWIDESK_RESOLVE_SWIFT:-swift}"

resolve() {
    "$SWIFT" package resolve --only-use-versions-from-resolved-file
}

if resolve; then
    exit 0
fi

echo "::warning::swift package resolve failed; clearing the" \
    "repository clones and retrying once (#3591)"
rm -rf .build/repositories
if [ "${CI:-}" = "true" ]; then
    rm -rf "$HOME/Library/Caches/org.swift.swiftpm/repositories"
fi

resolve
STATUS=$?
if [ "$STATUS" -eq 0 ]; then
    exit 0
fi
echo "::error::swift package resolve failed twice; a second" \
    "failure is a real one (check Package.resolved)" >&2
exit "$STATUS"
