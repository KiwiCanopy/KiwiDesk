#!/bin/bash
# KiwiDesk pre-commit hook: lint staged Swift files, and run the
# locale freshness/drift/shape check whenever a locale JSON file
# is staged (issue #9) — even if no Swift file is staged, so a
# translator committing only Resources/Locales/de.json still
# gets instant local feedback instead of waiting for CI.
# Installed by scripts/install-hooks.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
STATUS=0

# Refuse a commit made while HEAD is `main`.
#
# The repo cannot have server-side branch protection while it is
# private: GitHub's free plan answers `403 Upgrade to GitHub Pro or
# make this repository public`, so protection only unlocks at the
# public flip (#487). And the exposure that flip closes is NOT an
# outside push — nobody but the owner has write access, and going
# public grants the world read, not write. It is committing to
# `main` while believing HEAD is a feature branch, which has already
# happened once when HEAD moved under a long session.
#
# Deliberately gates the COMMIT, not the push: ff-merging a reviewed
# branch legitimately writes to `main` (`git push origin HEAD:main`),
# so a push-side block would fire on every intended merge and train
# everyone to bypass it.
#
# Override for a genuinely-intended commit straight onto `main` (a
# translation merge, a one-line doc fix):
#
#     KIWIDESK_ALLOW_MAIN_COMMIT=1 git commit …
#
# `--no-verify` also works, but the env var names the rule you meant
# to skip instead of skipping the lint and locale checks with it.
BRANCH="$(git symbolic-ref --quiet --short HEAD || echo "")"
if [ "$BRANCH" = "main" ] \
    && [ "${KIWIDESK_ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
    echo "pre-commit: refusing to commit on 'main'."
    echo "  AGENTS.md §3: branch per change (feat/, fix/, chore/…)," \
        "then ff-merge."
    echo "  If HEAD being 'main' is a surprise, this hook just" \
        "saved you a commit on the wrong branch."
    echo "  Intended? KIWIDESK_ALLOW_MAIN_COMMIT=1 git commit …"
    exit 1
fi

STAGED_SWIFT=()
while IFS= read -r f; do
    STAGED_SWIFT+=("$ROOT/$f")
done < <(git diff --cached --name-only --diff-filter=ACM \
    | grep '\.swift$' || true)

STAGED_LOCALES=()
while IFS= read -r f; do
    STAGED_LOCALES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM \
    | grep '^Sources/KiwiDeskCore/Resources/Locales/.*\.json$' \
    || true)

if [ "${#STAGED_SWIFT[@]}" -gt 0 ]; then
    echo "pre-commit: linting ${#STAGED_SWIFT[@]} staged" \
        "Swift file(s)..."
    # lint.sh already runs `extract-keys --check` unconditionally
    # at the end, regardless of the file list passed to it — this
    # also covers the locale check when both Swift and locale
    # files are staged together.
    if ! "$ROOT/scripts/lint.sh" "${STAGED_SWIFT[@]}"; then
        STATUS=1
    fi
    if ! python3 "$ROOT/scripts/check-doc-anchors"; then
        STATUS=1
    fi
elif [ "${#STAGED_LOCALES[@]}" -gt 0 ]; then
    echo "pre-commit: ${#STAGED_LOCALES[@]} staged locale" \
        "file(s), running extract-keys --check..."
    if ! python3 "$ROOT/scripts/extract-keys" --check; then
        STATUS=1
    fi
fi

exit $STATUS
