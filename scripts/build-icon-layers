#!/usr/bin/env python3
"""Re-derive the app icon's layer art from assets/logo.svg (#89).

`assets/AppIcon.icon` is an Icon Composer document. Its two layer
files are *derived* from the mark master, not hand-drawn — so a
change to `logo.svg`'s shape is reapplied by re-running this, not
by editing the layers. That keeps the README's "logo.svg is the
single mark master, do not add a second copy" rule true for the
app icon too (the OG banner kept a retired teal shell through a
whole rebrand precisely because its copy was hand-maintained).

What it does NOT touch: `icon.json`. The fill, shadow, glass and
translucency there are hand-tuned in Icon Composer and carry no
geometry, so regenerating layers never clobbers that tuning.

The mark's forest-ink (`#12251a`) is one compound path holding
the outer ring, the twelve seeds and the five window subpaths.
They are told apart by size, not by index, so re-exporting
`logo.svg` from a vector editor (which reorders paths freely)
does not silently mis-sort them. The expected counts are then
asserted: a shape change that adds or drops a subpath fails here
loudly instead of shipping a wrong icon.

The outer ring is deliberately dropped — on macOS 26 the
squircle *is* the container, and keeping the ring would nest one
container inside another.
"""

import json
import re
import sys
from pathlib import Path

INK = "#12251a"          # mark shell ink: ring + seeds + window
OUTLINE = "#d7e9ba"      # the window glyph's inner outline
N_RING, N_WINDOW, N_SEEDS = 2, 5, 12

_N = r"[-+]?(?:\d*\.\d+|\d+)(?:[eE][-+]?\d+)?"
NUM = re.compile(_N)
CMD = re.compile(r"([MmZzLlHhVvCcSsQqTtAa])")
ARGC = dict(M=2, L=2, H=1, V=1, C=6, S=4, Q=4, T=2, A=7, Z=0)

# An arc cannot be read with a plain number scan. Its two flags are
# single digits whose grammar production is "0" | "1", and they are
# allowed to run into the next number with no separator — `svgo` and
# Illustrator's minifier both emit that form. Scanned as numbers,
# `a438 438 0 011-27.32` reads as FIVE values, not seven, and the
# whole arc was silently dropped: `cur` never advanced, so every
# later coordinate in the subpath shifted by the missing delta while
# the subpath COUNT stayed right — sailing straight past the
# assertion in main(). `logo.svg`'s one arc is space-separated
# today, so this was correct only by luck.
_SEP = r"[,\s]*"
ARC = re.compile(
    f"({_N}){_SEP}({_N}){_SEP}({_N}){_SEP}"   # rx ry x-axis-rotation
    f"([01]){_SEP}([01]){_SEP}"               # large-arc, sweep
    f"({_N}){_SEP}({_N})"                     # x y
)


def tokens(d):
    """Yield (command, args) with implicit repeats expanded."""
    parts = CMD.split(d)
    for i in range(1, len(parts), 2):
        cmd, arg = parts[i], parts[i + 1]
        n = ARGC[cmd.upper()]
        if n == 0:
            yield cmd, []
            continue

        if cmd in "Aa":
            spans, count = [], 0
            for m in ARC.finditer(arg):
                spans.append((m.start(), m.end()))
                count += 1
                yield cmd, [float(g) for g in m.groups()]
            rest = arg
            for s, e in reversed(spans):
                rest = rest[:s] + rest[e:]
            if not count or rest.strip(", \t\r\n"):
                sys.exit(f"unparsable arc group '{cmd}{arg}' in "
                         "logo.svg — the arc regex did not consume "
                         "it whole. Fix the regex; never let an arc "
                         "fall through, it corrupts every later "
                         "point in its subpath.")
            continue

        nums = [float(x) for x in NUM.findall(arg)]
        # A short or ragged group means the scan misread the path.
        # Failing loudly beats dropping it: a dropped command
        # leaves the subpath count intact and the geometry wrong.
        if not nums or len(nums) % n:
            sys.exit(f"malformed '{cmd}' group in logo.svg: "
                     f"{len(nums)} argument(s), expected a multiple "
                     f"of {n}.")
        for k in range(0, len(nums), n):
            # a repeated moveto is an implicit lineto
            c = cmd
            if k and cmd in "Mm":
                c = "L" if cmd == "M" else "l"
            yield c, nums[k:k + n]


def subpaths(d):
    """Split `d` into absolute-start subpaths with their bboxes.

    Each subpath keeps its original commands and winding
    direction, so a subset re-joined into one `d` still renders
    its holes under the default nonzero fill rule.
    """
    cur = [0.0, 0.0]
    start = [0.0, 0.0]
    out, buf, pts = [], [], []

    def flush():
        if not buf:
            return
        xs = [p[0] for p in pts]
        ys = [p[1] for p in pts]
        out.append((" ".join(buf),
                    (min(xs), min(ys), max(xs), max(ys))))

    for cmd, a in tokens(d):
        up, rel = cmd.upper(), cmd.islower()
        if up == "M":
            flush()
            buf, pts = [], []
            x, y = (cur[0] + a[0], cur[1] + a[1]) if rel else a
            cur, start = [x, y], [x, y]
            buf.append("M%.3f,%.3f" % (x, y))
            pts.append((x, y))
            continue
        if up == "Z":
            buf.append("Z")
            cur = start[:]
            continue
        if up == "A":
            # large-arc and sweep are the grammar production
            # "0" | "1" — emitted as %.3f a conforming parser
            # errors at `.000` and discards the arc and every
            # command after it in the element.
            fmt = ("%.3f", "%.3f", "%.3f", "%d", "%d",
                   "%.3f", "%.3f")
            buf.append(cmd + ",".join(
                f % v for f, v in zip(fmt, a)))
        else:
            buf.append(cmd + ",".join("%.3f" % v for v in a))
        if up == "H":
            cur[0] = cur[0] + a[0] if rel else a[0]
        elif up == "V":
            cur[1] = cur[1] + a[0] if rel else a[0]
        elif up == "A":
            cur = ([cur[0] + a[5], cur[1] + a[6]] if rel
                   else [a[5], a[6]])
        else:
            dx, dy = a[-2], a[-1]
            base = (cur[0], cur[1])
            cur = [base[0] + dx, base[1] + dy] if rel else [dx, dy]
            for k in range(0, len(a) - 2, 2):
                pts.append((base[0] + a[k], base[1] + a[k + 1])
                           if rel else (a[k], a[k + 1]))
        pts.append(tuple(cur))
    flush()
    return out


def classify(subs, w, h):
    """Sort subpaths into ring / window / seeds by size alone.

    Measured against the current master (fractions of the
    artboard): the two ring subpaths are 0.994 and 0.935 wide,
    the window parts run 0.626 down to 0.257, and the widest
    seed is 0.062. Both cuts sit in empty bands — 0.626..0.935
    for the ring and 0.062..0.257 for the window — so each
    threshold is placed mid-band rather than snug against the
    nearest real value. The inner ring is the tight one: at a
    0.9 cut it had under 4% headroom, and the bbox here is
    built from Bezier CONTROL points (which inflate it) while
    an arc contributes only its endpoint (which deflates it),
    so the measured figure is not exact in either direction.
    """
    ring, window, seeds = [], [], []
    for d, (x0, y0, x1, y1) in subs:
        bw, bh = x1 - x0, y1 - y0
        if bw > 0.75 * w and bh > 0.75 * h:
            ring.append((d, (x0, y0, x1, y1)))
        elif bw > 0.15 * w:
            window.append((d, (x0, y0, x1, y1)))
        else:
            seeds.append((d, (x0, y0, x1, y1)))
    return ring, window, seeds


def assert_fill_matches_master(icon_json, src):
    """Fail if `icon.json`'s gradient left the master behind.

    The generator deliberately never WRITES `icon.json` — the
    fill, shadow and glass there are hand-tuned. But the
    gradient is the mark's own flesh green transcribed into
    `srgb:` floats, so nothing otherwise ties it to
    `logo.svg`, and a rebrand would regenerate the layers
    byte-identically while the icon kept the retired colour.
    Reading it here keeps the tuning hand-owned and the colour
    single-mastered.
    """
    fill = json.loads(icon_json.read_text()).get("fill", {})
    stops = fill.get("linear-gradient") if isinstance(fill, dict) else None
    if not stops:
        return  # a non-gradient fill is a deliberate choice
    got = []
    for stop in stops:
        m = re.match(r"srgb:([\d.]+),([\d.]+),([\d.]+)", str(stop))
        if not m:
            sys.exit(f"unreadable fill stop {stop!r} in "
                     f"{icon_json.name} — expected srgb:r,g,b,a")
        got.append("#%02x%02x%02x" % tuple(
            int(round(float(v) * 255)) for v in m.groups()))
    # Only colours actually painted count: a retired hex left in
    # a comment, <metadata> or an orphan gradient stop would
    # otherwise satisfy this while the visible mark moved on.
    used = {c.lower()
            for c in re.findall(r'fill="(#[0-9a-fA-F]{6})"', src)}
    missing = [h for h in got if h.lower() not in used]
    if missing:
        sys.exit(
            f"{icon_json.name}'s gradient uses {missing}, which "
            "no longer appear in logo.svg. The icon background is "
            "the mark's own flesh green; re-pick the stops in Icon "
            "Composer (or update them by hand) so the icon does "
            "not keep a retired colour the way the OG banner once "
            "did.")


def main():
    root = Path(__file__).resolve().parent.parent
    master = root / "assets" / "logo.svg"
    icon_dir = root / "assets" / "AppIcon.icon"
    dest = icon_dir / "Assets"
    dest.mkdir(parents=True, exist_ok=True)
    src = master.read_text()

    vb = re.search(r'viewBox="([^"]+)"', src).group(1).split()
    w, h = float(vb[2]), float(vb[3])

    paths = re.findall(r"<path[^>]*?/>", src)
    def pick(color):
        hit = [p for p in paths if color in p]
        if len(hit) != 1:
            sys.exit(
                f"expected one {color} path, found {len(hit)} — "
                f"has {master.name} been restructured, or was it "
                "re-exported with upper-case hex or as "
                "<path></path> rather than self-closing? The match "
                "is literal on both counts.")
        return re.search(r'\bd="([^"]*)"', hit[0]).group(1)

    assert_fill_matches_master(icon_dir / "icon.json", src)
    ring, window, seeds = classify(subpaths(pick(INK)), w, h)
    got = (len(ring), len(window), len(seeds))
    if got != (N_RING, N_WINDOW, N_SEEDS):
        table = "\n".join(
            "    bw/w=%.4f bh/h=%.4f  -> %s" % (
                (b[2] - b[0]) / w, (b[3] - b[1]) / h, kind)
            for kind, group in (("ring", ring), ("window", window),
                                ("seeds", seeds))
            for _, b in group)
        sys.exit(
            f"{master.name} split into ring/window/seeds {got}, "
            f"expected {(N_RING, N_WINDOW, N_SEEDS)}.\n{table}\n"
            "Two different causes, opposite fixes: the mark's "
            "SHAPE changed (update the counts at the top), or a "
            "subpath crossed a threshold in classify() (fix the "
            "THRESHOLD, not the counts — bumping the counts here "
            "would ship the ring inside the glyph).")

    # Square the canvas on the *content* (ring excluded), so both
    # layers share one viewBox and stay registered under Icon
    # Composer's per-layer scale.
    boxes = [b for _, b in window + seeds]
    x0 = min(b[0] for b in boxes)
    y0 = min(b[1] for b in boxes)
    x1 = max(b[2] for b in boxes)
    y1 = max(b[3] for b in boxes)
    side = max(w, h)
    ox = (x0 + x1) / 2 - side / 2
    oy = (y0 + y1) / 2 - side / 2
    head = ('<svg xmlns="http://www.w3.org/2000/svg" '
            'viewBox="%.2f %.2f %.0f %.0f" '
            'width="%.0f" height="%.0f">'
            % (ox, oy, side, side, side, side))

    def write(name, body):
        (dest / name).write_text(head + body + "</svg>\n")

    write("seeds.svg",
          '<path fill="%s" d="%s"/>'
          % (INK, " ".join(d for d, _ in seeds)))
    # The window's subpaths stay in ONE path element, in source
    # order: split apart, nonzero winding floods the frame and
    # panels solid and the glyph turns into a filled rectangle.
    write("window.svg",
          '<path fill="%s" d="%s"/><path fill="%s" d="%s"/>'
          % (INK, " ".join(d for d, _ in window),
             OUTLINE, pick(OUTLINE)))

    print(f"seeds.svg   {len(seeds)} subpaths")
    print(f"window.svg  {len(window)} subpaths + outline")
    print(f"viewBox     {ox:.2f} {oy:.2f} {side:.0f} {side:.0f}")
    print(f"dropped     {len(ring)} ring subpaths (squircle "
          "replaces the ring)")


if __name__ == "__main__":
    main()
