#!/usr/bin/env python3
"""Post a PUBLISHED release to the KiwiDesk Discord's
announcements channel (#1627).

The post is the release's curated `## Highlights`, read by
`scripts/changelog-sync`'s own parser — never the generated
"What's Changed" list, which is reviewer language
(`docs/design-decisions.md` ▸ *Release notes are written for the
person installing*). One Discord embed: the version as its title
linking the release, the summary and the Before you update
paragraph, then the Spotlight rows where the block has them and
each section with its count and bullets where it does not, then a
sentence counting what changed with a link to the notes, and how
to get the update. No download link: the channel's readers know
the site, and installed copies update themselves. A section list
past Discord's embed limit is cut at a section boundary and closes
on a line naming what was cut, with its counts, never
mid-sentence.

    scripts/discord-announce --release <tag> [--releases FILE]
        [--dry-run]

`--dry-run` prints the webhook payload and posts nothing — the
mode the guard suite drives, and how to preview a post. Without
it the webhook URL is read from `DISCORD_RELEASE_WEBHOOK`; an
unset or empty one skips the post with a notice and exits 0, so a
fork's run or a rotated webhook never fails the release sync. To
see a real post, point that variable at a private channel's
webhook and run the script locally against a published tag.

`.github/workflows/changelog.yml` runs it in its own job after the
sync is green, on `release: published` or a dispatch that sets
`announce` — never on a plain rebuild.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

# Loaded by path, as `appcast-sync` loads its siblings: the
# scripts carry no `.py` suffix, so the loader is spelled out.
_sync_path = Path(__file__).resolve().parent / "changelog-sync"
_sync_loader = importlib.machinery.SourceFileLoader(
    "changelog_sync", str(_sync_path)
)
_sync = importlib.util.module_from_spec(
    importlib.util.spec_from_loader("changelog_sync", _sync_loader)
)
_sync_loader.exec_module(_sync)

WEBHOOK_ENV = "DISCORD_RELEASE_WEBHOOK"
# Discord caps an embed's description at 4096 characters; the
# margin leaves room for the closing pointer.
DESCRIPTION_BUDGET = 3900
USERNAME = "KiwiDesk Releases"


# Where a found update shows, and the one manual check: the
# icon's tooltip is `updates.check` (#1536).
UPDATE_LINE = (
    "KiwiDesk flags the update in its menu bar once it finds it; "
    "to get it now, click the circular arrow (Check for updates) "
    "in the footer of Settings Home."
)
# A typed section's change, counted in words (#2112): one entry per
# `changelog-sync` SECTION_TYPES type, held to that table by
# `DiscordAnnounceSpotlightTests`; a type missing here still counts.
NOUNS = {
    "new": ("addition", "additions"),
    "improved": ("improvement", "improvements"),
    "fixed": ("fix", "fixes"),
    "scripting": ("Lua & CLI change", "Lua & CLI changes"),
}
FALLBACK_NOUNS = ("change", "changes")
# Room the head keeps when a Spotlight is long enough to crowd it.
HEAD_FLOOR = 600


def counted(sections: list[dict]) -> list[tuple[int, str]]:
    """`(3, "3 fixes")`, one per typed section that has entries, in
    the block's order."""
    out = []
    for section in sections:
        if not section.get("type") or not section["items"]:
            continue
        nouns = NOUNS.get(section["type"], FALLBACK_NOUNS)
        count = len(section["items"])
        out.append((count, f"{count} {nouns[0 if count == 1 else 1]}"))
    return out


def joined(items: list[str]) -> str:
    """`a`, `a and b`, `a, b and c`."""
    if len(items) < 2:
        return "".join(items)
    return ", ".join(items[:-1]) + " and " + items[-1]


def counts_line(entry: dict) -> str:
    """What changed, in one sentence, linking the full notes."""
    notes = f"[release notes]({entry['url']})"
    counts = counted(entry.get("sections") or [])
    if not counts:
        return f"Everything that changed is in the {notes}."
    total = sum(count for count, _ in counts)
    where = f"all of them in the {notes}" if total > 1 else f"see the {notes}"
    phrases = [phrase for _, phrase in counts]
    return f"This release brings {joined(phrases)} — {where}."


def spotlight_block(rows: list[dict]) -> str:
    """The Spotlight rows as `**Title** — line`; the `{setting:}`
    and `{symbol:}` tokens are the app's and never shown."""
    return "\n".join(f"**{row['title']}** — {row['line']}" for row in rows)


def section_block(section: dict) -> str:
    """One section as Discord markdown: its title and, on a typed
    release, its count, then its bullets."""
    title = section["title"]
    if section.get("type"):
        title = f"{title} · {len(section['items'])}"
    bullets = "\n".join(f"- {item}" for item in section["items"])
    return f"**{title}**\n{bullets}"


def clip(text: str, budget: int) -> str:
    """`text` cut to `budget` at a sentence end where one fits,
    else at a word, marked with an ellipsis."""
    budget = max(budget, 1)
    if len(text) <= budget:
        return text
    cut = text[: budget - 1]
    end = cut.rfind(". ")
    if end > budget // 2:
        return cut[: end + 1]
    return cut.rsplit(" ", 1)[0] + "…"


def pointer(entry: dict, rest: list[dict]) -> str:
    """The line closing a cut section list, naming each cut
    section and its count so a reader knows what is behind the
    link."""
    names = " · ".join(
        f"{s['title']} {len(s['items'])}" if s.get("type") else s["title"]
        for s in rest
    )
    return f"**Also in this release:** {names} — full notes: {entry['url']}"


def description(entry: dict) -> str:
    """The embed body. A block with Spotlight rows posts the rows,
    never its sections; one without posts its sections, cut at a
    section boundary to fit. The head — summary, Before you
    update — is clipped first if it alone would not leave room for
    the close."""
    sections = entry.get("sections") or []
    rows = entry.get("spotlight") or []
    close = f"{counts_line(entry)}\n{UPDATE_LINE}"
    cut_close = f"{pointer(entry, sections)}\n{UPDATE_LINE}"
    head: list[str] = []
    if entry.get("summary"):
        head.append(entry["summary"])
    if entry.get("heads"):
        head.append(f"**Before you update:** {entry['heads']}")
    closing = max(len(close), len(cut_close))
    body = spotlight_block(rows) if rows else ""
    keep = min(len("\n\n".join(head)), HEAD_FLOOR)
    body_room = DESCRIPTION_BUDGET - closing - keep - 4
    if len(body) > body_room:
        body = clip(body, body_room)
    room = DESCRIPTION_BUDGET - closing - len(body) - 4
    while len("\n\n".join(head)) > room and head:
        if room < 3 * len(head):
            head = []
            break
        over = len("\n\n".join(head)) - room
        longest = max(range(len(head)), key=lambda i: len(head[i]))
        head[longest] = clip(head[longest], len(head[longest]) - over)
    parts = list(head)
    if rows:
        return "\n\n".join(parts + [body, close])
    for index, section in enumerate(sections):
        block = section_block(section)
        rest = sections[index + 1 :]
        tail = f"{pointer(entry, rest)}\n{UPDATE_LINE}" if rest else close
        candidate = "\n\n".join(parts + [block, tail])
        if len(candidate) > DESCRIPTION_BUDGET:
            cut = f"{pointer(entry, sections[index:])}\n{UPDATE_LINE}"
            return "\n\n".join(parts + [cut])
        parts.append(block)
    return "\n\n".join(parts + [close])


def payload(entry: dict) -> dict:
    return {
        "username": USERNAME,
        "allowed_mentions": {"parse": []},
        "embeds": [
            {
                "title": f"KiwiDesk {entry['version']}",
                "url": entry["url"],
                "description": description(entry),
            }
        ],
    }


def post(url: str, body: dict) -> None:
    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "User-Agent": "KiwiDesk-release-sync",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        if response.status >= 300:
            raise urllib.error.HTTPError(
                url, response.status, "unexpected status", None, None
            )


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="discord-announce",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--release", metavar="TAG", required=True)
    parser.add_argument(
        "--releases",
        metavar="FILE",
        help="read the release from a JSON fixture instead of `gh`",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the payload and post nothing",
    )
    args = parser.parse_args(argv[1:])

    try:
        entry, _ = _sync.build_entry(
            _sync.fetch_release(args.release, args.releases),
            strict=True,
        )
    except _sync.NotesError as error:
        return _sync._report(error)
    body = payload(entry)
    if args.dry_run:
        print(json.dumps(body, indent=2, ensure_ascii=False))
        return 0
    url = os.environ.get(WEBHOOK_ENV, "").strip()
    if not url:
        print(
            f"discord-announce: {WEBHOOK_ENV} is not set; "
            f"{args.release} was not announced.",
        )
        return 0
    try:
        post(url, body)
    except (urllib.error.URLError, OSError, ValueError) as error:
        # Never the URL: it is the secret.
        print(
            f"discord-announce: the post for {args.release} "
            f"failed ({type(error).__name__}).",
            file=sys.stderr,
        )
        return 1
    print(f"discord-announce: announced {args.release}.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
