#!/usr/bin/env python3
"""Extract L("key", "English"[, args...]) call sites from
Sources/KiwiDesk and Sources/KiwiDeskCore into the canonical
locale manifest (issue #9).

Usage:
    scripts/extract-keys              Rebuild en.json only.
    scripts/extract-keys <locale>     Rebuild en.json, then write
                                       locale-worksheets/missing_
                                       <locale>.json with every
                                       key that locale's file is
                                       missing (or has empty),
                                       sourced with the English
                                       text for a translator to
                                       fill in place. Safe to
                                       re-run mid-translation:
                                       drafts already in the
                                       worksheet are carried
                                       over.

    --site                            Operate on the marketing site
                                       (`site/src/i18n/`) instead of
                                       the Swift app. Combine with a
                                       locale or --check/--prune:
                                       `scripts/extract-keys --site
                                       fr` writes
                                       locale-worksheets/site/
                                       missing_fr.json.
                                       The site's en.json is the
                                       hand-authored source of truth
                                       (the Astro components read
                                       `t.<key>` from it), NOT a
                                       generated manifest, so --site
                                       never scans Swift and never
                                       rewrites en.json — it just
                                       diffs en.json against the
                                       target locale. Everything else
                                       (missing round-trip, --check,
                                       --prune) behaves the same.
    scripts/extract-keys --check      Compute the mapping and
                                       compare it to the
                                       committed en.json WITHOUT
                                       writing anything. Exits
                                       non-zero if en.json is
                                       stale (a call site was
                                       added/changed/removed
                                       since the last extract),
                                       on drift, if a shipped
                                       <locale>.json fails to
                                       decode as a flat
                                       {string: string} map, or if
                                       any translated value is
                                       broken content: a wrong
                                       writing system, a tagged
                                       English stub, specifier
                                       drift, two languages sharing
                                       a file's worth of identical
                                       values, one filler reused
                                       across unrelated keys, or
                                       English words left in a
                                       translated sentence (that
                                       last one on non-Latin
                                       locales, and not under
                                       --site) — see
                                       scripts/localization_guards
                                       and docs/translating.md.
                                       Run
                                       by scripts/lint.sh (and
                                       scripts/pre-commit when a
                                       locale file is staged) as
                                       part of the verify gate/CI.
                                       Also WARNS (does not fail)
                                       about orphan keys: entries
                                       in a <locale>.json with no
                                       matching code call site.
    scripts/extract-keys --prune      Removes every orphan key
                                       (present in a <locale>.json,
                                       absent from the current
                                       code-derived key set) from
                                       every shipped locale file,
                                       and rewrites en.json as
                                       usual. Prints what it
                                       removed per locale. See
                                       scripts/rename-key for
                                       renaming a key without
                                       losing its translations.

`L` takes either two arguments (`L(key, english)`) or a key, an
English template, and interpolation arguments (`L(key, english,
args...)`, `String(format:)`-style with positional specifiers
like `%1$@`) — both forms are recognized; the extractor only
ever reads the key and English template, never the trailing
arguments. The Settings control catalog's descriptor shapes
(`SettingsControl(key, english, ...)` and
`SettingsDrawer(key, english, ...)`, #277) carry the same
leading tuple and are scanned identically — their trailing
labelled arguments (`surface:`, `instance:`, `children:`) are
skipped. `ControlKeyExtractionTests` is that shape's sibling
suite.

Both Sources/KiwiDesk (the GUI) and Sources/KiwiDeskCore (where
`L` itself and `LocalizationManager` live) are scanned — a
future Core call site must not silently escape extraction.

Drift guard: if the same key is called with two DIFFERENT
English strings across call sites, this is a bug (the two
occurrences would silently disagree until whichever one this
script scanned last overwrote en.json) — the script fails
loudly instead, naming the key and every conflicting string it
found. This applies in every mode, including `--check`.

Doc-comment example call sites (e.g. a `///` line showing
`L("key", "English")` as sample syntax) are stripped before
scanning, the same as any other `//`/`///` line comment, so
documentation prose never leaks a phantom key into en.json.

Limitation: the extractor is a regex-based scan tuned to this
repo's `.swift-format` house style (each `L(` call's two string
arguments, across any number of lines, joined only by string-
literal concatenation with `+` — plain `"..."` literals and
triple-quoted `\"\"\"...\"\"\"` blocks are both supported). It
does not evaluate arbitrary Swift expressions — a key or English
string built from anything other than adjacent string literals
will not be picked up, and call sites should stay written that
way for the tool to keep working.
"""

import json
import os
import re
import sys
from pathlib import Path

from locale_decoder import decode_json_object
from locale_paths import (
    WORKSHEET_PREFIX,
    site_override_conflict,
    worksheet_name,
    worksheets_dir,
)
from localization_guards import (
    collapsed_translations,
    dropped_product_names,
    untranslated_mode_names,
    english_residue,
    foreign_scripts,
    overlapping_locales,
    placeholder_drift,
    tagged_stub,
    unregistered_locales,
    withheld_argument_position,
)

ROOT = Path(__file__).resolve().parent.parent
# Overridable so `LocalizationDriftGuardTests` (Swift, run via
# `swift test`) can point the scanner at a small fixture tree
# instead of the real source trees — the CLI surface for a
# human running this script is unaffected (never set these).
# `KIWIDESK_EXTRACT_SOURCES` may be a single path or several
# separated by `os.pathsep` (`:` on macOS), mirroring the real
# two-directory scan (KiwiDesk + KiwiDeskCore).
_default_sources = str(
    ROOT / "Sources" / "KiwiDesk"
) + os.pathsep + str(ROOT / "Sources" / "KiwiDeskCore")
SOURCE_DIRS = [
    Path(p)
    for p in os.environ.get(
        "KIWIDESK_EXTRACT_SOURCES", _default_sources
    ).split(os.pathsep)
]
LOCALES_DIR = Path(
    os.environ.get(
        "KIWIDESK_EXTRACT_LOCALES",
        str(
            ROOT
            / "Sources"
            / "KiwiDeskCore"
            / "Resources"
            / "Locales"
        ),
    )
)
EN_JSON = LOCALES_DIR / "en.json"

# Where `missing_<locale>.json` worksheets are written — outside
# every tree a target ships from. `scripts/locale_paths.py` owns
# the path (`merge-keys` reads the same one) and
# `.claude/rules/localization.md` owns why.
WORKSHEETS_DIR = worksheets_dir(ROOT)

# The marketing site's flat i18n manifests (issue #63 / Wave 10).
# Selected by `--site`; unlike the app, this en.json is authored by
# hand (the Astro components read `t.<key>` from it) rather than
# generated from code, so site mode loads it directly as the key
# map instead of scanning Swift.
SITE_LOCALES_DIR = ROOT / "site" / "src" / "i18n"
SITE_WORKSHEETS_DIR = worksheets_dir(ROOT, site=True)

# One string piece: a plain "..." literal or a triple-quoted
# """...""" block (Swift multi-line string, used for the
# onboarding copy).
_PIECE = r'(?:"""(?:[^\\]|\\.)*?"""|"(?:[^"\\]|\\.)*")'

# A run of pieces joined by `+`, allowing line breaks and
# comments between pieces (swift-format wraps long `L(...)`
# calls across several lines).
_STRING_LITERAL = re.compile(
    _PIECE
    + r"(?:\s*(?://[^\n]*)?\s*\+\s*(?://[^\n]*)?\s*"
    + _PIECE
    + r")*",
    re.DOTALL,
)

# `L(` — or a Settings catalog descriptor (#277), whose first
# two arguments are the same key/English tuple: `SettingsControl(`
# / `SettingsDrawer(` — then a string literal, a comma, then a
# string literal, then either `)` (the 2-arg form) or `,` (the
# interpolating / labelled-argument form — trailing arguments
# such as `surface:`, `instance:`, `children:` or `args...` are
# never captured, only skipped).
_CALL = re.compile(
    r"\b(?:L|SettingsControl|SettingsDrawer)\(\s*(?P<key>"
    + _STRING_LITERAL.pattern
    + r")\s*,\s*(?P<english>"
    + _STRING_LITERAL.pattern
    + r")\s*[,)]",
    re.DOTALL,
)

_PIECE_RE = re.compile(_PIECE, re.DOTALL)


def _dedent_triple_quoted(body: str) -> str:
    """Swift trims a `\"\"\"` block's leading whitespace to the
    closing `\"\"\"`'s indent, and drops the literal's own
    leading/trailing newline. Mirrors that so extracted
    multi-line English matches the runtime value."""
    lines = body.split("\n")
    if lines and lines[0] == "":
        lines = lines[1:]
    if lines and lines[-1].strip() == "":
        indent = len(lines[-1]) - len(lines[-1].lstrip(" "))
        lines = lines[:-1]
        lines = [line[indent:] for line in lines]
    return "\n".join(lines)


def _join_literal(raw: str) -> str:
    """Concatenates a run of string pieces into the Swift string
    value (decodes escapes; strips inter-piece comments)."""
    parts: list[str] = []
    for piece in _PIECE_RE.findall(raw):
        if piece.startswith('"""'):
            parts.append(_dedent_triple_quoted(piece[3:-3]))
        else:
            parts.append(piece[1:-1])
    joined = "".join(parts)
    return (
        joined.replace(r"\u{201C}", "“")
        .replace(r"\u{201D}", "”")
        .replace(r"\u{2019}", "’")
        .replace("\\\n", "")
        .replace(r"\n", "\n")
        .replace(r"\"", '"')
        .replace(r"\\", "\\")
    )


def _swift_files() -> list[Path]:
    files: list[Path] = []
    for directory in SOURCE_DIRS:
        files.extend(directory.rglob("*.swift"))
    return sorted(set(files))


def _strip_comments(text: str) -> str:
    """Blanks out every line comment's content (keeping the
    newline, so line numbers in error messages stay meaningful)
    -- a string-literal-aware pass so a comment marker inside a
    string (a URL, say) or inside a triple-quoted block is left
    alone. Doc-comment prose showing an example call site must
    never be scanned as a real one."""
    out: list[str] = []
    i = 0
    n = len(text)
    in_line_comment = False
    in_string = False
    in_triple_string = False
    while i < n:
        ch = text[i]
        if in_line_comment:
            if ch == "\n":
                in_line_comment = False
                out.append(ch)
            i += 1
            continue
        if in_triple_string:
            if text.startswith('"""', i):
                out.append('"""')
                in_triple_string = False
                i += 3
                continue
            out.append(ch)
            i += 1
            continue
        if in_string:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if ch == '"':
                in_string = False
            i += 1
            continue
        # Not inside a string or comment right now.
        if text.startswith('"""', i):
            out.append('"""')
            in_triple_string = True
            i += 3
            continue
        if ch == '"':
            out.append(ch)
            in_string = True
            i += 1
            continue
        if text.startswith("//", i):
            in_line_comment = True
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def extract() -> dict[str, str]:
    """Scans every .swift file under `SOURCE_DIRS` for
    `L(key, english[, args...])` call sites and returns the
    canonical {key: english} map. Fails loudly on a drifted key
    (same key, different English across sites)."""
    found: dict[str, tuple[str, str]] = {}
    conflicts: dict[str, set[str]] = {}
    for path in _swift_files():
        text = _strip_comments(path.read_text(encoding="utf-8"))
        for match in _CALL.finditer(text):
            key = _join_literal(match.group("key"))
            english = _join_literal(match.group("english"))
            if key in found and found[key][0] != english:
                conflicts.setdefault(key, {found[key][0]})
                conflicts[key].add(english)
            try:
                display_path = str(path.relative_to(ROOT))
            except ValueError:
                display_path = str(path)
            found[key] = (english, display_path)
    if conflicts:
        print(
            "extract-keys: FAILED — the same key maps to "
            "different English strings:",
            file=sys.stderr,
        )
        for key, strings in sorted(conflicts.items()):
            print(f"\n  key: {key}", file=sys.stderr)
            for s in sorted(strings):
                print(f"    - {s!r}", file=sys.stderr)
        print(
            "\nFix: make every call site for a key pass the "
            "exact same English string.",
            file=sys.stderr,
        )
        sys.exit(1)
    return {key: english for key, (english, _) in found.items()}


def shipped_locale_files() -> list[Path]:
    """Every `<locale>.json` under `LOCALES_DIR`, excluding
    `en.json` (the generated manifest) and any `missing_*.json`.
    Shared by `--check`'s orphan warning and `--prune` so both
    agree on what "a locale file" means.

    Worksheets are not written here any more (`WORKSHEETS_DIR`),
    so the second exclusion hides nothing: one that turns up in
    this directory is rejected by name in
    `validate_locale_files()`, which `check()` runs first. The
    exclusion survives so the walkers that come after it —
    `--prune` rewriting a file, `find_orphans` diffing keys —
    cannot mangle a stray worksheet before that diagnosis is
    printed."""
    if not LOCALES_DIR.is_dir():
        return []
    return sorted(
        path
        for path in LOCALES_DIR.glob("*.json")
        if path.name != "en.json"
        and not path.name.startswith(WORKSHEET_PREFIX)
    )


def find_orphans(
    mapping: dict[str, str],
) -> dict[Path, list[str]]:
    """Keys present in a shipped locale file but absent from the
    current code-derived key set — translations left behind by a
    removed or renamed `L(...)` call site. Returns only locales
    that actually have orphans. Callers are expected to have
    already run `validate_locale_files()` — a malformed file is
    silently skipped here rather than re-diagnosed."""
    orphans: dict[Path, list[str]] = {}
    for locale_file in shipped_locale_files():
        try:
            translations = json.loads(
                locale_file.read_text(encoding="utf-8")
            )
        except json.JSONDecodeError:
            continue
        if not isinstance(translations, dict):
            continue
        stale = sorted(set(translations) - set(mapping))
        if stale:
            orphans[locale_file] = stale
    return orphans


def validate_locale_files() -> list[str]:
    """Every shipped `<locale>.json` must decode as a flat
    `{string: string}` map — that is the exact shape
    `LocaleCatalog.load(_:)` expects at runtime. A malformed file
    (bad JSON, a nested object, a non-string value) makes
    `LocaleCatalog` soft-fail to an empty dictionary and the
    whole locale silently reverts to all-English — a feature
    dying quietly — so this is a hard-fail check, unlike the
    orphan-key warning. Returns one human-readable problem
    description per broken file (empty list = all valid).

    A `missing_<locale>.json` worksheet is rejected by NAME, not
    by failing to decode. Both would fail here today, but only
    the name says which mistake was made: the decode error names
    whichever key happens to sort first and reads as a corrupt
    translation, which is how one worksheet left in this
    directory presented as a suite-wide failure with no visible
    connection to a translation pass. This is deliberately not a
    skip — `WORKSHEETS_DIR` is where these belong, so one here is
    a defect, and a shipped `.app` would carry it into the
    bundle."""
    problems: list[str] = []
    if LOCALES_DIR.is_dir():
        for worksheet in sorted(LOCALES_DIR.glob(f"{WORKSHEET_PREFIX}*.json")):
            problems.append(
                f"{worksheet.name}: a translator worksheet in "
                "the catalog directory — worksheets are nested "
                '{"source", "translation"} maps and belong in '
                "locale-worksheets/ (scripts/extract-keys writes "
                "them there). Move or delete it."
            )
    for locale_file in shipped_locale_files():
        try:
            text = locale_file.read_text(encoding="utf-8")
        except OSError as error:
            problems.append(f"{locale_file.name}: {error}")
            continue
        try:
            decoded = json.loads(text)
        except json.JSONDecodeError as error:
            problems.append(
                f"{locale_file.name}: invalid JSON ({error})"
            )
            continue
        if not isinstance(decoded, dict):
            problems.append(
                f"{locale_file.name}: must be a flat "
                f"{{string: string}} object, found "
                f"{type(decoded).__name__}"
            )
            continue
        bad_values = sorted(
            key
            for key, value in decoded.items()
            if not isinstance(value, str)
        )
        if bad_values:
            problems.append(
                f"{locale_file.name}: non-string value(s) for "
                f"key(s) {', '.join(bad_values)} — every entry "
                "must be a flat string, not an object/array/"
                "number"
            )
    return problems


def _load_catalogs() -> dict[str, dict[str, str]]:
    """Every shipped `<locale>.json` decoded, keyed by locale.
    Callers run `validate_locale_files()` first, so a file that
    does not decode is skipped here rather than re-diagnosed."""
    catalogs: dict[str, dict[str, str]] = {}
    for locale_file in shipped_locale_files():
        try:
            decoded = json.loads(
                locale_file.read_text(encoding="utf-8")
            )
        except (json.JSONDecodeError, UnicodeDecodeError, OSError):
            continue
        if isinstance(decoded, dict):
            catalogs[locale_file.stem] = decoded
    return catalogs


def check_content(
    mapping: dict[str, str], residue: bool = True
) -> list[str]:
    """Every locale value whose *content* is broken (issue #95).

    `check()` already proves the key structure is current; these
    are the things structure cannot see. See
    `scripts/localization_guards` for what each predicate proves.

    `residue=False` drops the one *heuristic* predicate, which is
    tuned on short app UI labels. Site mode passes it: the
    marketing manifests are prose carrying third-party product
    names (`Homebrew`, `SketchyBar`, `JankyBorders`) and embedded
    HTML, so a "retained English word" there is normal. The corpus
    walk is the right place for that call — pulling the site's
    vocabulary into the app's `GLOSSARY` would couple the two, and
    the predicates themselves stay corpus-agnostic.

    English is script-checked with the others: `en.json` is
    generated, so a stray non-Latin glyph there is a pasted
    literal in Swift, and a bug too. It is exempt from the rest,
    which all compare *against* English.
    """
    problems: list[str] = []
    catalogs = _load_catalogs()

    unregistered = unregistered_locales(sorted(catalogs))
    if unregistered:
        problems.append(
            f"{', '.join(unregistered)}: shipped but absent from "
            "the guard registry — add the locale to `_STUB_TAGS` "
            "(and to `SCRIPTS` if it writes in a non-Latin "
            "script) in scripts/localization_guards.py, or its "
            "stub and residue guards stay silently off"
        )

    for locale, catalog in sorted(catalogs.items()):
        for key, value in sorted(catalog.items()):
            for script in foreign_scripts(locale, value):
                problems.append(
                    f"{locale}.json :: {key} contains {script} "
                    f"characters, which {locale} does not use — "
                    f"{value[:70]!r}"
                )
            tag = tagged_stub(locale, value)
            if tag:
                problems.append(
                    f"{locale}.json :: {key} is a tagged stub — "
                    f"untranslated English marked ({tag}) — "
                    f"{value[:70]!r}"
                )
            english = mapping.get(key)
            if english is None:
                continue
            drift = placeholder_drift(value, english)
            if drift:
                problems.append(
                    f"{locale}.json :: {key} {drift} relative to "
                    f"the English — {value[:70]!r} (English: "
                    f"{english[:50]!r})"
                )
            stranded = withheld_argument_position(key, value)
            if stranded:
                problems.append(
                    f"{locale}.json :: {key} {stranded} — "
                    f"{value[:70]!r}"
                )
            kept = untranslated_mode_names(
                value, catalog, mapping
            )
            if kept:
                problems.append(
                    f"{locale}.json :: {key} keeps the English "
                    f"mode name(s) {', '.join(kept)} while this "
                    f"locale's own picker translates them — "
                    f"{value[:70]!r}"
                )
            dropped = dropped_product_names(value, english)
            if dropped:
                problems.append(
                    f"{locale}.json :: {key} translates the "
                    f"untranslated feature name(s) "
                    f"{', '.join(dropped)} — {value[:70]!r} "
                    f"(English: {english[:50]!r})"
                )
            if not residue:
                continue
            left = english_residue(locale, value, english)
            if left:
                problems.append(
                    f"{locale}.json :: {key} still carries the "
                    f"English word(s) {', '.join(left)} — "
                    f"{value[:70]!r} (English: {english[:50]!r})"
                )

        for value, keys in collapsed_translations(
            catalog, mapping
        ):
            problems.append(
                f"{locale}.json :: {len(keys)} unrelated key(s) "
                f"all translate to {value[:50]!r} — one filler "
                "was written instead of a translation. Keys: "
                f"{', '.join(keys[:5])}"
            )

    for key, value in sorted(mapping.items()):
        for script in foreign_scripts("en", value):
            problems.append(
                f"en.json :: {key} contains {script} characters, "
                f"which English does not use — {value[:70]!r}"
            )
        # The English frame is authored in Swift, so this arm
        # catches the author rather than the translator — and it
        # is the arm that matters most: every locale copies the
        # frame's shape from an English source that already had
        # the clause in the wrong place.
        stranded = withheld_argument_position(key, value)
        if stranded:
            problems.append(
                f"en.json :: {key} {stranded} — {value[:70]!r}"
            )

    for first, second, keys in overlapping_locales(
        catalogs, mapping
    ):
        problems.append(
            f"{first}.json and {second}.json share "
            f"{len(keys)} identical non-trivial value(s) — one "
            "language was probably pasted into the other's file. "
            f"First few: {', '.join(keys[:5])}"
        )

    return problems


def write_en_json(mapping: dict[str, str]) -> None:
    LOCALES_DIR.mkdir(parents=True, exist_ok=True)
    EN_JSON.write_text(
        json.dumps(
            mapping, indent=2, sort_keys=True, ensure_ascii=False
        )
        + "\n",
        encoding="utf-8",
    )
    print(f"extract-keys: wrote {len(mapping)} keys to {EN_JSON}")


def _warn_orphans(mapping: dict[str, str]) -> None:
    """Prints (never fails on its own) every locale key with no
    matching code call site — cruft left by a removed or renamed
    key. `scripts/extract-keys --prune` removes them;
    `scripts/rename-key` avoids creating them for a pure rename."""
    orphans = find_orphans(mapping)
    if not orphans:
        return
    print(
        "extract-keys --check: WARNING — orphan key(s) in "
        "shipped locale file(s) (not a failure; run "
        "`scripts/extract-keys --prune` to clean up):"
    )
    for locale_file, keys in sorted(orphans.items()):
        print(f"\n  {locale_file.name}:")
        for key in keys:
            print(f"    - {key}")


def check_site_parity(mapping: dict[str, str]) -> list[str]:
    """SITE MODE ONLY: every translated catalog must carry every
    key `en.json` has (#869).

    The asymmetry with the app corpus is the ruling, not an
    oversight. An app locale is allowed to lag: every `L(key,
    english)` call site carries its English inline, a missing key
    falls back to it, and `--<locale>`'s worksheet round exists to
    let a translator catch up over time. Requiring parity there
    would block the workflow it is meant to serve.

    The site has no such fallback at the KEY level — a component
    reads `t.<key>`, and an absent key renders NOTHING. So a gap
    is a blank on a published page, in a language the person
    reviewing the PR may not read: invisible in review by
    construction, which is why it needs a machine. `quote_byline_name`
    shipped English-only for exactly that reason, and no check
    noticed.

    Three hand-maintained catalogs make this cheap, and the escape
    hatch already exists: `scripts/extract-keys --site <locale>`
    writes the worksheet that clears the failure.

    Refuses an EMPTY mapping rather than passing on it: a guard
    that finds no violations because it was handed nothing to
    check reads exactly like a guard that found none, which is
    the vacuous pass `.claude/rules/rule-authoring.md` names."""
    if not mapping:
        return [
            "en.json decoded to zero keys — nothing to check "
            "parity against. That is a broken catalog, not a "
            "clean run."
        ]
    problems: list[str] = []
    for locale_file in shipped_locale_files():
        try:
            decoded = json.loads(
                locale_file.read_text(encoding="utf-8")
            )
        except (OSError, json.JSONDecodeError):
            # validate_locale_files() already hard-failed on this
            # and named it better than a parity diff could.
            continue
        if not isinstance(decoded, dict):
            continue
        missing = sorted(set(mapping) - set(decoded))
        if missing:
            listed = ", ".join(missing[:8])
            more = (
                f" (+{len(missing) - 8} more)"
                if len(missing) > 8
                else ""
            )
            problems.append(
                f"{locale_file.name}: missing {len(missing)} "
                f"key(s) present in en.json — {listed}{more}"
            )
    return problems


def check(
    mapping: dict[str, str],
    residue: bool = True,
    site: bool = False,
) -> int:
    """Compares the freshly-scanned mapping to the committed
    en.json without writing anything. Non-zero exit (with a
    diff) means en.json is stale — someone edited/added/removed
    an `L(...)` call site and forgot to re-run extract-keys.
    Also HARD-FAILS if any shipped `<locale>.json` doesn't
    decode as a flat `{string: string}` map, or if a
    `missing_*.json` worksheet is sitting in the catalog
    directory (a broken file makes `LocaleCatalog` soft-fail to
    `[:]` at runtime — the locale reverts to all-English
    silently, so this must block, not warn) — checked first, so
    a translator gets the clearest signal, and because
    `check_content` assumes flat string maps.
    Broken *content* (`check_content`) blocks next, ahead of the
    staleness diff: a contaminated value is wrong however fresh
    en.json is. Separately WARNS (without affecting the exit code)
    about orphan keys in shipped locale files — a lingering
    unused translation is cruft, not a correctness bug, and must
    not block an otherwise-clean translator PR."""
    malformed = validate_locale_files()
    if malformed:
        print(
            "extract-keys --check: FAILED — every *.json in the "
            "catalog directory must be a flat {string: string} "
            "catalog, and a missing_*.json worksheet belongs in "
            "locale-worksheets/:",
            file=sys.stderr,
        )
        for problem in malformed:
            print(f"    - {problem}", file=sys.stderr)
        return 1
    broken = check_content(mapping, residue=residue)
    if broken:
        print(
            "extract-keys --check: FAILED — broken translation "
            "content (see docs/translating.md):",
            file=sys.stderr,
        )
        for problem in broken:
            print(f"    - {problem}", file=sys.stderr)
        return 1
    if site:
        gaps = check_site_parity(mapping)
        if gaps:
            print(
                "extract-keys --site --check: FAILED — a site "
                "catalog is missing keys en.json has. An absent "
                "key renders as NOTHING on the page (the app's "
                "per-call-site English fallback has no site "
                "equivalent), so this blocks:",
                file=sys.stderr,
            )
            for problem in gaps:
                print(f"    - {problem}", file=sys.stderr)
            print(
                "\nRun `scripts/extract-keys --site <locale>` for "
                "the worksheet, then `scripts/merge-keys --site "
                "<locale>`.",
                file=sys.stderr,
            )
            return 1
    _warn_orphans(mapping)
    if not EN_JSON.exists():
        print(
            f"extract-keys --check: FAILED — {EN_JSON} does "
            "not exist. Run `scripts/extract-keys` once.",
            file=sys.stderr,
        )
        return 1
    committed = json.loads(EN_JSON.read_text(encoding="utf-8"))
    if committed == mapping:
        print(
            f"extract-keys --check: OK — en.json matches "
            f"{len(mapping)} scanned key(s)."
        )
        return 0
    added = sorted(set(mapping) - set(committed))
    removed = sorted(set(committed) - set(mapping))
    changed = sorted(
        key
        for key in set(mapping) & set(committed)
        if mapping[key] != committed[key]
    )
    print(
        "extract-keys --check: FAILED — en.json is stale "
        "(run `scripts/extract-keys` and commit the result):",
        file=sys.stderr,
    )
    if added:
        print(f"\n  new key(s) not in en.json:", file=sys.stderr)
        for key in added:
            print(f"    + {key}: {mapping[key]!r}", file=sys.stderr)
    if removed:
        print(
            f"\n  key(s) in en.json with no call site left:",
            file=sys.stderr,
        )
        for key in removed:
            print(f"    - {key}", file=sys.stderr)
    if changed:
        print(f"\n  key(s) whose English text changed:", file=sys.stderr)
        for key in changed:
            print(
                f"    ~ {key}: {committed[key]!r} -> "
                f"{mapping[key]!r}",
                file=sys.stderr,
            )
    return 1


def prune(mapping: dict[str, str], regen: bool = True) -> int:
    """Removes every orphan key from every shipped locale file
    and rewrites en.json. The maintainer's "clean up cruft"
    command — run after a key is deliberately removed/renamed
    (not via `scripts/rename-key`) in code. `regen=False` (site
    mode) skips the en.json rewrite: the site's en.json is the
    hand-authored source of truth, so re-emitting it sorted would
    destroy its deliberate grouping.

    Validates first, because this is the one mode that *rewrites*
    the catalog directory: it walks `shipped_locale_files()`,
    which skips a `missing_*.json` by name, so without this a
    prune would tidy every catalog around a worksheet sitting
    among them and report success."""
    malformed = validate_locale_files()
    if malformed:
        print(
            "extract-keys --prune: FAILED — the catalog "
            "directory holds a file that is not a catalog; "
            "nothing was pruned:",
            file=sys.stderr,
        )
        for problem in malformed:
            print(f"    - {problem}", file=sys.stderr)
        return 1
    orphans = find_orphans(mapping)
    if regen:
        write_en_json(mapping)
    if not orphans:
        print("extract-keys --prune: no orphan keys found.")
        return 0
    for locale_file, keys in sorted(orphans.items()):
        translations = json.loads(
            locale_file.read_text(encoding="utf-8")
        )
        for key in keys:
            del translations[key]
        locale_file.write_text(
            json.dumps(
                translations,
                indent=2,
                sort_keys=True,
                ensure_ascii=False,
            )
            + "\n",
            encoding="utf-8",
        )
        print(
            f"extract-keys --prune: removed {len(keys)} "
            f"orphan key(s) from {locale_file.name}:"
        )
        for key in keys:
            print(f"    - {key}")
    return 0


class WorksheetUnreadable(Exception):
    """A worksheet exists but cannot be parsed, so the drafts in
    it can neither be carried forward nor knowingly discarded."""


def read_drafts(
    out: Path,
) -> tuple[dict[str, tuple[str, str]], list[tuple[str, str]]]:
    """What the worksheet at `out` still holds, split in two:
    `({key: (source, translation)}, [(key, text)])` — the drafts
    that can be carried, then every entry holding text this
    cannot place. `({}, [])` when there is no worksheet.

    An empty `translation` is the "still to do" signal, carries
    nothing, and appears in neither list.

    **A wrong SHAPE does not mean there is nothing to save**, and
    reading it that way is how the first draft of this function
    reintroduced the defect it exists to close: a bare-string
    entry (`{"a.key": "Ein Text"}`) IS the draft, and
    `merge-keys` names that as the likeliest hand-written form
    and echoes its text rather than dropping it. So every entry
    whose shape this cannot use comes back in the second list,
    to be reported with its text before the rewrite.

    A file that will not parse at all is different in kind and
    raises: its drafts can be neither read nor knowingly
    discarded, so the caller must refuse rather than overwrite.
    `UnicodeDecodeError` counts — the worksheet is the one file
    in this pipeline a non-developer edits, so an editor saving
    it as Latin-1 is the likeliest way it ever goes unreadable,
    and `merge-keys._load_map` catches it by name for the same
    reason.
    """
    if not out.exists():
        return {}, []
    entries, error = decode_json_object(out)
    if error is not None:
        raise WorksheetUnreadable(error)
    assert isinstance(entries, dict)
    drafts: dict[str, tuple[str, str]] = {}
    unusable: list[tuple[str, str]] = []
    for key, entry in entries.items():
        if isinstance(entry, str):
            # The hand-written shape: the value IS the text.
            if entry.strip():
                unusable.append((key, entry))
            continue
        if not isinstance(entry, dict):
            if entry is not None:
                unusable.append((key, repr(entry)))
            continue
        source = entry.get("source")
        text = entry.get("translation")
        if text is None:
            # No `translation` field at all. If the entry still
            # holds prose under some OTHER field, a mistyped key
            # ("translaton") is the likeliest cause and that
            # prose is somebody's draft — report the whole entry
            # rather than letting the rewrite eat it. `source`
            # is excluded because it is the English this tool
            # wrote there itself.
            if any(
                isinstance(value, str) and value.strip()
                for field, value in entry.items()
                if field != "source"
            ):
                unusable.append((key, repr(entry)))
            continue
        if not isinstance(text, str):
            unusable.append((key, repr(text)))
            continue
        if not text.strip():
            continue
        if isinstance(source, str):
            drafts[key] = (source, text)
        else:
            # Real text, but nothing to verify it against — the
            # same call `merge-keys` makes, reported not dropped.
            unusable.append((key, text))
    return drafts, unusable


def _report_discarded(
    label: str, dropped: list[tuple[str, str]]
) -> None:
    """Echoes each discarded draft with its text, the way
    `merge-keys` echoes what it refuses to merge — the terminal
    is the only remaining copy once the worksheet is rewritten."""
    if not dropped:
        return
    print(
        f"extract-keys: {len(dropped)} drafted translation(s) "
        f"{label}:",
        file=sys.stderr,
    )
    for key, text in dropped:
        print(f"    - {key}: {text!r}", file=sys.stderr)


def _prune_worksheet_dirs(removed: Path) -> None:
    """Leaves no empty worksheet tree behind after an unlink.
    `scripts/merge-keys` does this after its own unlink and owns
    the argument — why an empty `locale-worksheets/` is worse
    than none, and why the walk is deepest-first, deduped and
    never above the base. Read it there; this is the same rule,
    reached routinely now that a re-mint can find every key
    translated and delete the file.
    """
    for directory in dict.fromkeys(
        (removed.parent, worksheets_dir(ROOT))
    ):
        try:
            directory.rmdir()
        except OSError:
            pass


def write_missing(locale: str, mapping: dict[str, str]) -> int:
    """Writes `missing_<locale>.json` as `{key: {"source":
    <English>, "translation": ""}}` for every key `<locale>.json`
    doesn't have yet. The empty `translation` slot (not a
    heuristic comparing against the English source) is the sole
    "still needs translating" signal — `merge-keys` only folds
    a key back in once its `translation` is non-empty, so an
    untranslated entry keeps re-surfacing on every extract run
    instead of being silently swallowed.

    The worksheet lands in `WORKSHEETS_DIR`, never beside the
    catalogs it was computed from — `scripts/locale_paths.py`
    owns that path.

    **A worksheet already on disk is read first, any non-empty
    `translation` in it is carried into the one this writes, and
    a draft that cannot be carried is echoed with its text.**
    Never weaken that to a silent drop —
    `.claude/rules/localization.md` ▸ "A re-mint must never
    silently discard drafted work" argues why, and
    `LocaleWorksheetCarryTests`, `LocaleWorksheetDiscardTests`
    and `LocaleWorksheetRefusalTests` hold it.

    A draft is carried only while its stored `source` still
    equals the current English, which is the rule `merge-keys`
    already merges by: once the English moves, the draft
    translates text the app no longer shows, so the slot is
    cleared rather than carried into a worksheet that would look
    finished.

    Note what that predicate asks: *did the English move*, not
    *is this translation still wanted*. A
    `scripts/drop-key --locale <locale> <key>` retirement leaves
    the English untouched and so passes it — `merge-keys` has
    the identical blind spot, so nothing new reaches a catalog,
    but a worksheet that outlives its merge will carry retired
    text forward where a blanking re-mint used to sanitize it."""
    locale_file = LOCALES_DIR / f"{locale}.json"
    existing: dict[str, str] = {}
    if locale_file.exists():
        try:
            existing = json.loads(
                locale_file.read_text(encoding="utf-8")
            )
        except json.JSONDecodeError:
            existing = {}
    out = WORKSHEETS_DIR / worksheet_name(locale)
    try:
        drafted, unusable = read_drafts(out)
    except WorksheetUnreadable as error:
        # "the worksheet", not "nothing": `main` regenerates
        # en.json before calling this, so that half of the run
        # has already happened and saying otherwise sends the
        # reader looking for a rollback that never occurred.
        print(
            f"extract-keys: {out} exists but will not parse "
            f"({error}). Overwriting it would destroy whatever "
            "is in it, so the worksheet was left untouched — fix "
            "the JSON, or move the file aside, then run this "
            "again. (en.json was still rebuilt.)",
            file=sys.stderr,
        )
        return 1

    missing: dict[str, dict[str, str]] = {}
    stale: list[tuple[str, str]] = []
    for key, english in mapping.items():
        if existing.get(key):
            continue
        source, text = drafted.pop(key, ("", ""))
        if text and source != english:
            # The English moved while the draft was out, so the
            # draft translates text the app no longer shows.
            # `merge-keys` would refuse it for the same reason;
            # clearing the slot here says so a round earlier,
            # while the translator can still see the new source.
            stale.append((key, text))
            text = ""
        missing[key] = {"source": english, "translation": text}
    # Whatever is left held a draft this run cannot place. Two
    # causes, reported apart the way `merge-keys` reports its
    # own: telling a translator their key is "already
    # translated" when it was deleted from the app sends them
    # looking in <locale>.json for something that is simply
    # gone. `key in mapping` is what separates them.
    already = sorted(
        (key, text)
        for key, (_, text) in drafted.items()
        if key in mapping
    )
    departed = sorted(
        (key, text)
        for key, (_, text) in drafted.items()
        if key not in mapping
    )

    # Reported before either branch below writes or unlinks:
    # once the worksheet is gone the terminal is the only copy.
    _report_discarded(
        "cleared — their English has changed since", stale
    )
    _report_discarded(
        "dropped — this locale already translates them", already
    )
    _report_discarded(
        "dropped — their key has left en.json", departed
    )
    _report_discarded(
        "NOT carried — the worksheet entry was malformed",
        unusable,
    )

    # The count rides the SUMMARY line, not only the stderr
    # echo above — that is the line a human skims and a wrapper
    # captures, and on this branch a bare "nothing written"
    # reads as a clean success while a worksheet holding drafts
    # is deleted. `merge-keys` pays the same cost for the same
    # reason and argues it at its own summary.
    discarded = (
        len(stale) + len(already) + len(departed) + len(unusable)
    )

    if not missing:
        if out.exists():
            out.unlink()
            _prune_worksheet_dirs(out)
        if discarded:
            print(
                f"extract-keys: {locale} has no missing keys — "
                f"deleted a worksheet still holding {discarded} "
                "drafted translation(s), listed above."
            )
        else:
            print(
                f"extract-keys: {locale} has no missing keys "
                f"(nothing written)."
            )
        return 0

    carried = sum(
        1 for entry in missing.values() if entry["translation"]
    )
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(
        json.dumps(
            missing, indent=2, sort_keys=True, ensure_ascii=False
        )
        + "\n",
        encoding="utf-8",
    )
    print(
        f"extract-keys: {len(missing)} missing key(s) for "
        f"'{locale}' written to {out}"
    )
    if carried:
        print(
            f"extract-keys: {carried} translation(s) already "
            "drafted in the previous worksheet were carried "
            "over — merge when you are ready."
        )
    if discarded:
        print(
            f"extract-keys: {discarded} drafted translation(s) "
            "could NOT be carried — each is listed above with "
            "its text, which is now the only copy."
        )
    flag = "--site " if LOCALES_DIR == SITE_LOCALES_DIR else ""
    print(
        'Fill each entry\'s "translation" field, then run: '
        f"scripts/merge-keys {flag}{locale}"
    )
    return 0


def _site_mapping() -> dict[str, str]:
    """Site mode's stand-in for `extract()`: the site's en.json is
    the hand-authored key map (no Swift to scan), so load it
    directly. Fails loudly if it is absent or not a flat
    {string: string} map — the same shape every locale must have."""
    if not EN_JSON.exists():
        print(
            f"extract-keys --site: {EN_JSON} not found.",
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        data = json.loads(EN_JSON.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        print(
            f"extract-keys --site: {EN_JSON} is invalid JSON "
            f"({error}).",
            file=sys.stderr,
        )
        sys.exit(1)
    if not isinstance(data, dict) or not all(
        isinstance(value, str) for value in data.values()
    ):
        print(
            f"extract-keys --site: {EN_JSON} must be a flat "
            "{string: string} map.",
            file=sys.stderr,
        )
        sys.exit(1)
    return data


def main(argv: list[str]) -> int:
    global LOCALES_DIR, EN_JSON, WORKSHEETS_DIR
    args = argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__)
        return 0
    site = "--site" in args
    conflict = site_override_conflict(site)
    if conflict:
        print(f"extract-keys --site: {conflict}", file=sys.stderr)
        return 1
    if site:
        args = [a for a in args if a != "--site"]
        LOCALES_DIR = SITE_LOCALES_DIR
        EN_JSON = LOCALES_DIR / "en.json"
        WORKSHEETS_DIR = SITE_WORKSHEETS_DIR
    for arg in args:
        if arg.startswith("-") and arg not in ("--check", "--prune"):
            print(
                f"extract-keys: unrecognized option '{arg}'",
                file=sys.stderr,
            )
            return 1
    if len(args) > 1:
        print(__doc__)
        return 1
    mode = args[0] if args else None
    mapping = _site_mapping() if site else extract()
    if mode == "--check":
        # Site mode drops the residue heuristic — see
        # `check_content` — and adds the parity gate the app
        # corpus deliberately does not want (#869).
        return check(mapping, residue=not site, site=site)
    if mode == "--prune":
        return prune(mapping, regen=not site)
    # Default action: (re)build the manifest, plus optionally the
    # missing round-trip for a locale. Site en.json is authored by
    # hand, so it is never regenerated.
    if not site:
        write_en_json(mapping)
    if mode:
        return write_missing(mode, mapping)
    elif site:
        print(
            "extract-keys --site: no locale given. Run "
            "`scripts/extract-keys --site <locale>` (e.g. de) to "
            "compute its missing keys."
        )
    else:
        print(
            "extract-keys: no locale given — only en.json was "
            "rebuilt. Run `scripts/extract-keys <locale>` to "
            "also compute missing keys for a locale."
        )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
