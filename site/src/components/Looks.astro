      display: none;
    }
    .touch-note {
      display: inline;
    }
    p.touch-note {
      display: block;
    }
  }
</style>

<script>
  // The overlay: opening and closing keep the page where it is, Escape
  // closes, focus moves in, stays in, and returns to the card.
  const openDetail = () =>
    document.querySelector<HTMLElement>(".detail:target");
  /** Moves to `#id` with the page's scroll position unchanged. */
  const goTo = (id: string) => {
    const y = window.scrollY;
    location.hash = id;
    window.scrollTo({ top: y, behavior: "instant" });
  };
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest?.<HTMLAnchorElement>(
      'a[href^="#look-"]',
    );
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    goTo((link.getAttribute("href") ?? "").slice(1));
  });
  let lastDetail: HTMLElement | null = null;
  const syncFocus = () => {
    const detail = openDetail();
    if (detail) {
      detail.querySelector<HTMLElement>(".detail__sheet")?.focus();
    } else if (lastDetail) {
      document
        .getElementById(lastDetail.dataset.card ?? "")
        ?.querySelector<HTMLElement>(".card__title a")
        ?.focus({ preventScroll: true });
    }
    lastDetail = detail;
  };
  window.addEventListener("hashchange", syncFocus);
  window.addEventListener("load", syncFocus);
  document.addEventListener("keydown", (event) => {
    const detail = openDetail();
    if (!detail) return;
    if (event.key === "Escape") {
      goTo(detail.dataset.card ?? "");
    } else if (event.key === "Tab") {
      const stops = Array.from(
        detail.querySelectorAll<HTMLElement>(".detail__sheet a[href]"),
      ).filter((a) => a.offsetParent !== null);
      const first = stops[0];
      const last = stops[stops.length - 1];
      const here = document.activeElement;
      const leaving =
        !detail.contains(here) ||
        (event.shiftKey
          ? here === first || here === first?.closest(".detail__sheet")
          : here === last);
      if (leaving && first && last) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      }
    }
  });

  // Search, tag filter and sort over the cards the build already
  // ordered for Discover. Each card carries its rank in every order
  // and its search text, so nothing here fetches anything.
  const root = document.querySelector<HTMLElement>("[data-looks]");
  const grid = root?.querySelector<HTMLElement>("#looks-grid");
  const toolbar = root?.querySelector<HTMLElement>("[data-looks-toolbar]");
  if (root && grid && toolbar) {
    const cards = Array.from(grid.children) as HTMLElement[];
    const input = toolbar.querySelector<HTMLInputElement>("[data-looks-search]");
    const count = root.querySelector<HTMLElement>("[data-looks-count]");
    const none = root.querySelector<HTMLElement>("[data-looks-none]");
    const number = new Intl.NumberFormat(document.documentElement.lang);
    const norm = (s: string) =>
      s.normalize("NFKD").replace(/\p{M}/gu, "").toLowerCase();
    let sort = "discover";
    let tag = "";

    const apply = () => {
      const words = norm(input?.value ?? "").split(/\s+/).filter(Boolean);
      const rank = (c: HTMLElement) => Number(c.dataset[sort] ?? 0);
      let shown = 0;
      for (const card of [...cards].sort((a, b) => rank(a) - rank(b))) {
        const tags = (card.dataset.tags ?? "").split(" ");
        const text = card.dataset.search ?? "";
        const match =
          (!tag || tags.includes(tag)) && words.every((w) => text.includes(w));
        card.hidden = !match;
        if (match) shown++;
        grid.append(card);
      }
      grid.dataset.sort = sort;
      if (count) {
        const template = shown === 1 ? count.dataset.one : count.dataset.other;
        count.textContent = (template ?? "").replace("{n}", number.format(shown));
      }
      if (none) none.hidden = shown > 0;
    };

    const press = (group: string, chosen: HTMLElement) => {
      toolbar.querySelectorAll<HTMLElement>(group).forEach((b) =>
        b.setAttribute("aria-pressed", String(b === chosen)),
      );
    };
    toolbar.querySelectorAll<HTMLElement>("[data-sort]").forEach((b) =>
      b.addEventListener("click", () => {
        sort = b.dataset.sort ?? "discover";
        press("[data-sort]", b);
        apply();
      }),
    );
    // The disclosure: extras stay in their own order when shown; a
    // chosen extra sits in the picked slot while they are hidden.
    const toggle = toolbar.querySelector<HTMLElement>("[data-tags-toggle]");
    const toggleLabel = toggle?.querySelector<HTMLElement>(
      "[data-tags-toggle-label]",
    );
    const more = toolbar.querySelector<HTMLElement>("#looks-more-tags");
    const picked = toolbar.querySelector<HTMLElement>("[data-tags-picked]");
    const extras = more
      ? (Array.from(more.querySelectorAll("[data-tag]")) as HTMLElement[])
      : [];
    const place = () => {
      if (!more || !picked) return;
      const open = !more.hidden;
      // Moves only a chip whose slot changes, so a focused chip is
      // never re-inserted where it already is.
      extras.forEach((chip, i) => {
        const home = open || chip.dataset.tag !== tag ? more : picked;
        if (chip.parentElement === home) return;
        if (home === picked) return void picked.append(chip);
        const next = extras.slice(i + 1).find((c) => c.parentElement === more);
        more.insertBefore(chip, next ?? null);
      });
    };
    toggle?.addEventListener("click", () => {
      if (!more) return;
      const open = more.hidden;
      more.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      if (toggleLabel) {
        toggleLabel.textContent =
          (open ? toggle.dataset.fewer : toggle.dataset.more) ?? "";
      }
      place();
    });

    const chooseTag = (value: string) => {
      tag = value;
      toolbar.querySelectorAll<HTMLElement>("[data-tag]").forEach((b) =>
        b.setAttribute("aria-pressed", String((b.dataset.tag ?? "") === tag)),
      );
      place();
      apply();
    };
    toolbar.querySelectorAll<HTMLElement>("[data-tag]").forEach((b) =>
      b.addEventListener("click", () => chooseTag(b.dataset.tag ?? "")),
    );
    input?.addEventListener("input", apply);
    root.querySelector<HTMLElement>("[data-looks-reset]")
      ?.addEventListener("click", () => {
        if (input) input.value = "";
        chooseTag("");
        input?.focus();
      });
    toolbar.hidden = false;
  }
</script>
