  }
  .caption .quiet {
    white-space: nowrap;
    color: var(--text-faint);
  }
  .looks-foot {
    padding-block: 2rem 1rem;
    margin: 2rem 0 0;
    color: var(--text-faint);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
  }

  /* Touch screens, decided by input device and never by width
     (#1740 ▸ Page details): the add and download give way to a
     note. */
  .touch-note {
    display: none;
    font-size: 0.84rem;
    color: var(--text-faint);
  }
  p.touch-note {
    margin: 0.4rem 0 0;
  }
  @media (hover: none) and (pointer: coarse) {
