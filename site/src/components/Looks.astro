  }
  /* Beside each other only where both keep a useful width; a window
     tiled to half a screen gets the stacked sheet. */
  @media (min-width: 800px) {
    .detail__main {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
    /* The close button floats over the picture's row, so the title
       column clears it. */
    .detail__info {
