  /* ---- Detail: an overlay over the grid, shown when targeted. Its
     height never passes the window: the sheet scrolls inside itself
     and the page behind stays put. ---- */
  :global(html:has(.detail:target)) {
    overflow: hidden;
  }
  /* The overlay's stacking context must clear the sticky nav's. */
  :global(main:has(.detail:target)) {
    position: relative;
    z-index: 60;
  }
  .detail {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    padding: clamp(0.5rem, 3vw, 2rem);
  }
  .detail:target {
    display: grid;
    place-items: center;
  }
  .detail__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    cursor: default;
  }
  .detail__sheet {
    position: relative;
    box-sizing: border-box;
    width: min(1100px, 100%);
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-3);
    box-shadow: var(--shadow-sm);
    padding: clamp(14px, 2.5vw, 1.5rem);
  }
  .detail__sheet:focus {
    outline: none;
  }
  /* Sticky, so a long sheet scrolled inside itself can still close;
     the negative margin keeps the float from narrowing the content. */
  .detail__close {
    position: sticky;
    top: 0;
    z-index: 2;
    float: right;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: -2.25rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--bg-3);
    color: var(--text);
  }
  .detail__close:hover {
    border-color: var(--ghost-hover-border);
