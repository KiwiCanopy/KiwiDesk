---
// KiwiDesk — standalone legal page (Impressum / Datenschutzerklärung).
//
// The docs are Starlight and the landing is a monolith; the legal pages are
// their own small standalone Astro documents that reuse the landing's design
// tokens (landing.css) via PageShell.astro so they match the marketing surface
// without pulling in Starlight's chrome. German is legally binding; en/ja are
// courtesy translations (see src/i18n/legal.ts).
import PageShell, { type Lang } from "./PageShell.astro";
import { legal, type LegalDoc } from "../i18n/legal";

interface Props {
  lang: Lang;
  doc: "impressum" | "datenschutz";
}
const { lang, doc } = Astro.props;

function localePath(l: Lang, sub = ""): string {
  const prefix = l === "en" ? "" : `/${l}`;
  return `${prefix}${sub}` || "/";
}

const strings = legal[lang];
const data: LegalDoc = strings[doc];
const slug = doc === "impressum" ? "/imprint" : "/privacy";
const showNote = lang !== "de" && !!strings.translationNote;

const pageTitle = `${data.title} · KiwiDesk`;
const pageDesc = `${data.title} — KiwiDesk / KiwiCanopy.`;
---

<PageShell
  lang={lang}
  slug={slug}
  title={pageTitle}
  desc={pageDesc}
  noindex={true}
  mainClass="legal"
>
  <a class="back" href={localePath(lang)}>← {strings.backHome}</a>
  <h1>{data.title}</h1>
  <p class="updated">{strings.updatedLabel} {data.updated}</p>

  {showNote && <p class="note">{strings.translationNote}</p>}

  {
    data.sections.map((s) => (
      <section class="sec">
        <h2>{s.title}</h2>
        <div class="body" set:html={s.body} />
      </section>
    ))
  }
</PageShell>

<style>
  .legal {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    color: var(--text);
    line-height: 1.15;
  }
  .updated {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .note {
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-2);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--text-dim);
  }
  .sec {
    margin-top: 2.25rem;
    /* landing.css gives every bare <section> large marketing padding-block;
       these legal sections are plain prose, so reset it — otherwise huge
       vertical gaps open between numbered sections. */
    padding-block: 0;
  }
  .sec h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .body {
    margin-top: 0.6rem;
    color: var(--text);
  }
  /* landing.css resets box-sizing but not margins, so kill the browser's
     default vertical <p> margin and keep only the intended top rhythm. */
  .body :global(p) {
    margin: 0.7rem 0 0;
  }
  .body :global(p:first-child) {
    margin-top: 0;
  }
  .body :global(ul) {
    margin: 0.7rem 0 0;
    padding-left: 1.25rem;
  }
  .body :global(li) {
    margin-top: 0.25rem;
  }
  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--bg-2);
  }
</style>
