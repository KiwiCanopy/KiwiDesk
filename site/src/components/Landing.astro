---
// KiwiDesk — shared marketing landing component.
//
// Rendered by SIX routes: / , /de/ , /ja/ (Simple mode) and
// /nerd/ , /de/nerd/ , /ja/nerd/ (Nerd mode). All user-facing
// copy arrives via the `t` prop (a per-locale strings object
// loaded from src/i18n/<lang>.json); this file owns only the
// structure, assets, and behavior — never inline copy.
//
// The mode IS the URL (owner + SEO consult, 2026-08-26): each
// mode gets its own page with its own title, h1, description and
// hreflang cluster, because one page can only rank for one
// audience — the dev keywords used to sit in display:none
// sections under a consumer title. The toggle is two prefetched
// links now, `kiwidesk-site-mode` is retired, and only the
// active mode's sections render, so nothing meaningful ships
// hidden. Cross-mode links are plain links — never hreflang
// alternates, which must stay within a mode.
//
// Two independent client states remain, each with its own
// localStorage key:
//   • theme  — `starlight-theme` (shared with the docs)
//   • lang   — `kiwidesk-site-lang` ("en" | "de" | "ja"), paired
//              with the route; resolved anti-FOUC in <head>,
//              staying WITHIN the current mode's cluster.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ThemeHead from "./ThemeHead.astro";
import logoMark from "../assets/brand/logo.svg";
import kiwiMark from "../assets/brand/kiwi-mark.svg";
import kofiIcon from "../assets/brand/kofi_symbol.svg";
import wordmark from "../assets/brand/logo_wordmark.svg";
import wordmarkDark from "../assets/brand/logo_wordmark_dark.svg";
import ogBannerEn from "../assets/brand/og-banner.jpg";
import ogBannerDe from "../assets/brand/og-banner.de.jpg";
import ogBannerJa from "../assets/brand/og-banner.ja.jpg";
import kiwiCanopy from "../assets/brand/kiwi-canopy.png";
import { layoutDiagram } from "../lib/layoutDiagram";
import {
  downloadHref,
  downloadVersion,
  downloadIsPrerelease,
} from "../lib/download";
import en from "../i18n/en.json";
import "../styles/landing.css";

interface Props {
  t: Record<string, string>;
  lang: "en" | "de" | "ja";
  mode?: "simple" | "dev";
}
const { t: locale, lang, mode = "simple" } = Astro.props;
const isDev = mode === "dev";
const isSimple = !isDev;

// One banner per locale — the card carries the tagline, so it has to speak
// the same language as the title and description beside it.
const ogImage = lang === "de" ? ogBannerDe : lang === "ja" ? ogBannerJa : ogBannerEn;

// Per-key English fallback: an untranslated locale key degrades to
// English rather than rendering blank (mirrors Guide.astro).
const t = { ...en, ...locale } as Record<string, string>;

// Home path for the active locale; the language switcher pairs it
// with its counterpart. English lives at /, German at /de/.
const homeHref =
  lang === "de" ? "/de/" : lang === "ja" ? "/ja/" : "/";

// Same-locale path for each mode: the Simple page is the locale
// home, the Nerd page its `nerd/` sibling. `pageHref` is THIS
// page; the toggle links to both. `/nerd/`, not `/dev/`: the
// slug says what the toggle says (owner, 2026-08-26) — one word
// across UI, URL and all three locales — and cannot be confused
// with /docs/.
const simpleHref = homeHref;
const devHref = `${homeHref}nerd/`;
const pageHref = isDev ? devHref : simpleHref;

// The same-mode home path per locale — the language switcher and
// the anti-redirect resolver both stay INSIDE the active mode's
// cluster, so switching language never also switches audience.
const langHref = (l: "en" | "de" | "ja"): string => {
  const home = l === "de" ? "/de/" : l === "ja" ? "/ja/" : "/";
  return isDev ? `${home}nerd/` : home;
};

// Locale-aware quotation marks: German opens low and closes high
// („…“); English opens and closes high (“…”). Applied to every
// quoted line so the marks match the active language.
const oq = lang === "de" ? "„" : lang === "ja" ? "「" : "“";
const cq = lang === "de" ? "“" : lang === "ja" ? "」" : "”";

const repo = "https://github.com/KiwiCanopy/KiwiDesk";
const kofi = "https://ko-fi.com/kiwicanopy";
const kiwiCanopyUrl = "https://kiwicanopy.com";
// The maker's personal GitHub profile — distinct from the project
// repo link above, used only for the low-key footer credit.
const makerProfile = "https://github.com/hajiboy95";
const buildCmd =
  `git clone ${repo}.git\ncd KiwiDesk\nswift build -c release`;
// The ONE place the install command is spelled out on this page
// (Guide.astro deliberately holds no copy of it — it bridges here
// instead). The beta ships from a personal tap; a fully-qualified
// token auto-taps, so this stays a single command. If KiwiDesk is
// later accepted into homebrew-cask it shortens to
// `brew install --cask kiwidesk` — a one-line edit here.
const installCmd = "brew install --cask kiwicanopy/tap/kiwidesk";


// A crisp kiwi-slice glyph (green skin, pale flesh ring, small
// core, a ring of seed dots) for the mode toggle — drawn rather
// than the 🥝 emoji so it renders identically and cleanly at these
// small sizes across platforms. `size` is the rendered px box.
function kiwiSvg(size: number): string {
  return (
    `<img class="mode-toggle__kiwi" src="${kiwiMark.src}" ` +
    `width="${size}" height="${size}" alt="" aria-hidden="true" />`
  );
}

// The per-layout inline diagrams (viewBox 0 0 160 90) live in
// ../lib/layoutDiagram.ts so the /learn/ page renders the exact
// same drawings from one source (imported above).

const features = [
  { title: t.feat_1_title, body: t.feat_1_body, icon: "lucide:columns-3" },
  { title: t.feat_2_title, body: t.feat_2_body, icon: "lucide:layout-dashboard" },
  { title: t.feat_3_title, body: t.feat_3_body, icon: "lucide:code" },
  { title: t.feat_4_title, body: t.feat_4_body, icon: "lucide:square-terminal" },
  { title: t.feat_5_title, body: t.feat_5_body, icon: "lucide:gauge" },
  { title: t.feat_6_title, body: t.feat_6_body, icon: "lucide:shield-check" },
  { title: t.feat_7_title, body: t.feat_7_body, icon: "lucide:pin" },
  { title: t.feat_8_title, body: t.feat_8_body, icon: "lucide:accessibility" },
  { title: t.feat_9_title, body: t.feat_9_body, icon: "lucide:app-window-mac" },
];

const layouts = [
  { name: "bsp", label: "BSP", desc: t.layout_bsp },
  { name: "stack", label: "Stack", desc: t.layout_stack },
  { name: "scrolling", label: "Scrolling", desc: t.layout_scrolling },
  { name: "monocle", label: "Monocle", desc: t.layout_monocle },
  { name: "grid", label: "Grid", desc: t.layout_grid },
  { name: "track", label: "Track", desc: t.layout_track },
  { name: "floating", label: "Floating", desc: t.layout_floating },
];

// The Simple-mode perks under the before/after pair. Two
// papercuts KiwiDesk actually solves, then the trust claims —
// "will it fight my Mac", "will I have to configure it", "can I
// use it without a mouse" — which answer a different question
// from "does it fix something" and are the reason the list is not
// four grievances in a row.
const perks = [
  t.calm_point_1,
  t.calm_point_2,
  t.calm_point_3,
  t.calm_point_4,
  t.calm_point_5,
  t.calm_point_6,
];

// The three friendly "how it works" steps (Simple mode).
const steps = [
  { n: "1", title: t.how_1_title, body: t.how_1_body },
  { n: "2", title: t.how_2_title, body: t.how_2_body },
  { n: "3", title: t.how_3_title, body: t.how_3_body },
];

// SEO/head: absolute URLs derived from Astro.site so they survive
// the pages.dev → custom-domain switch. `canonical` is this
// locale's own page IN THIS MODE — each of the six pages is
// self-canonical, never canonicalized across modes — and the
// hreflang alternates stay within the mode's own cluster.
// Per-mode title/description: the whole point of the split is
// that the Nerd page may say "tiling window manager" in the one
// place a consumer page could not.
const canonical = new URL(pageHref, Astro.site).href;
const enURL = new URL(langHref("en"), Astro.site).href;
const deURL = new URL(langHref("de"), Astro.site).href;
const jaURL = new URL(langHref("ja"), Astro.site).href;
const metaTitle = isDev ? t.meta_title_nerd : t.meta_title;
const metaDesc = isDev ? t.meta_desc_nerd : t.meta_desc;
const ogImageURL = new URL(ogImage.src, Astro.site).href;
const ogLocale =
  lang === "de" ? "de_DE" : lang === "ja" ? "ja_JP" : "en_US";
const ogLocaleAlt = lang === "en" ? "de_DE" : "en_US";

// Structured data: KiwiDesk itself (SoftwareApplication) plus the
// site (WebSite), emitted as one JSON-LD graph in the head.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "KiwiDesk",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS",
    description: metaDesc,
    url: canonical,
    image: ogImageURL,
    inLanguage: lang,
    isAccessibleForFree: true,
    softwareRequirements: "macOS 14 or later, Apple silicon",
    // Spread rather than set: a release published without a disk
    // image must leave these OUT of the graph entirely, the same
    // rule the page's own affordances follow. A `downloadUrl`
    // pointing at bytes that were never published is the machine
    // -readable version of the button that 404s.
    ...(downloadHref
      ? { downloadUrl: downloadHref, installUrl: downloadHref }
      : {}),
    ...(downloadVersion ? { softwareVersion: downloadVersion } : {}),
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    author: {
      "@type": "Organization",
      name: "KiwiCanopy",
      url: makerProfile,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KiwiDesk",
    url: canonical,
    inLanguage: lang,
    description: metaDesc,
  },
];
---

<!doctype html>
{/* data-mode is SERVER-rendered now — the mode is the page, so
     the CSS that keys on :root[data-mode] needs no script and
     cannot flash. */}
<html lang={lang} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="KiwiDesk" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageURL} />
    <ThemeHead />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="de" href={deURL} />
    <link rel="alternate" hreflang="ja" href={jaURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
    ></script>
    {/* The mode script is GONE — data-mode is server-rendered on
         <html>, so there is nothing to resolve and nothing to
         flash. One legacy case survives it: pre-split links to
         /#start (the install bridge's old shareable URL) point at
         a section that now lives only on the Nerd page. Forward
         that hash arrival, Simple pages only, before paint, via
         replace() so the back button works. One direction only —
         the Nerd page forwards nothing — so no loop is possible. */}
    {isSimple && (
      <script is:inline define:vars={{ devHref }}>
        if (location.hash === "#start") {
          location.replace(devHref + "#start");
        }
      </script>
    )}
    {/* Language resolve (anti-redirect-loop). Runs before paint,
         at most once per load, and only ever redirects between the
         two known paths (/ ↔ /de/) via replace() so the back
         button still works.
           1. A stored `kiwidesk-site-lang` wins — honor an explicit
              earlier choice by sending the visitor to its path.
           2. No stored pref: fall back to navigator.language, but
              ONLY nudge an English URL toward German (never the
              reverse), so the English root stays the canonical
              default and there is no path we could bounce back on.
         The `!== current` guard makes every branch a no-op when we
         are already on the target, which is what makes loops
         impossible. `paths` and `current` arrive from the server
         via define:vars — this page statically knows its own
         locale AND mode, so the resolver stays inside the active
         mode's cluster (switching language must never also switch
         audience) with no URL parsing to drift out of date. */}
    <script is:inline
      define:vars={{
        paths: {
          en: langHref("en"),
          de: langHref("de"),
          ja: langHref("ja"),
        },
        current: lang,
      }}>
      (function () {
        function go(lang) {
          // Carry the fragment across the locale redirect. Without
          // it a shared /#start (the install bridge's own URL)
          // drops its hash for any visitor whose locale differs
          // from the link's, landing them at the top of another
          // locale's page with nothing to explain why.
          if (lang !== current) {
            location.replace(paths[lang] + location.hash);
          }
        }
        var stored;
        try {
          stored = localStorage.getItem("kiwidesk-site-lang");
        } catch (e) {
          stored = null;
        }
        if (paths[stored]) return go(stored);
        // No stored pref: nudge by navigator.language, but only away
        // from the English root, never between two non-English ones
        // — that keeps / the sole canonical default and leaves no
        // pair we could bounce between.
        if (current !== "en") return;
        var nav = (navigator.language || "").toLowerCase();
        if (nav.indexOf("de") === 0) return go("de");
        if (nav.indexOf("ja") === 0) return go("ja");
      })();
    </script>
    {/* Restore scroll after a language switch: the EN|DE switcher
         stashes scrollY before navigating, so switching languages
         lands you at the same spot instead of jumping to the top. */}
    <script is:inline>
      (function () {
        try {
          var y = sessionStorage.getItem("kiwidesk-scroll");
          if (y === null) return;
          sessionStorage.removeItem("kiwidesk-scroll");
          addEventListener("DOMContentLoaded", function () {
            window.scrollTo({
              top: parseInt(y, 10) || 0,
              behavior: "instant",
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {/* Skip link (WCAG 2.4.1): first focusable element, jumps past
         the nav to the page content. Off-screen until focused. */}
    <a class="skip-link" href="#main-content">{t.skip_to_content}</a>
    {/* ============ Nav ============ */}
    <nav class="nav" id="nav">
      <div class="wrap nav__inner">
        <a class="nav__brand" href={homeHref}
          aria-label={t.nav_home_label}>
          <img class="nav__mark" src={logoMark.src}
            width="28" height="28" alt="" aria-hidden="true" />
          <span>KiwiDesk</span>
        </a>
        <div class="nav__links">
          {/* Guide: shown in BOTH modes — newcomers arriving in
               Simple mode need the single-scroll /guide/ page, and
               it's useful in Nerd mode too. */}
          <a class="nav__link nav__link--guide" href="/guide/"
            >{t.nav_guide}</a>
          {/* No Comparison entry here (design + site review,
               2026-08-30). A global nav asks every visitor on every
               page whether that word is for them — including a
               Simple reader who does not yet know what tiling is.
               The in-content links self-select instead: they NAME
               yabai, AeroSpace and Rift, so a reader who does not
               recognise them reads past. It was also 114px the nav
               could not afford — it pushed the theme toggle off
               screen below 500px — and `nav__link--changelog`
               already sheds at 720px, so a longer word in two of
               three locales could not have stayed at every width.
               /compare/ is reached from the hero, #calm and every
               footer. */}
          {/* Release Notes: shown in Nerd mode (dev-only). "What changed"
               is accessible to everyone via the footer and About window. */}
          <a class="nav__link nav__link--changelog dev-only"
            href={`${homeHref}changelog/`}>{t.nav_changelog}</a>
          {/* Docs + GitHub live in the DOM always but are hidden in
               Simple mode (dev-only, via .dev-only). */}
          <a class="nav__link dev-only" href="/docs/">{t.nav_docs}</a>
          <a class="nav__link dev-only" href={repo} target="_blank"
            rel="noopener">{t.nav_github}</a>

          {/* Signature mode toggle — now two LINKS, since the
               mode is the URL (owner + SEO consult, 2026-08-26).
               The look survives whole: BOTH modes stay labeled —
               [ 🥝 Simple | Nerd ] — the active segment fills in
               (data-mode on <html> still drives the CSS, it is
               just server-rendered now), and the kiwi indicator
               renders in its resting place per page. What the
               split retires is only the in-page glide/flourish;
               prefetch-on-hover keeps the switch near-instant.

               ARIA: a plain navigation group. Radio semantics
               died with the buttons — a link that navigates is
               not a radio, and aria-current="page" is the truth
               a screen reader needs here. Keyboard operation is
               native link behavior, so the roving-tabindex
               script went with the radios. */}
          <div class="mode-toggle" id="modeToggle" role="group"
            aria-label={t.mode_toggle_aria}>
            {/* Kiwi indicator behind the segments — one kiwi on
                 Simple, the extra dots filled in on Nerd, exactly
                 as before, positioned by the same CSS. */}
            <span class="mode-toggle__slider" aria-hidden="true">
              <span class="mode-toggle__extra mode-toggle__extra--2">
                <Fragment set:html={kiwiSvg(11)} />
              </span>
              <span class="mode-toggle__extra mode-toggle__extra--3">
                <Fragment set:html={kiwiSvg(11)} />
              </span>
              <span class="mode-toggle__kiwi-lead">
                <Fragment set:html={kiwiSvg(15)} />
              </span>
            </span>
            <a class="mode-toggle__seg mode-toggle__seg--simple"
              href={simpleHref} data-mode="simple"
              data-astro-prefetch="hover"
              aria-current={isSimple ? "page" : undefined}>
              <span class="mode-toggle__seg-text">{t.mode_simple}</span>
            </a>
            <a class="mode-toggle__seg mode-toggle__seg--dev"
              href={devHref} data-mode="dev"
              data-astro-prefetch="hover"
              aria-current={isDev ? "page" : undefined}>
              <span class="mode-toggle__seg-text">{t.mode_dev}</span>
            </a>
            <span class="mode-toggle__tip" role="tooltip">
              <span class="mode-toggle__tip--simple"
                >{t.mode_tooltip_simple}</span>
              <span class="mode-toggle__tip--dev"
                >{t.mode_tooltip_dev}</span>
            </span>
          </div>

          {/* Language switcher: a compact EN | DE | JA segmented
               control, styled as a sibling of the theme + mode
               toggles. Each segment is a link to that locale's route
               AND records the choice in `kiwidesk-site-lang` (wired
               up in the script below), so the preference persists
               across visits. The active locale is marked
               aria-current. Two-letter codes throughout, each in its
               own `lang` so a screen reader pronounces it in that
               language rather than spelling it out in English. */}
          <div class="lang-switch" role="group"
            aria-label={t.nav_lang_label}>
            {/* hrefs via langHref: language switching stays inside
                 the active mode's cluster — /de/nerd/ pairs with
                 /nerd/, never with /. */}
            <a class="lang-switch__opt" data-lang="en"
              href={langHref("en")} lang="en"
              aria-current={lang === "en" ? "true" : undefined}>EN</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="de"
              href={langHref("de")} lang="de"
              aria-current={lang === "de" ? "true" : undefined}>DE</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="ja"
              href={langHref("ja")} lang="ja"
              aria-current={lang === "ja" ? "true" : undefined}>JA</a>
          </div>

          <button class="theme-toggle" id="themeToggle" type="button"
            aria-label={t.nav_theme_label} aria-pressed="false">
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb">
                <Icon name="lucide:sun" class="theme-toggle__sun"
                  width={15} height={15} aria-hidden="true" />
                <Icon name="lucide:moon" class="theme-toggle__moon"
                  width={14} height={14} aria-hidden="true" />
              </span>
            </span>
          </button>

          {/* Ko-fi support button — last in the cluster, icon-only
               and compact. Reads as LESS obtrusive than a worded
               link: a small, recognizable control sitting quietly
               among the toggles. aria-label carries the meaning. */}
          <a class="nav__support" href={kofi} target="_blank"
            rel="noopener" aria-label={t.nav_support_aria} title={t.nav_support_aria}>
            <img class="kofi-icon" src={kofiIcon.src} alt=""
              aria-hidden="true" width="20" height="16" />
          </a>
        </div>
      </div>
    </nav>

    {/* Main landmark + skip-link target, wrapping all page content
         between the site nav and footer. */}
    <main id="main-content" tabindex="-1">
    {/* ============ Hero ============ */}
    <header class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="wrap">
        <img class="hero__mark hero__mark--light" src={wordmark.src}
          alt="KiwiDesk" width="230" height="273" />
        <img class="hero__mark hero__mark--dark"
          src={wordmarkDark.src} alt="KiwiDesk" width="230"
          height="273" />

        {/* Simple-mode hero copy */}
        {/* Only the active mode's hero renders — the split's
             whole point is that neither audience's content ships
             hidden on the other's page. Each page therefore has
             exactly ONE <h1>, its own (#868's rule, now satisfied
             per page rather than by demoting the Nerd hero). */}
        {isSimple && (
        <div class="hero__mode hero__mode--simple">
          <span class="hero__kicker">{t.hero_kicker}</span>
          <h1 class="hero__title">{t.hero_title}</h1>
          <p class="hero__sub">{t.hero_sub}</p>
          <div class="hero__cta">
            {/* The download leads in Simple mode (#904). The guide
                 detour this replaces existed only because there was
                 nothing to click; the app's own onboarding wizard
                 teaches the Accessibility permission the detour was
                 implicitly protecting, and the guide keeps a
                 first-class entrance in the closing band. Without a
                 published disk image the guide link returns — the
                 fallback is a whole install path, not a stub. */}
            {downloadHref ? (
              <a class="btn btn--primary" href={downloadHref}
                aria-describedby="heroReq">
                <Icon name="lucide:download" width={16} height={16}
                  aria-hidden="true" />
                {t.download_cta}
              </a>
            ) : (
              <a class="btn btn--primary" href={`${homeHref}guide/#getting-started`}>
                {t.hero_cta_primary}
              </a>
            )}
            {/* "Show me first" stays — the hero is not a pure
                 conversion ask and the demo is doing work. */}
            <a class="btn btn--ghost btn--ghost-light" href="#demo">
              <svg width="17" height="17" viewBox="0 0 24 24"
                fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
              {t.hero_cta_secondary}
            </a>
          </div>
          {downloadHref && (
            <p class="req req--center" id="heroReq">
              <Icon name="lucide:shield" width={15} height={15}
                aria-hidden="true" />
              {t.download_req}
            </p>
          )}
          {/* The badge states the version, read from the release
               the download actually points at. It used to read
               "Public beta — available now" — a hand-maintained
               claim, true when written and wrong from the moment
               1.0 shipped until somebody remembered it. Now the
               beta half appears only while the promoted release
               is flagged one, so it retires itself. */}
          {downloadVersion && (
            <span class="pill pill--light">
              <span class="pill__dot" aria-hidden="true"></span>
              {t.version_pill} {downloadVersion}
