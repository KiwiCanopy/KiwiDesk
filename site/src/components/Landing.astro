          )}
          {/* The Simple band's star ask (owner, 2026-08-26): a
               quiet line, not a button — the Simple reader who
               has GitHub gets the pointer without the band
               spending a button slot on an ask most of this
               audience cannot act on. The whole sentence is the
               link so each translation's word order owns where
               GitHub lands. Shown in BOTH modes since 2026-08-30:
               the Nerd hero used to carry this ask and now offers
               the repo instead, so this is the one star ask on
               either page and both closing bands match. */}
          <p class="req req--center star-hint">
            <Icon name="lucide:star" width={15} height={15}
              aria-hidden="true" />
            <a href={repo} target="_blank" rel="noopener">
              {t.cta_star_hint}
            </a>
          </p>
          <blockquote class="quote-aside quote-aside--center">
            <p>{oq}{t.quote_cta}{cq}</p>
          </blockquote>
        </div>
      </div>
    </section>
    </main>

    {/* ============ Footer ============ */}
    <footer class="footer">
      <div class="wrap">
        <div class="footer__brand">
          {/* The brand MARK links to the parent; the `© 2026
               KiwiCanopy` line below stays unlinked chrome, which
               is the call Footer.astro documents for the docs
               surface. Not for ranking — a subdomain linking its
               own root passes little, and an outbound link never
               lifts the page giving it — but for the
               product→parent entity association, and because a
               reader who wonders who made this had no way to
               find out. */}
          <a class="footer__parent" href={kiwiCanopyUrl}
            target="_blank" rel="noopener">
            <Image class="footer__logo" src={kiwiCanopy}
              alt=""
              widths={[110, 160, 220]}
              sizes="110px" />
            <span class="footer__name">{t.footer_org}<span aria-hidden="true"> ↗</span></span>
          </a>
          <p class="footer__tag">{t.footer_tag}</p>
        </div>
        {/* No Ko-fi here. It is offered twice already — quietly
             in the header nav, and as a real button in the
             closing CTA directly above this footer — and a third
             ask within one screen of the second reads as
             pestering rather than as an invitation. The key
             itself stays; the two live call sites use it. */}
        <nav class="footer__links" aria-label={t.footer_nav_aria}>
          <a class="dev-only" href="/docs/">{t.footer_docs}</a>
          <a class="dev-only" href={repo} target="_blank"
            rel="noopener">{t.footer_github}</a>
          <a href={`${homeHref}compare/`}>{t.nav_compare}</a>
          <a href={`${homeHref}changelog/`}>{t.footer_changelog}</a>
          {/* Legal links stay visible in every mode — the Impressum
              must be reachable from every page (§ 5 DDG). */}
          <a href={`${homeHref}imprint`}>{t.footer_impressum}</a>
          <a href={`${homeHref}privacy`}>{t.footer_privacy}</a>
        </nav>
        <p class="footer__copy">{t.footer_copy}</p>
        {/* Low-key maker credit — the maker's personal profile,
             distinct from the project repo link above. */}
        <p class="footer__credit">
          {t.footer_credit_built_by}{' '}
          <a href={makerProfile} target="_blank" rel="noopener">
            {t.footer_credit_name} · {t.footer_credit_handle}
          </a>
        </p>
        <p class="footer__daily">{t.daily_kiwi}</p>
      </div>
    </footer>

    <script>
      const html = document.documentElement;

      // ---- Theme toggle (shared `starlight-theme` key) ----
      const themeToggle = document.getElementById("themeToggle");
      const syncTheme = () => {
        const dark = html.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(dark));
      };
      syncTheme();
      themeToggle?.addEventListener("click", () => {
        const next =
          html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch (e) {
          /* storage unavailable — theme still applies in-page */
        }
        syncTheme();
      });
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          if (e.newValue === "light" || e.newValue === "dark") {
            html.dataset.theme = e.newValue;
            syncTheme();
          }
        }
      });

      // ---- Mode machinery: GONE (2026-08-26 split) ----
      // The mode is the URL now. applyMode, the mode radiogroup
      // wiring, the flourish replay, the cross-tab storage sync
      // and the install-bridge handler all retired with it; the
      // toggle is two prefetched links and `data-mode` arrives
      // server-rendered. `reduce` stays: the scroll-reveal below
      // still honors it.
      // ---- Language switcher (own `kiwidesk-site-lang` key) ----
      // Each segment is an <a> that already navigates to the target
      // route; here we only persist the explicit choice so the
      // <head> resolver honors it on later visits. Navigation
      // proceeds normally after the click handler (no preventDefault).
      document
        .querySelectorAll(".lang-switch__opt")
        .forEach((opt) => {
          opt.addEventListener("click", () => {
            const lang = opt.getAttribute("data-lang");
            if (lang !== "en" && lang !== "de" && lang !== "ja")
              return;
            try {
              localStorage.setItem("kiwidesk-site-lang", lang);
              // Stash scroll so the destination locale restores it.
              sessionStorage.setItem(
                "kiwidesk-scroll",
                String(window.scrollY)
              );
            } catch (e) {
              /* storage unavailable — route change still works */
            }
          });
        });

      // ---- Nav background on scroll ----
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav?.classList.add("scrolled");
        else nav?.classList.remove("scrolled");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // ---- Click-to-play demo video ----
      const video = document.getElementById("demoVideo") as
        | HTMLVideoElement
        | null;
      const overlay = document.getElementById("demoOverlay");
      overlay?.addEventListener("click", () => {
        if (overlay) overlay.hidden = true;
        video?.play?.();
      });
      video?.addEventListener("play", () => {
        if (overlay) overlay.hidden = true;
      });
      video?.addEventListener("pause", () => {
        if (overlay && video.currentTime === 0) overlay.hidden = false;
      });

      // ---- Copy the build commands ----
      // Labels come from data-* attributes so the copied/idle text
      // is localized (English "Copy"/"Copied", German
      // "Kopieren"/"Kopiert") without hardcoding either here.
      // Every .code block carries its own copy button (install and
      // build-from-source), each with its own label element, so the
      // handler is bound per button rather than to one id.
      document.querySelectorAll(".code__copy").forEach((copyBtn) => {
        const copyLabel = copyBtn.querySelector(".code__copy-label");
        copyBtn.addEventListener("click", async () => {
          const text = copyBtn.getAttribute("data-copy") || "";
          const idle = copyBtn.getAttribute("data-label-copy") || "";
          const done = copyBtn.getAttribute("data-label-done") || "";
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add("is-copied");
            if (copyLabel) copyLabel.textContent = done;
            setTimeout(() => {
              copyBtn.classList.remove("is-copied");
              if (copyLabel) copyLabel.textContent = idle;
            }, 1600);
          } catch (e) {
            /* clipboard blocked — no-op */
          }
        });
      });

      // ---- Scroll reveal (motion-aware) ----
      // Reveal every .reveal element currently within the viewport.
      // Called on load's IO fallback path and after a mode switch.
      function revealVisible() {
        document.querySelectorAll(".reveal:not(.in)").forEach((el) => {
          const r = el.getBoundingClientRect();
          const h = window.innerHeight || 0;
          // Skip hidden (display:none → zero rect) elements.
          if (r.width === 0 && r.height === 0) return;
          if (r.top < h * 0.92 && r.bottom > 0) el.classList.add("in");
        });
      }

      const els = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      }

      // ---- Card cursor-follow glow ----
      document.querySelectorAll(".card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          (card as HTMLElement).style.setProperty(
            "--mx",
            `${((e.clientX - r.left) / r.width) * 100}%`
          );
        });
      });
    </script>
  </body>
</html>
