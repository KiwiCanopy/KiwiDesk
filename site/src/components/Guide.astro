            </section>

            {/* ===== 3. Finding your favorite ===== */}
            <section class="learn-section" id="favorite">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_fav_eyebrow}</span>
                <h2>{s.guide_fav_title}</h2>
              </div>
              <p set:html={s.guide_fav_p1}></p>
              <p set:html={s.guide_fav_p2}></p>
              <div class="learn-callout">
                <span class="learn-callout__icon" aria-hidden="true">
                  <Icon name="lucide:info" />
                </span>
                <div class="learn-callout__body">
                  <h3>{s.guide_fav_callout_title}</h3>
                  <p>{s.guide_fav_callout_p}</p>
                </div>
              </div>
            </section>

            {/* ===== 4. The Settings app ===== */}
            <section class="learn-section" id="settings">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_settings_eyebrow}</span>
                <h2>{s.guide_settings_title}</h2>
              </div>
              <p set:html={s.guide_settings_p}></p>
              <ul class="learn-tour">
                {tour.map((sec) => (
                  <li>
                    <h3>{sec.title}</h3>
                    <p>{sec.body}</p>
                  </li>
                ))}
              </ul>
            </section>

            {/* ===== 5. FAQ ===== */}
            <section class="learn-section" id="faq">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_faq_eyebrow}</span>
                <h2>{s.guide_faq_title}</h2>
              </div>
              <div class="learn-faq">
                {faq.map((f) => (
                  <details class="learn-faq__item">
                    <summary class="learn-faq__q">
                      {f.q}
