---
// KiwiDesk — shared Guide component (the single-page newcomer
// guide at /guide/).
//
// Rendered by /src/pages/guide/index.astro (English), and its
// /de/ and /ja/ counterparts. All user-facing copy arrives via
// the `t` prop (a per-locale strings object from
// src/i18n/<lang>.json); this file owns only structure, assets,
// and behavior — never inline copy.
//
// Per-key English fallback: `s = { ...en, ...t }` means any key a
// locale hasn't translated yet renders its English source rather
// than a blank, so /de/guide/ is safe to ship before German is
// filled in — it turns German key-by-key as translations land.
//
// Release framing: KiwiDesk ships as a signed, notarized direct
// download — never the Mac App Store, which is out of scope (see
// the Distribution entry in docs/design-decisions.md). This page
// promotes ONLY that download (owner, 2026-08-26): the Homebrew
// block it used to carry taught Terminal to the one reader who
// never opens one, while the reader who wants the cask finds it
// on the landing's Nerd quickstart anyway. So the Terminal step
// lives on the technical surface again, not this one.
//
// Two client states share their localStorage keys with the
// landing + docs so a toggle anywhere carries across the site:
//   • theme — `starlight-theme`
//   • lang  — `kiwidesk-site-lang` ("en" | "de"), paired with the
//             route (/guide/ ↔ /de/guide/); resolved anti-FOUC in
//             <head>. Guide is never mode-gated, so no mode key.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ThemeHead from "./ThemeHead.astro";
import logoMark from "../assets/brand/logo.svg";
import kofiIcon from "../assets/brand/kofi_symbol.svg";
import kiwiCanopy from "../assets/brand/kiwi-canopy.png";
import ogBannerEn from "../assets/brand/og-banner.jpg";
import ogBannerDe from "../assets/brand/og-banner.de.jpg";
import ogBannerJa from "../assets/brand/og-banner.ja.jpg";
import { layoutDiagram } from "../lib/layoutDiagram";
import {
  downloadHref,
  downloadVersion,
  downloadIsPrerelease,
} from "../lib/download";
import en from "../i18n/en.json";
import "../styles/landing.css";
import "../styles/learn.css";

interface Props {
  t: Record<string, string>;
  lang: "en" | "de" | "ja";
}
const { t, lang } = Astro.props;

// One banner per locale — the card carries the tagline, so it has to speak
// the same language as the title and description beside it.
const ogImage = lang === "de" ? ogBannerDe : lang === "ja" ? ogBannerJa : ogBannerEn;

// Per-key English fallback: untranslated keys degrade to English.
const s = { ...en, ...t } as Record<string, string>;

// Home path for the active locale (landing), and the guide path
// pair the language switcher toggles between.
const homeHref =
  lang === "de" ? "/de/" : lang === "ja" ? "/ja/" : "/";

// Locale-aware quotation marks for the footer aside (German opens
// low „…“, English high “…”), mirroring Landing.astro.

const repo = "https://github.com/KiwiCanopy/KiwiDesk";
const kofi = "https://ko-fi.com/kiwicanopy";
const makerProfile = "https://github.com/hajiboy95";

// The download button's label is the artifact's NAME — the
// download icon carries the verb, so one shape serves every
// locale (owner, 2026-08-26: "KiwiDesk laden" read ambiguous in
// German, the full verb was a mouthful, and the icon already
// says download). Screen readers get the verb through the aria
// label, whose {v} slot lets each language place the version
// where its word order wants it. Null when no release is
// promoted — the plain `download_cta` verb button returns then,
// since a version-less "KiwiDesk" names nothing to fetch.
const downloadLabel = downloadVersion
  ? `KiwiDesk ${downloadVersion}` +
    (downloadIsPrerelease ? ` · ${s.beta_suffix}` : "")
  : null;
const downloadAria = downloadVersion
  ? s.download_versioned.replace("{v}", downloadVersion)
  : null;

// The table of contents — drives both the desktop rail and the
// mobile dropdown. Order matches the sections below. `id` is the
// anchor (never translated); `label` is localized copy.
const toc = [
  { id: "getting-started", label: s.guide_toc_getting_started },
  { id: "layouts", label: s.guide_toc_layouts },
  { id: "favorite", label: s.guide_toc_favorite },
  { id: "settings", label: s.guide_toc_settings },
  { id: "shortcuts", label: s.guide_toc_shortcuts },
  { id: "faq", label: s.guide_toc_faq },
  { id: "is-it-for-me", label: s.guide_toc_is_it_for_me },
];

// The seven layouts, each a friendly one-liner. Diagrams come from
// the shared helper so they match the landing exactly. `name` is
// the technical layout name (kept as-is); `desc` is localized.
const layouts = [
  { name: "stack", label: "Stack", desc: s.guide_layout_stack },
  { name: "bsp", label: "BSP", desc: s.guide_layout_bsp },
  { name: "scrolling", label: "Scrolling", desc: s.guide_layout_scrolling },
  { name: "monocle", label: "Monocle", desc: s.guide_layout_monocle },
  { name: "grid", label: "Grid", desc: s.guide_layout_grid },
  { name: "track", label: "Track", desc: s.guide_layout_track },
  { name: "floating", label: "Floating", desc: s.guide_layout_floating },
];

// The Settings window's sections, in the order the app's sidebar
// shows them (Design = per-profile, System = global).
//
// Not one card per destination. Two destinations fold into the
// card ahead of them, on the same reading each time: this is a
// walkthrough for someone deciding whether to install, so a card
// is a thing you would go and do, not a row in the sidebar.
//   • Advanced Colors folds into Colors & Animations. The app's own
//     promise there is that you never have to open it — it is the
//     deep twin of the page above it (see the Colors & Animations and
//     Advanced Colors sections of docs/user-guide.md) — so a card
//     of equal weight would advertise a second page of color work
//     to exactly the reader the redesign spared it from. The card
//     names it and says what it is for, which keeps the fold
//     truthful about what the sidebar actually shows.
//   • General folds into App Rules, as it always has.
// Everything else keeps its own card, including Gaps & Borders —
// it is a rename (from Appearance), so the new name has to be on
// the page or a reader scanning the sidebar for what they read
// here finds nothing.
const tour = [
  { title: s.guide_tour_spaces_title, body: s.guide_tour_spaces_body },
  { title: s.guide_tour_layout_title, body: s.guide_tour_layout_body },
  {
    title: s.guide_tour_monitors_title,
    body: s.guide_tour_monitors_body,
  },
  {
    title: s.guide_tour_gapsborders_title,
    body: s.guide_tour_gapsborders_body,
  },
  {
    title: s.guide_tour_bars_title,
    body: s.guide_tour_bars_body,
  },
  {
    title: s.guide_tour_colors_title,
    body: s.guide_tour_colors_body,
  },
  {
    title: s.guide_tour_behavior_title,
    body: s.guide_tour_behavior_body,
  },
  {
    title: s.guide_tour_profiles_title,
    body: s.guide_tour_profiles_body,
  },
  {
    title: s.guide_tour_shortcuts_title,
    body: s.guide_tour_shortcuts_body,
  },
  {
    title: s.guide_tour_apprules_title,
    body: s.guide_tour_apprules_body,
  },
];

// The "choosing your own shortcuts" section (#1097). Keys are
// `guide_keys_*` rather than `guide_shortcuts_*` because
// `guide_tour_shortcuts_*` above is already the Settings tour's
// card for the same destination — one prefix per meaning, so a
// translator never has to guess which of two near-identical key
// names a string belongs to.
//
// Both lists carry inline <strong> lead-ins, so they render with
// set:html below. Each entry is ONE sentence with its own opening
// clause emphasized — not a title/body pair like the tour cards —
// because the emphasis is a lead-in the sentence continues from,
// and splitting it would force a rewrite of every line.
const tryChord = [
  s.guide_keys_try_1,
  s.guide_keys_try_2,
  s.guide_keys_try_3,
];

// Three constraint lines, deliberately not the full set. The
// complete list with the reasoning behind each one lives in
// docs/user-guide.md under the shortcut table: a reader who wants
// to know WHY ⌃⌥ is quiet is already on the technical surface,
// and this page's job is the three that change what a normal
// reader binds.
const keyNotes = [
  s.guide_keys_note_1,
  s.guide_keys_note_2,
  s.guide_keys_note_3,
];

// FAQ pairs. Answers may carry inline HTML (a <code> chip), so
// they render with set:html below.
const faq = [
  { q: s.guide_faq_1_q, a: s.guide_faq_1_a },
  { q: s.guide_faq_2_q, a: s.guide_faq_2_a },
  { q: s.guide_faq_3_q, a: s.guide_faq_3_a },
  { q: s.guide_faq_4_q, a: s.guide_faq_4_a },
  { q: s.guide_faq_5_q, a: s.guide_faq_5_a },
];

// Section badges for the "is it for you" scenarios — Lucide icons
// (rendered via <Icon> below). Order runs broad-audience-first,
// self-selected nerds last.
const scenarios = [
  {
    icon: "lucide:layers-2",
    name: s.guide_scenario_everyday_name,
    before: s.guide_scenario_everyday_before,
    after: s.guide_scenario_everyday_after,
  },
  {
    icon: "lucide:video",
    name: s.guide_scenario_calls_name,
    before: s.guide_scenario_calls_before,
    after: s.guide_scenario_calls_after,
  },
  {
    icon: "lucide:file-spreadsheet",
    name: s.guide_scenario_consultant_name,
    before: s.guide_scenario_consultant_before,
    after: s.guide_scenario_consultant_after,
  },
  {
    icon: "lucide:pen-line",
    name: s.guide_scenario_writer_name,
    before: s.guide_scenario_writer_before,
    after: s.guide_scenario_writer_after,
  },
  {
    icon: "lucide:palette",
    name: s.guide_scenario_designer_name,
    before: s.guide_scenario_designer_before,
    after: s.guide_scenario_designer_after,
  },
  {
    icon: "lucide:code",
    name: s.guide_scenario_developer_name,
    before: s.guide_scenario_developer_before,
    after: s.guide_scenario_developer_after,
  },
];

// SEO/head: absolute URLs derived from Astro.site so they survive
// the pages.dev → custom-domain switch. `canonical` is this
// locale's own guide page; the hreflang pair links EN ↔ DE.
const guideHref =
  lang === "de"
    ? "/de/guide/"
    : lang === "ja"
      ? "/ja/guide/"
      : "/guide/";
const canonical = new URL(guideHref, Astro.site).href;
const enURL = new URL("/guide/", Astro.site).href;
const deURL = new URL("/de/guide/", Astro.site).href;
const jaURL = new URL("/ja/guide/", Astro.site).href;
const ogImageURL = new URL(ogImage.src, Astro.site).href;
const ogLocale =
  lang === "de" ? "de_DE" : lang === "ja" ? "ja_JP" : "en_US";
const ogLocaleAlt = lang === "en" ? "de_DE" : "en_US";

// Structured data: the site (WebSite) plus this guide as a
// TechArticle, emitted as one JSON-LD graph in the head. The
// landing page carries the SoftwareApplication node; the guide is
// an article about the product.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KiwiDesk",
    url: new URL("/", Astro.site).href,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: s.guide_meta_title,
    description: s.guide_meta_desc,
    url: canonical,
    image: ogImageURL,
    inLanguage: lang,
    author: {
      "@type": "Organization",
      name: "KiwiCanopy",
      url: makerProfile,
    },
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport"
      content="width=device-width, initial-scale=1" />
    <title>{s.guide_meta_title}</title>
    <meta name="description" content={s.guide_meta_desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={s.guide_meta_title} />
    <meta property="og:description" content={s.guide_meta_desc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="KiwiDesk" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={s.guide_meta_title} />
    <meta name="twitter:description" content={s.guide_meta_desc} />
    <meta name="twitter:image" content={ogImageURL} />
    <ThemeHead />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="de" href={deURL} />
    <link rel="alternate" hreflang="ja" href={jaURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
    ></script>
    {/* The theme resolve lives in <ThemeHead /> above. No mode key
         here — the Guide is never mode-gated. */}
    {/* Language resolve (anti-redirect-loop), scoped to the guide
         pair /guide/ ↔ /de/guide/. Runs before paint, at most once
         per load, and only ever redirects between those two known
         paths via replace() so the back button still works.
           1. A stored `kiwidesk-site-lang` wins — honor an earlier
              explicit choice by sending the visitor to its path.
           2. No stored pref: fall back to navigator.language, but
              ONLY nudge the English guide toward German (never the
              reverse), so /guide/ stays the canonical default. */}
    <script is:inline>
      (function () {
        var here = location.pathname;
        // Which locale this URL already is. Trailing slash optional
        // so /de/guide and /de/guide/ both count as "already there".
        function on(prefix) {
          return here === prefix + "/" || here === prefix;
        }
        var paths = {
          en: "/guide/",
          de: "/de/guide/",
          ja: "/ja/guide/",
        };
        var current = on("/de/guide")
          ? "de"
          : on("/ja/guide")
            ? "ja"
            : "en";
        function go(lang) {
          if (lang !== current) location.replace(paths[lang]);
        }
        var stored;
        try {
          stored = localStorage.getItem("kiwidesk-site-lang");
        } catch (e) {
          stored = null;
        }
        if (paths[stored]) return go(stored);
        // No stored pref: nudge by navigator.language, but only away
        // from the English guide, never between two non-English
        // ones — that keeps /guide/ the sole canonical default and
        // leaves no pair we could bounce between.
        if (current !== "en") return;
        var nav = (navigator.language || "").toLowerCase();
        if (nav.indexOf("de") === 0) return go("de");
        if (nav.indexOf("ja") === 0) return go("ja");
      })();
    </script>
    {/* Restore scroll after a language switch: the EN|DE switcher
         stashes scrollY before navigating, so switching languages
         lands you at the same spot instead of jumping to the top. */}
    <script is:inline>
      (function () {
        try {
          var y = sessionStorage.getItem("kiwidesk-scroll");
          if (y === null) return;
          sessionStorage.removeItem("kiwidesk-scroll");
          addEventListener("DOMContentLoaded", function () {
            window.scrollTo({
              top: parseInt(y, 10) || 0,
              behavior: "instant",
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {/* Skip link (WCAG 2.4.1): first focusable element, jumps past
         the nav to the guide content. Off-screen until focused. */}
    <a class="skip-link" href="#learnMain">{s.skip_to_content}</a>
    {/* ============ Site nav (no mode toggle, no tab bar) ====== */}
    <nav class="nav" id="nav">
      <div class="wrap nav__inner">
        <a class="nav__brand" href={homeHref}
          aria-label={s.nav_home_label}>
          <img class="nav__mark" src={logoMark.src}
            width="28" height="28" alt="" aria-hidden="true" />
          <span>KiwiDesk</span>
        </a>
        <div class="nav__links">
          <a class="learn-back" href={homeHref}>
            <Icon name="lucide:arrow-left" aria-hidden="true" />
            <span class="learn-back__text">{s.guide_back_home}</span>
          </a>

          {/* Language switcher: EN | DE | JA segmented control. Each
               segment links to that locale's guide route AND records
               the choice in `kiwidesk-site-lang` (wired below), so
               the preference persists across visits. */}
          <div class="lang-switch" role="group"
            aria-label={s.nav_lang_label}>
            <a class="lang-switch__opt" data-lang="en" href="/guide/"
              lang="en"
              aria-current={lang === "en" ? "true" : undefined}>EN</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="de"
              href="/de/guide/" lang="de"
              aria-current={lang === "de" ? "true" : undefined}>DE</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="ja"
              href="/ja/guide/" lang="ja"
              aria-current={lang === "ja" ? "true" : undefined}>JA</a>
          </div>

          <button class="theme-toggle" id="themeToggle" type="button"
            aria-label={s.nav_theme_label} aria-pressed="false">
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb">
                <Icon name="lucide:sun" class="theme-toggle__sun"
                  width={15} height={15} aria-hidden="true" />
                <Icon name="lucide:moon" class="theme-toggle__moon"
                  width={14} height={14} aria-hidden="true" />
              </span>
            </span>
          </button>

          {/* Ko-fi support button — last in the cluster, icon-only
               and compact (matches the landing nav). */}
          <a class="nav__support" href={kofi} target="_blank"
            rel="noopener" aria-label={s.nav_support_aria}>
            <img class="kofi-icon" src={kofiIcon.src} alt=""
              aria-hidden="true" width="20" height="16" />
          </a>
        </div>
      </div>
    </nav>

    {/* ============ Mobile TOC (sticky "On this page") ========= */}
    <details class="learn-toc learn-toc--mobile" id="tocMobile">
      <summary aria-label={s.guide_on_this_page}>
        <span class="wrap learn-toc__summary-inner">
          <Icon name="lucide:chevron-down" class="learn-toc__chevron"
            aria-hidden="true" />
          {s.guide_on_this_page}
          <span class="learn-toc__count"
            >{toc.length} {s.guide_toc_count_suffix}</span>
        </span>
      </summary>
      <div class="learn-toc__panel wrap">
        <ul class="learn-toc__list">
          {toc.map((item) => (
            <li>
              <a class="learn-toc__link" href={`#${item.id}`}
                data-toc={item.id}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    {/* ============ Page content ============ */}
    <main class="learn" id="learnMain" tabindex="-1">
      <div class="wrap">
        <div class="learn__layout">
          {/* Desktop sticky TOC rail */}
          <nav class="learn-toc learn-toc--desktop"
            aria-label={s.guide_on_this_page}>
            <p class="learn-toc__label">{s.guide_on_this_page}</p>
            <ul class="learn-toc__list">
              {toc.map((item) => (
                <li>
                  <a class="learn-toc__link" href={`#${item.id}`}
                    data-toc={item.id}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="learn__col">
            <header class="learn__head">
              <span class="learn__eyebrow">{s.guide_eyebrow}</span>
              <h1 class="learn__title">{s.guide_title}</h1>
              <p class="learn__lede">{s.guide_lede}</p>
              {/* No beta pill here on purpose. Status rides the
                   same pill component as the landing hero, but on
                   this page the header and the install card sit
                   within one viewport — two identical pills that
                   close together read as a stutter rather than as
                   ambient status, so the card (the decision point)
                   is the one that carries it. */}
            </header>

            {/* ===== 1. Getting started ===== */}
            <section class="learn-section" id="getting-started">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_gs_eyebrow}</span>
                <h2>{s.guide_gs_title}</h2>
              </div>
              <p>{s.guide_gs_p1}</p>

              {/* Install block. No App Store badge, and there
                   never will be one: the App Store is out of scope
                   outright, not pending (private SkyLight symbols
                   and the sandbox — see the Distribution entry in
                   docs/design-decisions.md). Even while it was
                   still framed as "later" a dimmed or ribboned
                   Apple badge was wrong here, because it still
                   reads "tap = the store opens" and so reads broken
                   rather than forthcoming — a different failure
                   from §2.7's grey-don't-hide, which covers a
                   control inert in the CURRENT mode, not a channel
                   that does not exist.
                   The command itself IS here, deliberately. It used
                   to be a bridge to the landing's Nerd-mode
                   quickstart, on the reading that a friendly
                   surface must never show shell text. That was
                   backwards: the copy promises "one line, ready to
                   copy" and then a cross-page jump into a mode
                   labelled Nerd withheld it — neither sparing the
                   reader the Terminal nor giving it to them. §2.7
                   keeps *configuration depth* optional (Lua,
                   profiles, overrides); it does not mean a first
                   run must never show one copy-paste line. So the
                   newcomer path no longer depends on the mode
                   system at all. */}
              <div class="learn-install">
                {/* The download is this page's ONE install path
                     (owner, 2026-08-26). The Homebrew block that
                     lived here taught Terminal to the one reader
                     who never opens one; the cask keeps its full
                     block on the landing's Nerd quickstart, which
                     is the surface a returning cask user reads.
                     The version pill is gone with it — the
                     version now rides INSIDE the button, so the
                     badge's two jobs (version, beta flag) have
                     one home and the card opens on the lead
                     sentence instead of a badge. */}
                {downloadHref && (
                  <>
                    <p class="learn-install__lead"
                      >{s.guide_gs_download_lead}</p>
                    <a class="btn btn--primary learn-install__download"
                      href={downloadHref} aria-label={downloadAria}
                      aria-describedby="guideReq">
                      <Icon name="lucide:download" width={16}
                        height={16} aria-hidden="true" />
                      {downloadLabel ?? s.download_cta}
                    </a>
                    {/* With brew gone, the notarization trust
                         fact must ride the download itself — the
                         landing's req line, shield and all,
                         replacing the italic store-note that sat
                         below the card. The id stays: this button
                         and the page-end one both name it via
                         aria-describedby. */}
                    <p class="req" id="guideReq">
                      <Icon name="lucide:shield" width={15}
                        height={15} aria-hidden="true" />
                      {s.download_req}
                    </p>
                  </>
                )}

                {/* A statement of fact, not a control: plain
                     text, never styled as something tappable. */}
                <p class="learn-install__later"
                  >{s.guide_gs_install_updates}</p>
                <p class="learn-install__later">{s.guide_gs_a11y}</p>
              </div>

              <p class="learn-sub">{s.guide_gs_perm_sub}</p>
              <p set:html={s.guide_gs_perm_p}></p>

              <div class="learn-callout learn-callout--trust">
                <span class="learn-callout__icon" aria-hidden="true">
                  <Icon name="lucide:shield-check" />
                </span>
                <div class="learn-callout__body">
                  <h3>{s.guide_gs_trust_title}</h3>
                  <p>{s.guide_gs_trust_p}</p>
                  <ul class="learn-checklist">
                    <li>
                      <span class="learn-checklist__check"
                        aria-hidden="true">
                        <Icon name="lucide:check" />
                      </span>
                      {s.guide_gs_trust_1}
                    </li>
                    <li>
                      <span class="learn-checklist__check"
                        aria-hidden="true">
                        <Icon name="lucide:check" />
                      </span>
                      {s.guide_gs_trust_2}
                    </li>
                  </ul>
                </div>
              </div>

              <p class="learn-sub">{s.guide_gs_first_sub}</p>
              <p>{s.guide_gs_first_p}</p>

              <div class="learn-snap" aria-hidden="true">
                <svg viewBox="0 0 320 150"
                  preserveAspectRatio="xMidYMid meet">
                  {/* Before: three windows piled up and overlapping */}
                  <rect x="12" y="26" width="78" height="58" rx="6"
                    class="tile" />
                  <rect x="30" y="44" width="78" height="58" rx="6"
                    class="tile" />
                  <rect x="48" y="62" width="78" height="58" rx="6"
                    class="tile tile--accent" />
                  <path d="M140 73h36m0 0-9-9m9 9-9 9" fill="none"
                    stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" stroke-linejoin="round"
                    style="color: var(--text-faint)" />
                  {/* After: the same windows, tidied edge to edge */}
                  <rect x="196" y="18" width="52" height="112" rx="6"
                    class="tile" />
                  <rect x="254" y="18" width="54" height="53" rx="6"
                    class="tile tile--accent" />
                  <rect x="254" y="77" width="54" height="53" rx="6"
                    class="tile" />
                </svg>
              </div>
            </section>

            {/* ===== 2. The layouts ===== */}
            <section class="learn-section" id="layouts">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_layouts_eyebrow}</span>
                <h2>{s.guide_layouts_title}</h2>
              </div>
              <p>{s.guide_layouts_p}</p>
              <div class="layouts">
                {layouts.map((l) => (
                  <article class="layout-card">
                    <div class="layout-card__diagram"
                      aria-hidden="true">
                      <Fragment set:html={layoutDiagram(l.name)} />
                    </div>
                    <h3>{l.label}</h3>
                    <p>{l.desc}</p>
                  </article>
                ))}
              </div>
            </section>

            {/* ===== 3. Finding your favorite ===== */}
            <section class="learn-section" id="favorite">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_fav_eyebrow}</span>
                <h2>{s.guide_fav_title}</h2>
              </div>
              <p set:html={s.guide_fav_p1}></p>
              <p set:html={s.guide_fav_p2}></p>
              <div class="learn-callout">
                <span class="learn-callout__icon" aria-hidden="true">
                  <Icon name="lucide:info" />
                </span>
                <div class="learn-callout__body">
                  <h3>{s.guide_fav_callout_title}</h3>
                  <p>{s.guide_fav_callout_p}</p>
                </div>
              </div>
            </section>

            {/* ===== 4. The Settings app ===== */}
            <section class="learn-section" id="settings">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_settings_eyebrow}</span>
                <h2>{s.guide_settings_title}</h2>
              </div>
              <p set:html={s.guide_settings_p}></p>
              <ul class="learn-tour">
                {tour.map((sec) => (
                  <li>
                    <h3>{sec.title}</h3>
                    <p>{sec.body}</p>
                  </li>
                ))}
              </ul>
            </section>

            {/* ===== 5. Choosing your own shortcuts ===== */}
            {/* A section, not a page (#1097). The Shortcuts tour
                 card sits in the Settings section right above, so
                 this reads as its depth tier rather than a
                 destination of its own — and a /guide/shortcuts/
                 route would be an orphan the footer nav never
                 carries, on a URL the app could pin (#1019) with
                 no guard behind it.

                 The register is `guide_fav_*`'s: warm, a method
                 for trying something safely, and a callout saying
                 nothing is permanent. Rebinding is not a power
                 user's indulgence to be graded — it is the point,
                 so the copy never asks the reader to justify it.

                 Step 3's "you can always reset to the defaults"
                 promises #1096, which is not merged. The line is
                 true the day #1096 ships; if this section has to
                 land first, `guide_keys_try_3` is the one string
                 to swap, for "a binding is one row — change it or
                 delete it in the same editor", which is true
                 today and carries the same safety claim. */}
            <section class="learn-section" id="shortcuts">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_keys_eyebrow}</span>
                <h2>{s.guide_keys_title}</h2>
              </div>
              <p>{s.guide_keys_p1}</p>
              <p>{s.guide_keys_p2}</p>

              <p class="learn-sub">{s.guide_keys_try_sub}</p>
              <ol class="learn-steps">
                {tryChord.map((step) => (
                  <li set:html={step}></li>
                ))}
              </ol>

              <div class="learn-callout">
                <span class="learn-callout__icon" aria-hidden="true">
                  <Icon name="lucide:info" />
                </span>
                <div class="learn-callout__body">
                  <h3>{s.guide_keys_callout_title}</h3>
                  <p>{s.guide_keys_callout_p}</p>
                </div>
              </div>

              {/* What the app warns about, stated at its real
                   scope. `SystemShortcuts.map` models macOS's own
                   shortcuts and nothing else, so silence from the
                   warner is not "no conflict" — it is "not one of
                   macOS's". Promising more would make step 2 look
                   optional, which is the one step that catches
                   another app's binding. */}
              <p>{s.guide_keys_warning}</p>
              <p set:html={s.guide_keys_search}></p>

              <p class="learn-sub">{s.guide_keys_notes_sub}</p>
              <ul class="learn-notes">
                {keyNotes.map((note) => (
                  <li set:html={note}></li>
                ))}
              </ul>

              <p>{s.guide_keys_bonus}</p>
            </section>

            {/* ===== 6. FAQ ===== */}
            <section class="learn-section" id="faq">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_faq_eyebrow}</span>
                <h2>{s.guide_faq_title}</h2>
              </div>
              <div class="learn-faq">
                {faq.map((f) => (
                  <details class="learn-faq__item">
                    <summary class="learn-faq__q">
                      {f.q}
                      <Icon name="lucide:plus" class="learn-faq__icon"
                        aria-hidden="true" />
                    </summary>
                    <div class="learn-faq__a">
                      <p set:html={f.a}></p>
                    </div>
                  </details>
                ))}
              </div>
            </section>

            {/* ===== 7. Is KiwiDesk for you? ===== */}
            <section class="learn-section" id="is-it-for-me">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_isit_eyebrow}</span>
                <h2>{s.guide_isit_title}</h2>
              </div>
              <p>{s.guide_isit_p}</p>
              <div class="learn-scenarios">
                {scenarios.map((sc) => (
                  <article class="learn-scenario">
                    <div class="learn-scenario__who">
                      <span class="learn-scenario__badge">
                        <Icon name={sc.icon} />
                      </span>
                      <p class="learn-scenario__name">{sc.name}</p>
                    </div>
                    <div class="learn-scenario__ba">
                      <div class="learn-scenario__side">
                        <span class="learn-scenario__label"
                          >{s.guide_before}</span>
                        <p>{sc.before}</p>
                      </div>
                      <div class="learn-scenario__side">
                        <span class="learn-scenario__label
                          learn-scenario__label--after"
                          >{s.guide_after}</span>
                        <p>{sc.after}</p>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <div class="learn-close">
                <h2>{s.guide_close_title}</h2>
                <p>{s.guide_close_p}</p>
                {/* A reader who has finished the guide should not
                     be sent back to the top to look for a button.
                     Where there is a download, this IS the button;
                     the requirement it carries is the one stated
                     once above, referenced rather than repeated.

                     Without one it falls back to the in-page jump
                     to the install block. That used to point at
                     `${homeHref}#getting-started` — an id the
                     landing has never had, so the jump died at the
                     top of the home page. */}
                {downloadHref ? (
                  <a class="btn btn--primary" href={downloadHref}
                    aria-label={downloadAria}
                    aria-describedby="guideReq">
                    <Icon name="lucide:download" width={16}
                      height={16} aria-hidden="true" />
                    {downloadLabel ?? s.download_cta}
                  </a>
                ) : (
                  <a class="btn btn--primary" href="#getting-started">
                    {s.guide_close_cta}
                    <Icon name="lucide:arrow-right" width={16} height={16}
                      aria-hidden="true" />
                  </a>
                )}
              </div>
            </section>
          </div>
        </div>
      </div>
    </main>

    {/* ============ Footer ============ */}
    <footer class="footer">
      <div class="wrap">
        <div class="footer__brand">
          <a class="footer__parent" href="https://kiwicanopy.com"
            target="_blank" rel="noopener">
            <Image class="footer__logo" src={kiwiCanopy}
              alt="" widths={[110, 160, 220]}
              sizes="110px" />
            <span class="footer__name">{s.footer_org}<span aria-hidden="true"> ↗</span></span>
          </a>
          <p class="footer__tag">{s.footer_tag}</p>
        </div>
        <a class="footer__kofi" href={kofi} target="_blank"
          rel="noopener">
          <img class="kofi-icon" src={kofiIcon.src} alt=""
            aria-hidden="true" width="20" height="16" />
          {s.footer_kofi}
        </a>
        <nav class="footer__links" aria-label={s.footer_nav_aria}>
          <a href={homeHref}>{s.guide_footer_home}</a>
          <a href="/docs/">{s.footer_docs}</a>
          <a href={`${homeHref}compare/`}
            >{s.nav_compare}</a>
          <a href={`${homeHref}changelog/`}
            >{s.footer_changelog}</a>
          <a href={repo} target="_blank" rel="noopener"
            >{s.footer_github}<span aria-hidden="true"> ↗</span></a>
          <a href={`${homeHref}imprint`}>{s.footer_impressum}</a>
          <a href={`${homeHref}privacy`}>{s.footer_privacy}</a>
        </nav>
        <p class="footer__copy">{s.footer_copy}</p>
        <p class="footer__credit">
          {s.footer_credit_built_by}{' '}
          <a href={makerProfile} target="_blank" rel="noopener">
            {s.footer_credit_name} · {s.footer_credit_handle}
          </a>
        </p>
        <p class="footer__daily">{s.daily_kiwi}</p>
      </div>
    </footer>

    <script>
      const html = document.documentElement;

      // ---- Theme toggle (shared `starlight-theme` key) ----
      const themeToggle = document.getElementById("themeToggle");
      const syncTheme = () => {
        const dark = html.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(dark));
      };
      syncTheme();
      themeToggle?.addEventListener("click", () => {
        const next =
          html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch (e) {
          /* storage unavailable — theme still applies in-page */
        }
        syncTheme();
      });
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          if (e.newValue === "light" || e.newValue === "dark") {
            html.dataset.theme = e.newValue;
            syncTheme();
          }
        }
      });

      // ---- Language switcher (own `kiwidesk-site-lang` key) ----
      // Each segment is an <a> that already navigates to the target
      // guide route; here we only persist the explicit choice so the
      // <head> resolver honors it on later visits.
      document
        .querySelectorAll(".lang-switch__opt")
        .forEach((opt) => {
          opt.addEventListener("click", () => {
            const lang = opt.getAttribute("data-lang");
            if (lang !== "en" && lang !== "de" && lang !== "ja")
              return;
            try {
              localStorage.setItem("kiwidesk-site-lang", lang);
              // Stash scroll so the destination locale restores it.
              sessionStorage.setItem(
                "kiwidesk-scroll",
                String(window.scrollY)
              );
            } catch (e) {
              /* storage unavailable — route change still works */
            }
          });
        });

      // ---- Nav background on scroll ----
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav?.classList.add("scrolled");
        else nav?.classList.remove("scrolled");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });


      // ---- Active-section highlight in the TOC ----
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-toc]")
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>(".learn-section[id]")
      );
      const setActive = (id: string) => {
        tocLinks.forEach((a) => {
          const on = a.getAttribute("data-toc") === id;
          if (on) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        });
      };

      if ("IntersectionObserver" in window && sections.length) {
        const visible = new Set<string>();
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const id = e.target.id;
              if (e.isIntersecting) visible.add(id);
              else visible.delete(id);
            });
            const current = sections.find((sec) =>
              visible.has(sec.id)
            );
            if (current) setActive(current.id);
          },
          { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
        );
        sections.forEach((sec) => io.observe(sec));
      }

      // ---- Close the mobile TOC after a jump ----
      const tocMobile = document.getElementById(
        "tocMobile"
      ) as HTMLDetailsElement | null;
      tocMobile
        ?.querySelectorAll(".learn-toc__link")
        .forEach((link) => {
          link.addEventListener("click", () => {
            tocMobile.open = false;
          });
        });

      // ---- Copy buttons on the install blocks ----
      // Same behavior as the landing's: swap the label to "Copied"
      // for a moment, then restore it. Bound per button so the
      // install command and the Homebrew installer each work.
      // A silent failure is fine — the command is visible and
      // selectable either way, so a blocked clipboard costs
      // nothing but the shortcut.
      document.querySelectorAll(".code__copy").forEach((copyBtn) => {
        const copyLabel = copyBtn.querySelector(".code__copy-label");
        copyBtn.addEventListener("click", async () => {
          const text = copyBtn.getAttribute("data-copy") || "";
          const idle = copyBtn.getAttribute("data-label-copy") || "";
          const done = copyBtn.getAttribute("data-label-done") || "";
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add("is-copied");
            if (copyLabel) copyLabel.textContent = done;
            setTimeout(() => {
              copyBtn.classList.remove("is-copied");
              if (copyLabel) copyLabel.textContent = idle;
            }, 1600);
          } catch (e) {
            /* clipboard blocked — no-op */
          }
        });
      });
    </script>
  </body>
</html>
