---
// KiwiDesk — shared Guide component (the single-page newcomer
// guide at /guide/).
//
// Rendered by /src/pages/guide/index.astro (English), and its
// /de/ and /ja/ counterparts. All user-facing copy arrives via
// the `t` prop (a per-locale strings object from
// src/i18n/<lang>.json); this file owns only structure, assets,
// and behavior — never inline copy.
//
// Per-key English fallback: `s = { ...en, ...t }` means any key a
// locale hasn't translated yet renders its English source rather
// than a blank, so /de/guide/ is safe to ship before German is
// filled in — it turns German key-by-key as translations land.
//
// Release framing: KiwiDesk ships as a Homebrew-only public beta,
// with a signed, notarized direct download following later — never
// the Mac App Store, which is out of scope (see the Distribution
// entry in docs/design-decisions.md). This page carries
// the beta status and a bridge to the landing's install section,
// but never the shell command itself — the Terminal step lives on
// the technical surface, not this one.
//
// Two client states share their localStorage keys with the
// landing + docs so a toggle anywhere carries across the site:
//   • theme — `starlight-theme`
//   • lang  — `kiwidesk-site-lang` ("en" | "de"), paired with the
//             route (/guide/ ↔ /de/guide/); resolved anti-FOUC in
//             <head>. Guide is never mode-gated, so no mode key.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ThemeHead from "./ThemeHead.astro";
import logoMark from "../assets/brand/logo.svg";
import kofiIcon from "../assets/brand/kofi_symbol.svg";
import kiwiCanopy from "../assets/brand/kiwi-canopy.png";
import ogImage from "../assets/brand/og-banner.jpg";
import { layoutDiagram } from "../lib/layoutDiagram";
import en from "../i18n/en.json";
import "../styles/landing.css";
import "../styles/learn.css";

interface Props {
  t: Record<string, string>;
  lang: "en" | "de" | "ja";
}
const { t, lang } = Astro.props;
// Per-key English fallback: untranslated keys degrade to English.
const s = { ...en, ...t } as Record<string, string>;

// Home path for the active locale (landing), and the guide path
// pair the language switcher toggles between.
const homeHref =
  lang === "de" ? "/de/" : lang === "ja" ? "/ja/" : "/";

// Locale-aware quotation marks for the footer aside (German opens
// low „…“, English high “…”), mirroring Landing.astro.
const oq = lang === "de" ? "„" : lang === "ja" ? "「" : "“";
const cq = lang === "de" ? "“" : lang === "ja" ? "」" : "”";

const repo = "https://github.com/KiwiCanopy/KiwiDesk";
const kofi = "https://ko-fi.com/kiwicanopy";
const makerProfile = "https://github.com/hajiboy95";

// The install command. Landing.astro holds its own copy for the
// Nerd quickstart — two surfaces, two literals. A fully-qualified
// tap token stays valid forever (including after any homebrew-cask
// acceptance), so a missed copy degrades to "one page shows the
// long form", never to a broken command.
const installCmd = "brew install --cask kiwicanopy/tap/kiwidesk";
// Homebrew's own installer, for the "don't have brew yet?" case.
const brewCmd =
  '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com' +
  '/Homebrew/install/HEAD/install.sh)"';

// The table of contents — drives both the desktop rail and the
// mobile dropdown. Order matches the sections below. `id` is the
// anchor (never translated); `label` is localized copy.
const toc = [
  { id: "getting-started", label: s.guide_toc_getting_started },
  { id: "layouts", label: s.guide_toc_layouts },
  { id: "favorite", label: s.guide_toc_favorite },
  { id: "settings", label: s.guide_toc_settings },
  { id: "faq", label: s.guide_toc_faq },
  { id: "is-it-for-me", label: s.guide_toc_is_it_for_me },
];

// The seven layouts, each a friendly one-liner. Diagrams come from
// the shared helper so they match the landing exactly. `name` is
// the technical layout name (kept as-is); `desc` is localized.
const layouts = [
  { name: "stack", label: "Stack", desc: s.guide_layout_stack },
  { name: "bsp", label: "BSP", desc: s.guide_layout_bsp },
  { name: "scrolling", label: "Scrolling", desc: s.guide_layout_scrolling },
  { name: "monocle", label: "Monocle", desc: s.guide_layout_monocle },
  { name: "grid", label: "Grid", desc: s.guide_layout_grid },
  { name: "track", label: "Track", desc: s.guide_layout_track },
  { name: "floating", label: "Floating", desc: s.guide_layout_floating },
];

// The Settings window's sections, grouped as the app shows them
// (Design = per-profile, System = global).
const tour = [
  { title: s.guide_tour_spaces_title, body: s.guide_tour_spaces_body },
  { title: s.guide_tour_layout_title, body: s.guide_tour_layout_body },
  {
    title: s.guide_tour_monitors_title,
    body: s.guide_tour_monitors_body,
  },
  {
    title: s.guide_tour_appearance_title,
    body: s.guide_tour_appearance_body,
  },
  {
    title: s.guide_tour_bars_title,
    body: s.guide_tour_bars_body,
  },
  {
    title: s.guide_tour_behavior_title,
    body: s.guide_tour_behavior_body,
  },
  {
    title: s.guide_tour_profiles_title,
    body: s.guide_tour_profiles_body,
  },
  {
    title: s.guide_tour_shortcuts_title,
    body: s.guide_tour_shortcuts_body,
  },
  {
    title: s.guide_tour_apprules_title,
    body: s.guide_tour_apprules_body,
  },
];

// FAQ pairs. Answers may carry inline HTML (a <code> chip), so
// they render with set:html below.
const faq = [
  { q: s.guide_faq_1_q, a: s.guide_faq_1_a },
  { q: s.guide_faq_2_q, a: s.guide_faq_2_a },
  { q: s.guide_faq_3_q, a: s.guide_faq_3_a },
  { q: s.guide_faq_4_q, a: s.guide_faq_4_a },
  { q: s.guide_faq_5_q, a: s.guide_faq_5_a },
];

// Section badges for the "is it for you" scenarios — Lucide icons
// (rendered via <Icon> below). Order runs broad-audience-first,
// self-selected nerds last.
const scenarios = [
  {
    icon: "lucide:layers-2",
    name: s.guide_scenario_everyday_name,
    before: s.guide_scenario_everyday_before,
    after: s.guide_scenario_everyday_after,
  },
  {
    icon: "lucide:video",
    name: s.guide_scenario_calls_name,
    before: s.guide_scenario_calls_before,
    after: s.guide_scenario_calls_after,
  },
  {
    icon: "lucide:file-spreadsheet",
    name: s.guide_scenario_consultant_name,
    before: s.guide_scenario_consultant_before,
    after: s.guide_scenario_consultant_after,
  },
  {
    icon: "lucide:pen-line",
    name: s.guide_scenario_writer_name,
    before: s.guide_scenario_writer_before,
    after: s.guide_scenario_writer_after,
  },
  {
    icon: "lucide:palette",
    name: s.guide_scenario_designer_name,
    before: s.guide_scenario_designer_before,
    after: s.guide_scenario_designer_after,
  },
  {
    icon: "lucide:code",
    name: s.guide_scenario_developer_name,
    before: s.guide_scenario_developer_before,
    after: s.guide_scenario_developer_after,
  },
];

// SEO/head: absolute URLs derived from Astro.site so they survive
// the pages.dev → custom-domain switch. `canonical` is this
// locale's own guide page; the hreflang pair links EN ↔ DE.
const guideHref =
  lang === "de"
    ? "/de/guide/"
    : lang === "ja"
      ? "/ja/guide/"
      : "/guide/";
const canonical = new URL(guideHref, Astro.site).href;
const enURL = new URL("/guide/", Astro.site).href;
const deURL = new URL("/de/guide/", Astro.site).href;
const jaURL = new URL("/ja/guide/", Astro.site).href;
const ogImageURL = new URL(ogImage.src, Astro.site).href;
const ogLocale =
  lang === "de" ? "de_DE" : lang === "ja" ? "ja_JP" : "en_US";
const ogLocaleAlt = lang === "en" ? "de_DE" : "en_US";

// Structured data: the site (WebSite) plus this guide as a
// TechArticle, emitted as one JSON-LD graph in the head. The
// landing page carries the SoftwareApplication node; the guide is
// an article about the product.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KiwiDesk",
    url: new URL("/", Astro.site).href,
    inLanguage: lang,
  },
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: s.guide_meta_title,
    description: s.guide_meta_desc,
    url: canonical,
    image: ogImageURL,
    inLanguage: lang,
    author: {
      "@type": "Organization",
      name: "KiwiCanopy",
      url: makerProfile,
    },
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport"
      content="width=device-width, initial-scale=1" />
    <title>{s.guide_meta_title}</title>
    <meta name="description" content={s.guide_meta_desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={s.guide_meta_title} />
    <meta property="og:description" content={s.guide_meta_desc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="KiwiDesk" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={s.guide_meta_title} />
    <meta name="twitter:description" content={s.guide_meta_desc} />
    <meta name="twitter:image" content={ogImageURL} />
    <ThemeHead />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="de" href={deURL} />
    <link rel="alternate" hreflang="ja" href={jaURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
    ></script>
    {/* The theme resolve lives in <ThemeHead /> above. No mode key
         here — the Guide is never mode-gated. */}
    {/* Language resolve (anti-redirect-loop), scoped to the guide
         pair /guide/ ↔ /de/guide/. Runs before paint, at most once
         per load, and only ever redirects between those two known
         paths via replace() so the back button still works.
           1. A stored `kiwidesk-site-lang` wins — honor an earlier
              explicit choice by sending the visitor to its path.
           2. No stored pref: fall back to navigator.language, but
              ONLY nudge the English guide toward German (never the
              reverse), so /guide/ stays the canonical default. */}
    <script is:inline>
      (function () {
        var here = location.pathname;
        // Which locale this URL already is. Trailing slash optional
        // so /de/guide and /de/guide/ both count as "already there".
        function on(prefix) {
          return here === prefix + "/" || here === prefix;
        }
        var paths = {
          en: "/guide/",
          de: "/de/guide/",
          ja: "/ja/guide/",
        };
        var current = on("/de/guide")
          ? "de"
          : on("/ja/guide")
            ? "ja"
            : "en";
        function go(lang) {
          if (lang !== current) location.replace(paths[lang]);
        }
        var stored;
        try {
          stored = localStorage.getItem("kiwidesk-site-lang");
        } catch (e) {
          stored = null;
        }
        if (paths[stored]) return go(stored);
        // No stored pref: nudge by navigator.language, but only away
        // from the English guide, never between two non-English
        // ones — that keeps /guide/ the sole canonical default and
        // leaves no pair we could bounce between.
        if (current !== "en") return;
        var nav = (navigator.language || "").toLowerCase();
        if (nav.indexOf("de") === 0) return go("de");
        if (nav.indexOf("ja") === 0) return go("ja");
      })();
    </script>
    {/* Restore scroll after a language switch: the EN|DE switcher
         stashes scrollY before navigating, so switching languages
         lands you at the same spot instead of jumping to the top. */}
    <script is:inline>
      (function () {
        try {
          var y = sessionStorage.getItem("kiwidesk-scroll");
          if (y === null) return;
          sessionStorage.removeItem("kiwidesk-scroll");
          addEventListener("DOMContentLoaded", function () {
            window.scrollTo({
              top: parseInt(y, 10) || 0,
              behavior: "instant",
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {/* Skip link (WCAG 2.4.1): first focusable element, jumps past
         the nav to the guide content. Off-screen until focused. */}
    <a class="skip-link" href="#learnMain">{s.skip_to_content}</a>
    {/* ============ Site nav (no mode toggle, no tab bar) ====== */}
    <nav class="nav" id="nav">
      <div class="wrap nav__inner">
        <a class="nav__brand" href={homeHref}
          aria-label={s.nav_home_label}>
          <img class="nav__mark" src={logoMark.src}
            width="28" height="28" alt="" aria-hidden="true" />
          <span>KiwiDesk</span>
        </a>
        <div class="nav__links">
          <a class="learn-back" href={homeHref}>
            <Icon name="lucide:arrow-left" aria-hidden="true" />
            <span class="learn-back__text">{s.guide_back_home}</span>
          </a>

          {/* Language switcher: EN | DE | JA segmented control. Each
               segment links to that locale's guide route AND records
               the choice in `kiwidesk-site-lang` (wired below), so
               the preference persists across visits. */}
          <div class="lang-switch" role="group"
            aria-label={s.nav_lang_label}>
            <a class="lang-switch__opt" data-lang="en" href="/guide/"
              lang="en"
              aria-current={lang === "en" ? "true" : undefined}>EN</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="de"
              href="/de/guide/" lang="de"
              aria-current={lang === "de" ? "true" : undefined}>DE</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="ja"
              href="/ja/guide/" lang="ja"
              aria-current={lang === "ja" ? "true" : undefined}>JA</a>
          </div>

          <button class="theme-toggle" id="themeToggle" type="button"
            aria-label={s.nav_theme_label} aria-pressed="false">
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb">
                <Icon name="lucide:sun" class="theme-toggle__sun"
                  width={15} height={15} aria-hidden="true" />
                <Icon name="lucide:moon" class="theme-toggle__moon"
                  width={14} height={14} aria-hidden="true" />
              </span>
            </span>
          </button>

          {/* Ko-fi support button — last in the cluster, icon-only
               and compact (matches the landing nav). */}
          <a class="nav__support" href={kofi} target="_blank"
            rel="noopener" aria-label={s.nav_support_aria}>
            <img class="kofi-icon" src={kofiIcon.src} alt=""
              aria-hidden="true" width="20" height="16" />
          </a>
        </div>
      </div>
    </nav>

    {/* ============ Mobile TOC (sticky "On this page") ========= */}
    <details class="learn-toc learn-toc--mobile" id="tocMobile">
      <summary aria-label={s.guide_on_this_page}>
        <span class="wrap learn-toc__summary-inner">
          <Icon name="lucide:chevron-down" class="learn-toc__chevron"
            aria-hidden="true" />
          {s.guide_on_this_page}
          <span class="learn-toc__count"
            >{toc.length} {s.guide_toc_count_suffix}</span>
        </span>
      </summary>
      <div class="learn-toc__panel wrap">
        <ul class="learn-toc__list">
          {toc.map((item) => (
            <li>
              <a class="learn-toc__link" href={`#${item.id}`}
                data-toc={item.id}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    {/* ============ Page content ============ */}
    <main class="learn" id="learnMain" tabindex="-1">
      <div class="wrap">
        <div class="learn__layout">
          {/* Desktop sticky TOC rail */}
          <nav class="learn-toc learn-toc--desktop"
            aria-label={s.guide_on_this_page}>
            <p class="learn-toc__label">{s.guide_on_this_page}</p>
            <ul class="learn-toc__list">
              {toc.map((item) => (
                <li>
                  <a class="learn-toc__link" href={`#${item.id}`}
                    data-toc={item.id}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="learn__col">
            <header class="learn__head">
              <span class="learn__eyebrow">{s.guide_eyebrow}</span>
              <h1 class="learn__title">{s.guide_title}</h1>
              <p class="learn__lede">{s.guide_lede}</p>
              {/* No beta pill here on purpose. Status rides the
                   same pill component as the landing hero, but on
                   this page the header and the install card sit
                   within one viewport — two identical pills that
                   close together read as a stutter rather than as
                   ambient status, so the card (the decision point)
                   is the one that carries it. */}
            </header>

            {/* ===== 1. Getting started ===== */}
            <section class="learn-section" id="getting-started">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_gs_eyebrow}</span>
                <h2>{s.guide_gs_title}</h2>
              </div>
              <p>{s.guide_gs_p1}</p>

              {/* Install block. No App Store badge, and there
                   never will be one: the App Store is out of scope
                   outright, not pending (private SkyLight symbols
                   and the sandbox — see the Distribution entry in
                   docs/design-decisions.md). Even while it was
                   still framed as "later" a dimmed or ribboned
                   Apple badge was wrong here, because it still
                   reads "tap = the store opens" and so reads broken
                   rather than forthcoming — a different failure
                   from §2.7's grey-don't-hide, which covers a
                   control inert in the CURRENT mode, not a channel
                   that does not exist.
                   The command itself IS here, deliberately. It used
                   to be a bridge to the landing's Nerd-mode
                   quickstart, on the reading that a friendly
                   surface must never show shell text. That was
                   backwards: the copy promises "one line, ready to
                   copy" and then a cross-page jump into a mode
                   labelled Nerd withheld it — neither sparing the
                   reader the Terminal nor giving it to them. §2.7
                   keeps *configuration depth* optional (Lua,
                   profiles, overrides); it does not mean a first
                   run must never show one copy-paste line. So the
                   newcomer path no longer depends on the mode
                   system at all. */}
              <div class="learn-install">
                <span class="pill">
                  <span class="pill__dot" aria-hidden="true"></span>
                  {s.beta_badge}
                </span>
                <p class="learn-install__lead"
                  >{s.guide_gs_install_lead}</p>

                <div class="code learn-install__code"
                  aria-label={s.guide_gs_install_code_aria}>
                  <div class="code__bar">
                    <span class="code__dot" aria-hidden="true"></span>
                    <span class="code__dot" aria-hidden="true"></span>
                    <span class="code__dot" aria-hidden="true"></span>
                    <span class="code__title"
                      >{s.guide_gs_install_bar}</span>
                    <button class="code__copy" type="button"
                      data-copy={installCmd}
                      data-label-copy={s.guide_gs_install_copy}
                      data-label-done={s.guide_gs_install_copied}
                      aria-label={s.guide_gs_install_copy_aria}>
                      <Icon name="lucide:copy" class="code__copy-icon"
                        width={15} height={15} aria-hidden="true" />
                      <span class="code__copy-label"
                        >{s.guide_gs_install_copy}</span>
                    </button>
                  </div>
                  <pre><code>{installCmd}</code></pre>
                </div>

                {/* Names the tap. A slash-qualified token does
                     not look like the plain one-word install most
                     people have seen, and the unspoken question is
                     whether the source is trustworthy. */}
                <p class="learn-install__source"
                  >{s.guide_gs_install_source}</p>

                <details class="learn-install__alt">
                  <summary>
                    <Icon name="lucide:chevron-right"
                      class="learn-install__alt-chevron" width={15}
                      height={15} aria-hidden="true" />
                    {s.guide_gs_brew_summary}
                  </summary>
                  <p>{s.guide_gs_brew_body}</p>
                  <div class="code learn-install__code"
                    aria-label={s.guide_gs_brew_code_aria}>
                    <div class="code__bar">
                      <span class="code__dot" aria-hidden="true"></span>
                      <span class="code__dot" aria-hidden="true"></span>
                      <span class="code__dot" aria-hidden="true"></span>
                      <span class="code__title"
                        >{s.guide_gs_install_bar}</span>
                      <button class="code__copy" type="button"
                        data-copy={brewCmd}
                        data-label-copy={s.guide_gs_install_copy}
                        data-label-done={s.guide_gs_install_copied}
                        aria-label={s.guide_gs_brew_copy_aria}>
                        <Icon name="lucide:copy"
                          class="code__copy-icon" width={15}
                          height={15} aria-hidden="true" />
                        <span class="code__copy-label"
                          >{s.guide_gs_install_copy}</span>
                      </button>
                    </div>
                    <pre><code>{brewCmd}</code></pre>
                  </div>
                </details>

                {/* A promise, not a control: plain text, never
                     styled as something tappable. */}
                <p class="learn-install__later"
                  >{s.guide_gs_install_later}</p>
              </div>

              <p class="learn__store-note">{s.guide_gs_store_note}</p>

              <p class="learn-sub">{s.guide_gs_perm_sub}</p>
              <p set:html={s.guide_gs_perm_p}></p>

              <div class="learn-callout learn-callout--trust">
                <span class="learn-callout__icon" aria-hidden="true">
                  <Icon name="lucide:shield-check" />
                </span>
                <div class="learn-callout__body">
                  <h3>{s.guide_gs_trust_title}</h3>
                  <p>{s.guide_gs_trust_p}</p>
                  <ul class="learn-checklist">
                    <li>
                      <span class="learn-checklist__check"
                        aria-hidden="true">
                        <Icon name="lucide:check" />
                      </span>
                      {s.guide_gs_trust_1}
                    </li>
                    <li>
                      <span class="learn-checklist__check"
                        aria-hidden="true">
                        <Icon name="lucide:check" />
                      </span>
                      {s.guide_gs_trust_2}
                    </li>
                  </ul>
                </div>
              </div>

              <p class="learn-sub">{s.guide_gs_first_sub}</p>
              <p>{s.guide_gs_first_p}</p>

              <div class="learn-snap" aria-hidden="true">
                <svg viewBox="0 0 320 150"
                  preserveAspectRatio="xMidYMid meet">
                  {/* Before: three windows piled up and overlapping */}
                  <rect x="12" y="26" width="78" height="58" rx="6"
                    class="tile" />
                  <rect x="30" y="44" width="78" height="58" rx="6"
                    class="tile" />
                  <rect x="48" y="62" width="78" height="58" rx="6"
                    class="tile tile--accent" />
                  <path d="M140 73h36m0 0-9-9m9 9-9 9" fill="none"
                    stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" stroke-linejoin="round"
                    style="color: var(--text-faint)" />
                  {/* After: the same windows, tidied edge to edge */}
                  <rect x="196" y="18" width="52" height="112" rx="6"
                    class="tile" />
                  <rect x="254" y="18" width="54" height="53" rx="6"
                    class="tile tile--accent" />
                  <rect x="254" y="77" width="54" height="53" rx="6"
                    class="tile" />
                </svg>
              </div>
            </section>

            {/* ===== 2. The layouts ===== */}
            <section class="learn-section" id="layouts">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >{s.guide_layouts_eyebrow}</span>
