---
// Docs (Starlight) Head override: Starlight's own head, plus the
// share image it never sets, though it declares a large Twitter
// card. Docs are English-only, so they wear the English banner.
import Default from "@astrojs/starlight/components/Head.astro";
import { ogCard } from "../lib/ogCard";

const og = ogCard("banner", "en", Astro.site);
---

<Default {...Astro.props}><slot /></Default>
<meta property="og:image" content={og.url} />
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={og.alt} />
<meta name="twitter:image" content={og.url} />
<meta name="twitter:image:alt" content={og.alt} />
