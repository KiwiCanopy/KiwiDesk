---
// KiwiDesk — the curated release notes page (#873).
//
// Rendered by /src/pages/changelog/index.astro (English) and its
// /de/ and /ja/ counterparts. Structurally a sibling of
// Legal.astro: a small standalone document reusing the landing's
// design tokens (landing.css) via PageShell.astro rather than
// Starlight's chrome or the landing monolith.
//
// TWO CORPORA MEET HERE, and keeping them apart is the whole
// design. The page FRAME — nav, headings, labels, the link out —
// is localized like every other marketing page. The release
// ENTRIES are English in all three locales: release notes are an
// unbounded per-release stream, while this repo's translation
// model is a fixed key catalog, and the two cannot meet. /docs/*
// is already English to every visitor for the same reason.
//
// ONE REGISTER, shown to everyone (owner, 2026-08-19). An earlier
// draft of #873 gated a commit-level list behind the landing's
// Simple/Nerd toggle; the changelog is for everyone, and the
// generated list is one link away on the release itself rather
// than mirrored here — it is reviewer language, which
// docs/design-decisions.md ▸ "Release notes are written for the
// person installing" is the argument against putting in front of
// a visitor.
//
// The entries come from src/data/changelog.json, which is
// GENERATED by scripts/changelog-sync from the published release
// bodies. Never hand-edit it — a release publish overwrites it.
import { Icon } from "astro-icon/components";
import { marked } from "marked";
import PageShell, { type Lang } from "./PageShell.astro";
import en from "../i18n/en.json";
import de from "../i18n/de.json";
import ja from "../i18n/ja.json";
import changelog from "../data/changelog.json";
import { downloadHref } from "../lib/download";
import ogBannerEn from "../assets/brand/og-banner.jpg";
import ogBannerDe from "../assets/brand/og-banner.de.jpg";
import ogBannerJa from "../assets/brand/og-banner.ja.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// English lives at /, German at /de, Japanese at /ja.
function localePath(l: Lang, sub = ""): string {
  const prefix = l === "en" ? "" : `/${l}`;
  return `${prefix}${sub}` || "/";
}

// Per-key English fallback, exactly as Landing/Guide/Legal do it:
// a key a locale has not translated renders its English source
// rather than a blank.
const dict = { ...en, ...{ en, de, ja }[lang] } as Record<
  string,
  string
>;
const t = (k: string): string =>
  dict[k] ?? (en as Record<string, string>)[k] ?? k;

interface Section {
  title: string;
  items: string[];
}
interface Release {
  version: string;
  tag: string;
  date: string;
  prerelease: boolean;
  url: string;
  download?: string;
  summary?: string;
  sections?: Section[];
}

const releases = (changelog.releases as Release[]).filter(
  (release) =>
    Boolean(release.summary) || Boolean(release.sections?.length),
);

// Items carry inline markdown (`**bold**`, `code`) because a
// release body is markdown. `parseInline` renders exactly that
// and no block structure — the sections ARE the block structure,
// and they arrive parsed. Build-time only: no client JS, and the
// source is our own release bodies rather than visitor input.
const inline = (md: string): string => marked.parseInline(md) as string;

// The date a visitor reads, in their own locale. The ISO string in
// the data file stays the machine-readable half on <time>.
const dateFormat = new Intl.DateTimeFormat(
  { en: "en-US", de: "de-DE", ja: "ja-JP" }[lang],
  { year: "numeric", month: "long", day: "numeric" },
);
const readable = (iso: string): string =>
  iso ? dateFormat.format(new Date(`${iso}T00:00:00Z`)) : "";

const slug = "/changelog/";
const pageTitle = t("changelog_meta_title");
const pageDesc = t("changelog_meta_desc");
// One banner per locale — the card carries the tagline, so it
// speaks the language of the title beside it (as Guide does).
const ogBanner =
  lang === "de" ? ogBannerDe : lang === "ja" ? ogBannerJa : ogBannerEn;
const ogImage = new URL(ogBanner.src, Astro.site).href;
---

<PageShell
  lang={lang}
  slug={slug}
  title={pageTitle}
  desc={pageDesc}
  ogImage={ogImage}
  mainClass="clog"
>
  <a class="back" href={localePath(lang)}>
    ← {t("guide_back_home")}
  </a>
  <h1>{t("changelog_title")}</h1>
  <p class="intro">{t("changelog_intro")}</p>

  {
    releases.length === 0 && (
      <p class="empty">{t("changelog_empty")}</p>
    )
  }

  {/* The frame is localized and the ENTRIES are English in
      every locale (see the header). Each entry says so, or a
      screen reader pronounces English prose with the page's
      declared voice. */}
  {
    releases.map((release, index) => (
      <section class="rel" aria-labelledby={`v-${release.tag}`}
        lang={lang === "en" ? undefined : "en"}>
        <header class="rel__head">
          {/* The id already labels the section; making the
              version itself the anchor is what turns it
              into a per-release permalink to share. */}
          <h2 id={`v-${release.tag}`}>
            <a class="rel__anchor" href={`#v-${release.tag}`}>
              {release.version}
            </a>
          </h2>
          <time datetime={release.date}>
            {readable(release.date)}
          </time>
          {index === 0 && (
            <span class="tag tag--latest">
              {t("changelog_latest")}
            </span>
          )}
          {release.prerelease && (
            <span class="tag">{t("changelog_beta")}</span>
          )}
        </header>

        {release.summary && (
          <p class="rel__summary">{release.summary}</p>
        )}

        {/* Only the CURRENT release is offered. This page lists
             what changed and, until #904, was the one surface
             that could name a version without offering any way
             to get it — but that gap is closed by one link, not
             by one per entry. An older build is not something to
             hand a stranger: they would install a version behind
             the one everything else on the site promotes, and a
             list of identical download links reads as an archive
             rather than as a changelog.

             The test is identity with `downloadHref`, the same
             selection the rest of the site uses, so this page can
             never offer a different build from the landing page
             — and an entry whose release shipped no disk image
             simply has none. */}
        {release.download && release.download === downloadHref && (
          <a class="rel__download" href={release.download}>
            <Icon name="lucide:download" width={15} height={15}
              aria-hidden="true" />
            {t("download_cta")}
          </a>
        )}

        {(release.sections ?? []).map((section) => (
          <div class="grp">
            <h3>{section.title}</h3>
            <ul>
              {section.items.map((item) => (
                <li set:html={inline(item)} />
              ))}
            </ul>
          </div>
        ))}

        {!release.summary &&
          !(release.sections ?? []).length && (
            <p class="rel__none">{t("changelog_no_notes")}</p>
          )}

        <a class="rel__out" href={release.url} target="_blank"
          rel="noopener">
          {t("changelog_full_list")} ↗
        </a>
      </section>
    ))
  }

  <div class="clog__older">
    <p>
      {t("changelog_older_label")}{" "}
      <a class="rel__out"
        href="https://github.com/KiwiCanopy/KiwiDesk/releases"
        target="_blank" rel="noopener">
        {t("changelog_older_link")} ↗
      </a>
    </p>
  </div>
</PageShell>

<style>
  /* `:global` is required, not stylistic. `<main class="clog">`
     is rendered by PageShell, so it carries PageShell's scope id
     and never this component's — a plain `.clog` rule here
     compiles to `.clog.astro-<this component>` and matches
     nothing. The page then had no max-width and no horizontal
     padding at all, while every other rule in this block worked,
     because their elements ARE in this template. That is what
     made it read as "missing padding" rather than "missing
     container". Any rule here targeting an element PageShell
     owns needs the same treatment. */
  :global(main.clog) {
    /* Above landing.css's fixed `body::before`
       wash, which `.rel` clears only by inheriting
       the global `section` rule. */
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem)
      5rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.6rem;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .back:hover {
    color: var(--text);
  }
  :global(main.clog) h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.15;
  }
  .intro {
    margin: 0 0 2.6rem;
    color: var(--text-dim);
    font-size: 1.02rem;
  }
  .empty {
    color: var(--text-dim);
  }

  /* `section` in landing.css carries
     `padding-block: clamp(3.5rem, 9vw, 7rem)`, which a release
     entry must not inherit — overriding only `padding-top`
     leaves an 81px bottom against a 35px top. Legal.astro
     resets the same trap. Spacing here comes from the rule
     plus the margin. */
  .rel {
    padding-block: 0;
    padding-top: 2.2rem;
    border-top: 1px solid var(--border);
    margin-bottom: 2.2rem;
  }
  .rel__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 0.8rem;
    margin-bottom: 0.9rem;
  }
  .rel__head h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .rel__anchor {
    color: inherit;
    text-decoration: none;
  }
  .rel__anchor:hover {
    text-decoration: underline;
  }
  .rel__head time {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  /* A status chip, not the footer's tagline paragraph — hence
     the footer's own class is `tag-line` on this page. */
  .rel .tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-dim);
  }
  .rel .tag--latest {
    border-color: transparent;
    background: var(--accent);
    color: var(--bg-1);
  }

  .rel__summary {
    margin: 0 0 1.6rem;
    font-size: 1.06rem;
    color: var(--text);
  }
  .rel__none {
    margin: 0 0 1.2rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .grp {
    margin-bottom: 1.5rem;
  }
  .grp h3 {
    margin: 0 0 0.55rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .grp ul {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.55rem;
  }
  .grp li {
    line-height: 1.6;
  }
  .grp li :global(strong) {
    color: var(--text);
  }
  .grp li :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--bg-2);
  }

  .rel__out {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .rel__out:hover {
    color: var(--text);
  }

  .clog__older {
    padding-top: 2.2rem;
    border-top: 1px solid var(--border);
    margin-top: 1rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .clog__older p {
    margin: 0;
  }
</style>
