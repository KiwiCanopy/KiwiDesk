---
// KiwiDesk — the curated release notes page (#873).
//
// Rendered by /src/pages/changelog/index.astro (English) and its
// /de/ and /ja/ counterparts. Structurally a sibling of
// Legal.astro: a small standalone document reusing the landing's
// design tokens (landing.css) rather than Starlight's chrome or
// the landing monolith.
//
// TWO CORPORA MEET HERE, and keeping them apart is the whole
// design. The page FRAME — nav, headings, labels, the link out —
// is localized like every other marketing page. The release
// ENTRIES are English in all three locales: release notes are an
// unbounded per-release stream, while this repo's translation
// model is a fixed key catalog, and the two cannot meet. /docs/*
// is already English to every visitor for the same reason.
//
// ONE REGISTER, shown to everyone (owner, 2026-08-19). An earlier
// draft of #873 gated a commit-level list behind the landing's
// Simple/Nerd toggle; the changelog is for everyone, and the
// generated list is one link away on the release itself rather
// than mirrored here — it is reviewer language, which
// docs/design-decisions.md ▸ "Release notes are written for the
// person installing" is the argument against putting in front of
// a visitor.
//
// The entries come from src/data/changelog.json, which is
// GENERATED by scripts/changelog-sync from the published release
// bodies. Never hand-edit it — a release publish overwrites it.
import { marked } from "marked";
import "../styles/landing.css";
import ThemeHead from "./ThemeHead.astro";
import logoMark from "../assets/brand/logo.svg";
import en from "../i18n/en.json";
import de from "../i18n/de.json";
import ja from "../i18n/ja.json";
import changelog from "../data/changelog.json";
import ogBannerEn from "../assets/brand/og-banner.jpg";
import ogBannerDe from "../assets/brand/og-banner.de.jpg";
import ogBannerJa from "../assets/brand/og-banner.ja.jpg";

type Lang = "en" | "de" | "ja";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const LANGS: Record<Lang, string> = {
  en: "English",
  de: "Deutsch",
  ja: "日本語",
};

// English lives at /, German at /de, Japanese at /ja.
function localePath(l: Lang, sub = ""): string {
  const prefix = l === "en" ? "" : `/${l}`;
  return `${prefix}${sub}` || "/";
}

// Per-key English fallback, exactly as Landing/Guide/Legal do it:
// a key a locale has not translated renders its English source
// rather than a blank.
const dict = { ...en, ...{ en, de, ja }[lang] } as Record<
  string,
  string
>;
const t = (k: string): string =>
  dict[k] ?? (en as Record<string, string>)[k] ?? k;

interface Section {
  title: string;
  items: string[];
}
interface Release {
  version: string;
  tag: string;
  date: string;
  prerelease: boolean;
  url: string;
  summary?: string;
  sections?: Section[];
}

const releases = changelog.releases as Release[];

// Items carry inline markdown (`**bold**`, `code`) because a
// release body is markdown. `parseInline` renders exactly that
// and no block structure — the sections ARE the block structure,
// and they arrive parsed. Build-time only: no client JS, and the
// source is our own release bodies rather than visitor input.
const inline = (md: string): string => marked.parseInline(md) as string;

// The date a visitor reads, in their own locale. The ISO string in
// the data file stays the machine-readable half on <time>.
const dateFormat = new Intl.DateTimeFormat(
  { en: "en-US", de: "de-DE", ja: "ja-JP" }[lang],
  { year: "numeric", month: "long", day: "numeric" },
);
const readable = (iso: string): string =>
  iso ? dateFormat.format(new Date(`${iso}T00:00:00Z`)) : "";

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const slug = "/changelog";
const canonical = `${site}${localePath(lang, `${slug}/`)}`;
const pageTitle = t("changelog_meta_title");
const pageDesc = t("changelog_meta_desc");
const ogLocale = { en: "en_US", de: "de_DE", ja: "ja_JP" }[lang];
const repo = "https://github.com/KiwiCanopy/KiwiDesk";
const kofi = "https://ko-fi.com/kiwicanopy";
// One banner per locale — the card carries the tagline, so it
// speaks the language of the title beside it (as Guide does).
const ogBanner =
  lang === "de" ? ogBannerDe : lang === "ja" ? ogBannerJa : ogBannerEn;
const ogImage = new URL(ogBanner.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="KiwiDesk" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <ThemeHead />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      hreflang="en"
      href={`${site}${localePath("en", `${slug}/`)}`}
    />
    <link
      rel="alternate"
      hreflang="de"
      href={`${site}${localePath("de", `${slug}/`)}`}
    />
    <link
      rel="alternate"
      hreflang="ja"
      href={`${site}${localePath("ja", `${slug}/`)}`}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${site}${localePath("en", `${slug}/`)}`}
    />

    {/* Language resolve, copied in shape from Legal.astro: it
        PRESERVES the sub-path, so a stored language never bounces
        this page to the home page. */}
    <script is:inline>
      (function () {
        var p = location.pathname;
        var m = p.match(/^\/(de|ja)(?=\/|$)/);
        var cur = m ? m[1] : "en";
        var rest = (m ? p.slice(m[0].length) : p) || "/";
        function go(to) {
          if (to === cur) return;
          location.replace(
            (to === "en" ? "" : "/" + to) + rest + location.hash,
          );
        }
        var stored;
        try {
          stored = localStorage.getItem("kiwidesk-site-lang");
        } catch (e) {
          stored = null;
        }
        if (stored === "en" || stored === "de" || stored === "ja")
          return go(stored);
        if (cur !== "en") return;
        var nav = (navigator.language || "").toLowerCase();
        if (nav.indexOf("de") === 0) return go("de");
        if (nav.indexOf("ja") === 0) return go("ja");
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t("skip_to_content")}</a>

    <header class="lnav">
      <a
        class="brand"
        href={localePath(lang)}
        aria-label={t("nav_home_label")}
      >
        <img src={logoMark.src} alt="" width="34" height="34" />
        <span>KiwiDesk</span>
      </a>
      <nav class="right">
        <span class="langs">
          {
            (Object.entries(LANGS) as [Lang, string][]).map(
              ([code, label]) => (
                <a
                  href={localePath(code, `${slug}/`)}
                  data-lang={code}
                  title={label}
                  aria-current={code === lang ? "page" : undefined}
                >
                  {code.toUpperCase()}
                </a>
              ),
            )
          }
        </span>
        <button
          id="themeToggle"
          class="theme-toggle"
          type="button"
          aria-label={t("nav_theme_label")}
        >
          <span class="theme-toggle__track" aria-hidden="true">
            <span class="theme-toggle__thumb">
              <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </span>
          </span>
        </button>
      </nav>
    </header>

    <main id="main-content" class="clog">
      <a class="back" href={localePath(lang)}>
        ← {t("guide_back_home")}
      </a>
      <h1>{t("changelog_title")}</h1>
      <p class="intro">{t("changelog_intro")}</p>

      {
        releases.length === 0 && (
          <p class="empty">{t("changelog_empty")}</p>
        )
      }

      {/* The frame is localized and the ENTRIES are English in
          every locale (see the header). Each entry says so, or a
          screen reader pronounces English prose with the page's
          declared voice. */}
      {
        releases.map((release, index) => (
          <section class="rel" aria-labelledby={`v-${release.tag}`}
            lang={lang === "en" ? undefined : "en"}>
            <header class="rel__head">
              {/* The id already labels the section; making the
                  version itself the anchor is what turns it
                  into a per-release permalink to share. */}
              <h2 id={`v-${release.tag}`}>
                <a class="rel__anchor" href={`#v-${release.tag}`}>
                  {release.version}
                </a>
              </h2>
              <time datetime={release.date}>
                {readable(release.date)}
              </time>
              {index === 0 && (
                <span class="tag tag--latest">
                  {t("changelog_latest")}
                </span>
              )}
              {release.prerelease && (
                <span class="tag">{t("changelog_beta")}</span>
              )}
            </header>

            {release.summary && (
              <p class="rel__summary">{release.summary}</p>
            )}

            {(release.sections ?? []).map((section) => (
              <div class="grp">
                <h3>{section.title}</h3>
                <ul>
                  {section.items.map((item) => (
                    <li set:html={inline(item)} />
                  ))}
                </ul>
              </div>
            ))}

            {!release.summary &&
              !(release.sections ?? []).length && (
                <p class="rel__none">{t("changelog_no_notes")}</p>
              )}

            <a class="rel__out" href={release.url} target="_blank"
              rel="noopener">
              {t("changelog_full_list")} ↗
            </a>
          </section>
        ))
      }
    </main>

    <footer class="lfoot">
      <p class="tag-line">{t("footer_tag")}</p>
      <nav class="flinks" aria-label={t("footer_nav_aria")}>
        <a href="/docs/">{t("footer_docs")}</a>
        <a href={localePath(lang, "/changelog/")}
          >{t("footer_changelog")}</a>
        <a href={localePath(lang, "/imprint")}>{t("footer_impressum")}</a>
        <a href={localePath(lang, "/privacy")}>{t("footer_privacy")}</a>
        <a href={repo} target="_blank" rel="noopener">{t("footer_github")}</a>
        <a href={kofi} target="_blank" rel="noopener">{t("footer_kofi")}</a>
      </nav>
      <p class="copy">{t("footer_copy")}</p>
    </footer>

    <style>
      .skip-link {
        position: absolute;
        left: 0.5rem;
        top: -3rem;
        z-index: 10;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        background: var(--accent);
        color: var(--bg-1);
        font-weight: 700;
        transition: top 140ms ease;
      }
      .skip-link:focus {
        top: 0.5rem;
      }

      .lnav {
        /* Above landing.css's fixed `body::before`
           wash, which `.rel` clears only by inheriting
           the global `section` rule. */
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem clamp(1rem, 4vw, 2.5rem);
        border-bottom: 1px solid var(--border);
      }
      .lnav .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
      }
      .lnav .right {
        display: inline-flex;
        align-items: center;
        gap: 0.9rem;
      }
      .langs {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.82rem;
        font-weight: 600;
      }
      .langs a {
        color: var(--text-dim);
        text-decoration: none;
        padding: 0.15rem 0.3rem;
        border-radius: 6px;
      }
      .langs a[aria-current="page"] {
        color: var(--text);
        background: var(--bg-2);
      }

      .clog {
        /* Above landing.css's fixed `body::before`
           wash, which `.rel` clears only by inheriting
           the global `section` rule. */
        position: relative;
        z-index: 1;
        max-width: 46rem;
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem)
          5rem;
      }
      .back {
        display: inline-block;
        margin-bottom: 1.6rem;
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.92rem;
      }
      .back:hover {
        color: var(--text);
      }
      .clog h1 {
        margin: 0 0 0.4rem;
        font-size: clamp(1.9rem, 5vw, 2.6rem);
        line-height: 1.15;
      }
      .intro {
        margin: 0 0 2.6rem;
        color: var(--text-dim);
        font-size: 1.02rem;
      }
      .empty {
        color: var(--text-dim);
      }

      /* `section` in landing.css carries
         `padding-block: clamp(3.5rem, 9vw, 7rem)`, which a release
         entry must not inherit — overriding only `padding-top`
         leaves an 81px bottom against a 35px top. Legal.astro
         resets the same trap. Spacing here comes from the rule
         plus the margin. */
      .rel {
        padding-block: 0;
        padding-top: 2.2rem;
        border-top: 1px solid var(--border);
        margin-bottom: 2.2rem;
      }
      .rel__head {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.6rem 0.8rem;
        margin-bottom: 0.9rem;
      }
      .rel__head h2 {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.1;
      }
      .rel__anchor {
        color: inherit;
        text-decoration: none;
      }
      .rel__anchor:hover {
        text-decoration: underline;
      }
      .rel__head time {
        color: var(--text-dim);
        font-size: 0.9rem;
      }
      /* A status chip, not the footer's tagline paragraph — hence
         the footer's own class is `tag-line` on this page. */
      .rel .tag {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.16rem 0.5rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        color: var(--text-dim);
      }
      .rel .tag--latest {
        border-color: transparent;
        background: var(--accent);
        color: var(--bg-1);
      }

      .rel__summary {
        margin: 0 0 1.6rem;
        font-size: 1.06rem;
        color: var(--text);
      }
      .rel__none {
        margin: 0 0 1.2rem;
        color: var(--text-dim);
        font-size: 0.95rem;
      }

      .grp {
        margin-bottom: 1.5rem;
      }
      .grp h3 {
        margin: 0 0 0.55rem;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-dim);
      }
      .grp ul {
        margin: 0;
        padding-left: 1.15rem;
        display: grid;
        gap: 0.55rem;
      }
      .grp li {
        line-height: 1.6;
      }
      .grp li :global(strong) {
        color: var(--text);
      }
      .grp li :global(code) {
        font-family: var(--mono);
        font-size: 0.9em;
        padding: 0.1em 0.35em;
        border-radius: 5px;
        background: var(--bg-2);
      }

      .rel__out {
        display: inline-block;
        font-size: 0.9rem;
        color: var(--text-dim);
        text-decoration: none;
        border-bottom: 1px solid var(--border);
      }
      .rel__out:hover {
        color: var(--text);
      }

      .lfoot {
        /* Above landing.css's fixed `body::before`
           wash, which `.rel` clears only by inheriting
           the global `section` rule. */
        position: relative;
        z-index: 1;
        border-top: 1px solid var(--border);
        padding: 2rem clamp(1rem, 4vw, 2.5rem) 3rem;
        text-align: center;
        color: var(--text-dim);
        font-size: 0.9rem;
      }
      .flinks {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.1rem;
        margin: 0.8rem 0;
      }
      .flinks a {
        color: var(--text-dim);
        text-decoration: none;
      }
      .flinks a:hover {
        color: var(--text);
      }
      .tag-line {
        font-weight: 600;
        color: var(--text);
      }
      .copy {
        margin: 0;
      }
    </style>

    {/* The theme toggle's behavior, shared with every other page
        through the `starlight-theme` key ThemeHead resolves
        anti-FOUC. */}
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var btn = document.getElementById("themeToggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var next = html.dataset.theme === "dark" ? "light" : "dark";
          html.dataset.theme = next;
          try {
            localStorage.setItem("starlight-theme", next);
          } catch (e) {
            /* storage unavailable — the theme still applies */
          }
        });
        var langs = document.querySelectorAll(".langs a[data-lang]");
        Array.prototype.forEach.call(langs, function (a) {
          a.addEventListener("click", function () {
            try {
              localStorage.setItem(
                "kiwidesk-site-lang",
                a.getAttribute("data-lang"),
              );
            } catch (e) {
              /* storage unavailable — the link still navigates */
            }
          });
        });
      })();
    </script>
  </body>
</html>
