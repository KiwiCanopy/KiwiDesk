---
// KiwiDesk — shared scaffold for the newcomer /learn/* pages.
//
// A reusable layout wrapping every Learn page in the same site
// chrome as the marketing landing (Landing.astro): the theme-
// swapped brand mark, the light/dark theme toggle (sharing the
// `starlight-theme` localStorage key + anti-FOUC head script so
// the whole site stays in sync), and the EN|DE language switcher.
// Unlike the landing, Learn pages carry NO Simple/Developer mode
// toggle — they are always the friendly, non-technical view.
//
// It also owns the Learn sub-nav (the tab row), so every Learn
// page only supplies its own <slot> content plus a few props.
//
// English only for now (issue #9 defers German for /learn/). The
// language switcher's DE segment points at the landing's German
// home; when German Learn pages ship, wire it to a per-locale
// route the way index.astro / de/index.astro pair the landing.
import { Image } from "astro:assets";
import logoMark from "../assets/brand/logo.svg";
import logoMarkDark from "../assets/brand/logo_dark.svg";
import kofiIcon from "../assets/brand/kofi_symbol.svg";
import kiwiSolutions from "../assets/brand/kiwi-solutions.png";
import ogImage from "../assets/brand/logo_wordmark.png";
import "../styles/landing.css";
import "../styles/learn.css";

interface Props {
  // The active Learn tab's slug (drives aria-current + styling).
  active: string;
  title: string;
  description: string;
}
const { active, title, description } = Astro.props;

const repo = "https://github.com/hajiboy95/KiwiDesk";
const kofi = "https://ko-fi.com/kiwisolutions";
const makerProfile = "https://github.com/hajiboy95";

// The Learn sub-nav tabs, in order. The first page
// (getting-started) is live; the rest 404 until built — the
// links are kept intentionally so the IA is complete on day one.
const tabs = [
  { slug: "getting-started", href: "/learn/getting-started/",
    label: "Getting started" },
  { slug: "layouts", href: "/learn/layouts/", label: "Layouts" },
  { slug: "favorite-layout", href: "/learn/favorite-layout/",
    label: "Your favorite" },
  { slug: "settings", href: "/learn/settings/",
    label: "Settings" },
  { slug: "faq", href: "/learn/faq/", label: "FAQ" },
  { slug: "is-it-for-me", href: "/learn/is-it-for-me/",
    label: "Is it for me?" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport"
      content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image"
      content={new URL(ogImage.src, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#101d0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Anti-FOUC: resolve the theme before first paint so the
         page never flashes the wrong theme. Shares the exact
         `starlight-theme` key with the landing + docs, so a
         toggle anywhere carries across the whole site. (No mode
         key here — Learn pages are never mode-gated.) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem("starlight-theme");
          root.dataset.theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)")
                  .matches
                ? "dark"
                : "light";
        } catch (e) {
          root.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <!-- ============ Site nav (no mode toggle) ============ -->
    <nav class="nav" id="nav">
      <div class="wrap nav__inner">
        <a class="nav__brand" href="/" aria-label="KiwiDesk home">
          <img class="nav__mark nav__mark--light" src={logoMark.src}
            width="28" height="28" alt="" aria-hidden="true" />
          <img class="nav__mark nav__mark--dark"
            src={logoMarkDark.src} width="28" height="28" alt=""
            aria-hidden="true" />
          <span>KiwiDesk</span>
        </a>
        <div class="nav__links">
          <a class="nav__link" href="/docs/">Docs</a>
          <a class="nav__support" href={kofi} target="_blank"
            rel="noopener" aria-label="Support on Ko-fi">
            <img class="kofi-icon" src={kofiIcon.src} alt=""
              aria-hidden="true" width="20" height="16" />
          </a>

          <!-- Language switcher — same compact EN | DE control as
               the landing, sharing `kiwidesk-site-lang`. English
               Learn pages exist today; the DE segment points at
               the German landing home until German Learn ships. -->
          <div class="lang-switch" role="group"
            aria-label="Choose language">
            <a class="lang-switch__opt" data-lang="en" href="/learn/"
              lang="en" aria-current="true">EN</a>
            <span class="lang-switch__sep" aria-hidden="true"></span>
            <a class="lang-switch__opt" data-lang="de" href="/de/"
              lang="de">DE</a>
          </div>

          <button class="theme-toggle" id="themeToggle" type="button"
            aria-label="Switch color theme" aria-pressed="false">
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb">
                <svg class="theme-toggle__sun" width="15" height="15"
                  viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.2"
                  stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7
                    17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7
                    6.3l1.4-1.4" />
                </svg>
                <svg class="theme-toggle__moon" width="14"
                  height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.2"
                  stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8
                    9.8Z" />
                </svg>
              </span>
            </span>
          </button>
        </div>
      </div>
    </nav>

    <!-- ============ Learn sub-nav (tab row) ============ -->
    <nav class="learn-subnav" aria-label="Learn sections">
      <div class="wrap learn-subnav__inner">
        {tabs.map((tab) => (
          <a class="learn-subnav__tab" href={tab.href}
            aria-current={active === tab.slug ? "page" : undefined}>
            {tab.label}
          </a>
        ))}
      </div>
    </nav>

    <!-- ============ Page content ============ -->
    <main class="learn">
      <div class="wrap">
        <div class="learn__col">
          <slot />
        </div>
      </div>
    </main>

    <!-- ============ Footer ============ -->
    <footer class="footer">
      <div class="wrap">
        <div class="footer__brand">
          <Image class="footer__logo" src={kiwiSolutions}
            alt="Kiwi Solutions" widths={[110, 160, 220]}
            sizes="110px" />
          <p class="footer__name">Kiwi Solutions</p>
          <p class="footer__tag">just a bunch of kiwis 🥝🥝🥝</p>
        </div>
        <a class="footer__kofi" href={kofi} target="_blank"
          rel="noopener">
          <img class="kofi-icon" src={kofiIcon.src} alt=""
            aria-hidden="true" width="20" height="16" />
          Support on Ko-fi
        </a>
        <nav class="footer__links" aria-label="Footer">
          <a href="/">Home</a>
          <a href="/docs/">Docs</a>
          <a href={repo} target="_blank" rel="noopener">GitHub</a>
        </nav>
        <p class="footer__copy">© 2026 KiwiDesk</p>
        <p class="footer__credit">
          Built by
          <a href={makerProfile} target="_blank" rel="noopener">
            Maikel · @hajiboy95
          </a>
        </p>
        <p class="footer__daily">
          Now go eat a kiwi. Your vitamins will thank you. 🥝
        </p>
      </div>
    </footer>

    <script>
      const html = document.documentElement;

      // ---- Theme toggle (shared `starlight-theme` key) ----
      // Identical behavior to Landing.astro so a toggle on either
      // page updates the other via the `storage` event.
      const themeToggle = document.getElementById("themeToggle");
      const syncTheme = () => {
        const dark = html.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(dark));
      };
      syncTheme();
      themeToggle?.addEventListener("click", () => {
        const next =
          html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch (e) {
          /* storage unavailable — theme still applies in-page */
        }
        syncTheme();
      });
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          if (e.newValue === "light" || e.newValue === "dark") {
            html.dataset.theme = e.newValue;
            syncTheme();
          }
        }
      });

      // ---- Language switcher (own `kiwidesk-site-lang` key) ----
      // Persist the explicit choice so the landing's <head> lang
      // resolver honors it on later visits. Navigation proceeds
      // normally after the handler (no preventDefault).
      document
        .querySelectorAll(".lang-switch__opt")
        .forEach((opt) => {
          opt.addEventListener("click", () => {
            const lang = opt.getAttribute("data-lang");
            if (lang !== "en" && lang !== "de") return;
            try {
              localStorage.setItem("kiwidesk-site-lang", lang);
            } catch (e) {
              /* storage unavailable — route change still works */
            }
          });
        });

      // ---- Nav background on scroll ----
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav?.classList.add("scrolled");
        else nav?.classList.remove("scrolled");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    </script>
  </body>
</html>
