    <script>
      const html = document.documentElement;

      // ---- Theme toggle (shared `starlight-theme` key) ----
      const themeToggle = document.getElementById("themeToggle");
      const syncTheme = () => {
        const dark = html.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(dark));
      };
      syncTheme();
      themeToggle?.addEventListener("click", () => {
        const next =
          html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch (e) {
          /* storage unavailable — theme still applies in-page */
        }
        syncTheme();
      });
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          if (e.newValue === "light" || e.newValue === "dark") {
            html.dataset.theme = e.newValue;
            syncTheme();
          }
        }
        if (e.key === "kiwidesk-site-mode") {
          html.dataset.mode = e.newValue === "dev" ? "dev" : "simple";
          syncMode();
        }
      });

      // ---- Mode toggle (own `kiwidesk-site-mode` key) ----
      // Both modes' content lives in the DOM; `data-mode` on <html>
      // shows/hides via CSS, so switching never reloads and the
      // reveal can be a pure CSS transition.
      const modeToggle = document.getElementById("modeToggle");
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      const syncMode = () => {
        const dev = html.dataset.mode === "dev";
        modeToggle?.setAttribute("aria-pressed", String(dev));
      };
      syncMode();
      modeToggle?.addEventListener("click", () => {
        const next = html.dataset.mode === "dev" ? "simple" : "dev";
        html.dataset.mode = next;
        try {
          localStorage.setItem("kiwidesk-site-mode", next);
        } catch (e) {
          /* storage unavailable — mode still applies in-page */
        }
        syncMode();
        // Playful reveal flourish: a brief accent glow on the nav
        // + a "grid forms" class the dev sections animate from.
        if (!reduce && next === "dev") {
          html.classList.add("mode-flourish");
          window.setTimeout(
            () => html.classList.remove("mode-flourish"),
            900
          );
        }
        // Sections hidden while the OTHER mode was active never had
        // their scroll-reveal fire (IntersectionObserver can't see a
        // display:none element). After a switch, reveal any that are
        // now on screen so they aren't stuck invisible.
        window.requestAnimationFrame(revealVisible);
      });

      // ---- Nav background on scroll ----
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav?.classList.add("scrolled");
        else nav?.classList.remove("scrolled");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // ---- Click-to-play demo video ----
      const video = document.getElementById("demoVideo") as
        | HTMLVideoElement
        | null;
      const overlay = document.getElementById("demoOverlay");
      overlay?.addEventListener("click", () => {
        if (overlay) overlay.hidden = true;
        video?.play?.();
      });
      video?.addEventListener("play", () => {
        if (overlay) overlay.hidden = true;
      });
      video?.addEventListener("pause", () => {
        if (overlay && video.currentTime === 0) overlay.hidden = false;
      });

      // ---- Copy the build commands ----
      const copyBtn = document.getElementById("copyBuild");
      const copyLabel = copyBtn?.querySelector(".code__copy-label");
      copyBtn?.addEventListener("click", async () => {
        const text = copyBtn.getAttribute("data-copy") || "";
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.classList.add("is-copied");
          if (copyLabel) copyLabel.textContent = "Copied";
          setTimeout(() => {
            copyBtn.classList.remove("is-copied");
            if (copyLabel) copyLabel.textContent = "Copy";
          }, 1600);
        } catch (e) {
          /* clipboard blocked — no-op */
        }
      });

      // ---- Scroll reveal (motion-aware) ----
      // Reveal every .reveal element currently within the viewport.
      // Called on load's IO fallback path and after a mode switch.
      function revealVisible() {
        document.querySelectorAll(".reveal:not(.in)").forEach((el) => {
          const r = el.getBoundingClientRect();
          const h = window.innerHeight || 0;
          // Skip hidden (display:none → zero rect) elements.
          if (r.width === 0 && r.height === 0) return;
          if (r.top < h * 0.92 && r.bottom > 0) el.classList.add("in");
        });
      }

      const els = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      }

      // ---- Card cursor-follow glow ----
      document.querySelectorAll(".card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          (card as HTMLElement).style.setProperty(
            "--mx",
            `${((e.clientX - r.left) / r.width) * 100}%`
          );
        });
      });
    </script>
  </body>
</html>
