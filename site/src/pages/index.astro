    <!-- Anti-FOUC: resolve theme AND mode before first paint so the
         page never flashes the wrong theme or reveals dev sections.
         `starlight-theme` is shared with the docs; `kiwidesk-site-
         mode` is this page's own key (default = simple). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem("starlight-theme");
          root.dataset.theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)")
                  .matches
                ? "dark"
                : "light";
        } catch (e) {
          root.dataset.theme = "dark";
        }
        try {
          var m = localStorage.getItem("kiwidesk-site-mode");
          root.dataset.mode = m === "dev" ? "dev" : "simple";
        } catch (e) {
          root.dataset.mode = "simple";
        }
      })();
    </script>
  </head>
  <body>
