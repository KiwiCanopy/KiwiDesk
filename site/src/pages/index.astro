// Inline feature icons (stroke-based, consistent 24x24 grid).
function iconSvg(name: string): string {
  const S = (p: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" ` +
    `stroke-width="1.9" stroke-linecap="round" ` +
    `stroke-linejoin="round">${p}</svg>`;
  switch (name) {
    case "layers":
      return S(
        `<path d="M12 3 2 8l10 5 10-5-10-5Z"/>` +
          `<path d="M2 13l10 5 10-5"/>`
      );
    case "grid":
      return S(
        `<rect x="3" y="3" width="7" height="7" rx="1"/>` +
          `<rect x="14" y="3" width="7" height="7" rx="1"/>` +
          `<rect x="3" y="14" width="7" height="7" rx="1"/>` +
          `<rect x="14" y="14" width="7" height="7" rx="1"/>`
      );
    case "code":
      return S(`<path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/>`);
    case "terminal":
      return S(`<path d="m5 7 5 5-5 5"/><path d="M13 17h6"/>`);
    case "wave":
      return S(
        `<path d="M2 12c2 0 2-5 4-5s2 10 4 10 2-10 4-10 2 5 4 5"/>`
      );
    case "shield":
      return S(
        `<path d="M12 3 5 6v5c0 4 3 7 7 8 4-1 7-4 7-8V6l-7-3Z"/>` +
          `<path d="m9 12 2 2 4-4"/>`
      );
    default:
      return S(`<circle cx="12" cy="12" r="9"/>`);
  }
}

// Tiny inline diagrams per layout (viewBox 0 0 160 90).
function layoutDiagram(name: string): string {
  const svg = (p: string) =>
    `<svg viewBox="0 0 160 90" preserveAspectRatio="none">${p}</svg>`;
  const r = (
    x: number,
    y: number,
    w: number,
    h: number,
    cls = "tile"
  ) =>
    `<rect x="${x}" y="${y}" width="${w}" height="${h}" ` +
    `rx="4" class="${cls}"/>`;
  switch (name) {
    case "bsp":
      return svg(
        r(8, 8, 70, 74) +
          r(84, 8, 68, 34) +
          r(84, 48, 32, 34) +
          r(120, 48, 32, 34)
      );
    case "stack":
      return svg(
        r(8, 8, 92, 74, "tile tile--accent") +
          r(106, 8, 46, 22) +
          r(106, 34, 46, 22) +
          r(106, 60, 46, 22)
      );
    case "scrolling":
      return svg(
        r(-24, 8, 44, 74, "tile tile--ghost") +
          r(26, 8, 44, 74) +
          r(76, 8, 44, 74, "tile tile--accent") +
          r(126, 8, 44, 74) +
          r(176, 8, 44, 74, "tile tile--ghost")
      );
    case "monocle":
      return svg(
        r(20, 14, 120, 62, "tile tile--ghost") +
          r(14, 10, 120, 62, "tile tile--ghost") +
          r(8, 6, 120, 62, "tile tile--accent")
      );
    case "grid":
      return svg(
        r(8, 8, 44, 34) +
          r(58, 8, 44, 34) +
          r(108, 8, 44, 34) +
          r(8, 48, 44, 34) +
          r(58, 48, 44, 34) +
          r(108, 48, 44, 34)
      );
    case "floating":
      return svg(
        r(14, 12, 62, 44) +
          r(60, 34, 66, 46, "tile tile--accent") +
          r(96, 10, 52, 32)
      );
    default:
      return svg(r(8, 8, 144, 74));
  }
}

