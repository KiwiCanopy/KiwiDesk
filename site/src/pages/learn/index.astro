                      </div>
                      <div class="learn-scenario__side">
                        <span class="learn-scenario__label
                          learn-scenario__label--after">After</span>
                        <p>{s.after}</p>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <div class="learn-close">
                <h2>Ready to give your screen some peace?</h2>
                <p>
                  Head back and grab KiwiDesk — it takes about a
                  minute, and your windows will thank you.
                </p>
                <a class="btn btn--primary" href="/#getting-started">
                  Get KiwiDesk
                  <svg width="16" height="16" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </section>
          </div>
        </div>
      </div>
    </main>

