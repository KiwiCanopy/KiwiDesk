---
// KiwiDesk — Learn (single-page newcomer guide) at /learn/.
//
// One page a newcomer scrolls through, with a sticky table of
// contents and six anchored sections: getting started, the
// layouts, finding your favorite, the Settings app, an FAQ, and
// "is KiwiDesk for you?". Warm, plain-language, non-technical
// voice (matches the landing's Simple mode). Every fact is
// grounded in docs/user-guide.md (onboarding wizard, the
// Accessibility permission, no SIP, the Settings sections,
// profiles/layouts) and docs/cli.md (`kiwidesk service start`).
//
// Released framing: the install copy is written as if KiwiDesk
// has shipped — a placeholder App Store button (href="#") plus a
// Homebrew cask — even though the LANDING hero stays its "coming
// soon" teaser. This is launch-prep copy.
//
// English only for now (issue #9 defers German for /learn/). The
// copy is inlined; when a German /learn/ ships it can move behind
// a per-locale strings prop the way Landing.astro does. This page
// folds the whole shell in (nav without the mode toggle, footer,
// theme toggle + anti-FOUC) — there is no LearnLayout wrapper.
//
// Language switcher: OMITTED here. German /learn/ does not exist
// yet, and pointing "DE" at the German landing would silently
// throw a reader off the guide they're on. The nav keeps only a
// "Back to home" affordance; the switcher returns once German
// Learn content ships.
import { Image } from "astro:assets";
import logoMark from "../../assets/brand/logo.svg";
import logoMarkDark from "../../assets/brand/logo_dark.svg";
import kofiIcon from "../../assets/brand/kofi_symbol.svg";
import kiwiSolutions from "../../assets/brand/kiwi-solutions.png";
import ogImage from "../../assets/brand/logo_wordmark.png";
import { layoutDiagram } from "../../lib/layoutDiagram";
import "../../styles/landing.css";
import "../../styles/learn.css";

const repo = "https://github.com/hajiboy95/KiwiDesk";
const kofi = "https://ko-fi.com/kiwisolutions";
const makerProfile = "https://github.com/hajiboy95";
const brewCmd = "brew install --cask kiwidesk\nkiwidesk service start";

const title = "Learn KiwiDesk — a calm, tidy Mac in a few minutes";
const description =
  "New to KiwiDesk? A friendly, plain-language walkthrough: " +
  "installing, the layouts, the Settings app, and whether it's " +
  "right for you.";

// The table of contents — drives both the desktop rail and the
// mobile dropdown. Order matches the sections below.
const toc = [
  { id: "getting-started", label: "Getting started" },
  { id: "layouts", label: "The layouts" },
  { id: "favorite", label: "Finding your favorite" },
  { id: "settings", label: "The Settings app" },
  { id: "faq", label: "FAQ" },
  { id: "is-it-for-me", label: "Is KiwiDesk for you?" },
];

// The six layouts, each a friendly one-liner. Diagrams come from
// the shared helper so they match the landing exactly.
const layouts = [
  {
    name: "stack",
    desc:
      "One big window holds your focus, with the rest lined up " +
      "neatly beside it — glance over, tap to switch.",
  },
  {
    name: "bsp",
    desc:
      "Windows split the screen into tidy panes, each new one " +
      "halving the space it lands in. Balanced, edge to edge.",
  },
  {
    name: "scrolling",
    desc:
      "Windows sit in a row you scroll through, like columns on a " +
      "long desk — the focused one always front and center.",
  },
  {
    name: "monocle",
    desc:
      "One window fills the screen while the others wait quietly " +
      "behind it. Pure focus, no distractions.",
  },
  {
    name: "grid",
    desc:
      "Everything laid out in even rows and columns — see all your " +
      "windows at once, each with its own equal square.",
  },
  {
    name: "floating",
    desc:
      "The plain macOS way: windows float freely, right where you " +
      "drag them. KiwiDesk leaves these ones alone.",
  },
];

// The Settings window's sections, grouped as the app shows them
// (Design = per-profile, System = global). Grounded in
// docs/user-guide.md.
const tour = [
  {
    title: "Spaces",
    body:
      "Name the workspaces you use — “web”, “mail”, a number — and " +
      "KiwiDesk keeps each one tidy on its own.",
  },
  {
    title: "Layout",
    body:
      "Pick a layout for each space and set the gaps between " +
      "windows. This is where you choose your favorite arrangement.",
  },
  {
    title: "Monitors",
    body:
      "Have more than one display? Pin a space to a screen by " +
      "dragging it onto that monitor. Handy when you dock and undock.",
  },
  {
    title: "Appearance",
    body:
      "Tune the little visuals — like the soft highlight that shows " +
      "where a window will land when you drag it.",
  },
  {
    title: "Behavior",
    body:
      "Adjust how things feel: how quickly windows glide, what " +
      "happens on wake from sleep, and where new windows appear.",
  },
  {
    title: "Profiles",
    body:
      "Save a whole setup as a profile and switch between them — one " +
      "for focused work, another for a second screen at your desk.",
  },
  {
    title: "Shortcuts",
    body:
      "See and change the keyboard shortcuts, recorded by simply " +
      "pressing the keys you want. Every conflict is flagged for you.",
  },
  {
    title: "App Rules & General",
    body:
      "Send an app to a chosen space, keep certain windows floating, " +
      "and pick the Settings language — all point-and-click.",
  },
];

// Section-badge glyphs for the "is it for you" scenarios.
function scenarioIcon(name: string): string {
  const S = (p: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" ` +
    `stroke-width="1.8" stroke-linecap="round" ` +
    `stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
  switch (name) {
    case "writer":
      return S(
        `<path d="M12 20h9"/>` +
          `<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>`
      );
    case "designer":
      return S(
        `<circle cx="13.5" cy="6.5" r="1.5"/>` +
          `<circle cx="17.5" cy="10.5" r="1.5"/>` +
          `<circle cx="8.5" cy="7.5" r="1.5"/>` +
          `<circle cx="6.5" cy="12.5" r="1.5"/>` +
          `<path d="M12 2a10 10 0 1 0 0 20 2.5 2.5 0 0 0 2-4 2.5 ` +
          `2.5 0 0 1 2-4h1a3 3 0 0 0 3-3 8 8 0 0 0-8-9Z"/>`
      );
    case "calls":
      return S(
        `<path d="M23 7l-7 5 7 5V7Z"/>` +
          `<rect x="1" y="5" width="15" height="14" rx="2"/>`
      );
    default:
      return S(`<circle cx="12" cy="12" r="9"/>`);
  }
}

const scenarios = [
  {
    icon: "writer",
    name: "A writer juggling research",
    before:
      "Notes, three browser tabs pulled out into windows, and the " +
      "draft — all overlapping. Half your time goes to hunting for " +
      "the window you just had.",
    after:
      "The draft sits front and center, sources lined up beside it. " +
      "You glance over, keep writing, and never lose your place.",
  },
  {
    icon: "designer",
    name: "A designer with many panels",
    before:
      "Canvas, layers, an inspector, a reference image — a dozen " +
      "floating panels you nudge into place at the start of every " +
      "session.",
    after:
      "Everything snaps into a balanced arrangement the moment you " +
      "open it. More screen for the work, less for the fiddling.",
  },
  {
    icon: "calls",
    name: "Someone in back-to-back calls",
    before:
      "The call window buries your notes. You scramble to find " +
      "them, then lose the call behind something else.",
    after:
      "Notes stay visible right beside the call, side by side. You " +
      "stay present instead of shuffling windows.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport"
      content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image"
      content={new URL(ogImage.src, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#101d0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Anti-FOUC: resolve the theme before first paint so the
         page never flashes the wrong theme. Shares the exact
         `starlight-theme` key with the landing + docs, so a
         toggle anywhere carries across the whole site. (No mode
         key here — Learn is never mode-gated.) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem("starlight-theme");
          root.dataset.theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)")
                  .matches
                ? "dark"
                : "light";
        } catch (e) {
          root.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <!-- ============ Site nav (no mode toggle, no tab bar) ====== -->
    <nav class="nav" id="nav">
      <div class="wrap nav__inner">
        <a class="nav__brand" href="/" aria-label="KiwiDesk home">
          <img class="nav__mark nav__mark--light" src={logoMark.src}
            width="28" height="28" alt="" aria-hidden="true" />
          <img class="nav__mark nav__mark--dark"
            src={logoMarkDark.src} width="28" height="28" alt=""
            aria-hidden="true" />
          <span>KiwiDesk</span>
        </a>
        <div class="nav__links">
          <a class="learn-back" href="/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M11 6l-6 6 6 6" />
            </svg>
            <span class="learn-back__text">Back to home</span>
          </a>
          <button class="theme-toggle" id="themeToggle" type="button"
            aria-label="Switch color theme" aria-pressed="false">
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb">
                <svg class="theme-toggle__sun" width="15" height="15"
                  viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.2"
                  stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7
                    17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7
                    6.3l1.4-1.4" />
                </svg>
                <svg class="theme-toggle__moon" width="14"
                  height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.2"
                  stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8
                    9.8Z" />
                </svg>
              </span>
            </span>
          </button>
        </div>
      </div>
    </nav>

    <!-- ============ Mobile TOC (sticky "On this page") ========= -->
    <details class="learn-toc learn-toc--mobile" id="tocMobile">
      <summary aria-label="On this page">
        <span class="wrap learn-toc__summary-inner">
          <svg class="learn-toc__chevron" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
          On this page
          <span class="learn-toc__count">{toc.length} sections</span>
        </span>
      </summary>
      <div class="learn-toc__panel wrap">
        <ul class="learn-toc__list">
          {toc.map((item) => (
            <li>
              <a class="learn-toc__link" href={`#${item.id}`}
                data-toc={item.id}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <!-- ============ Page content ============ -->
    <main class="learn" id="learnMain">
      <div class="wrap">
        <div class="learn__layout">
          <!-- Desktop sticky TOC rail -->
          <nav class="learn-toc learn-toc--desktop"
            aria-label="On this page">
            <p class="learn-toc__label">On this page</p>
            <ul class="learn-toc__list">
              {toc.map((item) => (
                <li>
                  <a class="learn-toc__link" href={`#${item.id}`}
                    data-toc={item.id}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="learn__col">
            <header class="learn__head">
              <span class="learn__eyebrow">Learn</span>
              <h1 class="learn__title">
                A calmer Mac, in a few minutes.
              </h1>
              <p class="learn__lede">
                No manual, no setup rituals. This is the friendly
                tour — what KiwiDesk does, how to make it yours, and
                whether it's the right fit. Scroll through, or jump
                to any part from the list.
              </p>
            </header>

            <!-- ===== 1. Getting started ===== -->
            <section class="learn-section" id="getting-started">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow">Step one</span>
                <h2>Getting started</h2>
              </div>
              <p>
                Installing KiwiDesk takes about a minute. Grab it
                from the Mac App Store for a one-click install, or
                use Homebrew if you like the Terminal.
              </p>

              <div class="learn-install">
                <a class="appstore-btn" href="#"
                  aria-label="Download KiwiDesk on the App Store">
                  <span class="appstore-btn__glyph">
                    <svg viewBox="0 0 24 24" fill="currentColor"
                      aria-hidden="true">
                      <path d="M17.05 12.54c-.02-2.06 1.68-3.05
                        1.76-3.1-0.96-1.4-2.45-1.6-2.98-1.62-1.27-.13-2.48.75-3.12.75-.64
                        0-1.64-.73-2.7-.71-1.39.02-2.67.81-3.38
                        2.05-1.44 2.5-.37 6.2 1.03 8.23.68.99
                        1.5 2.1 2.56 2.06 1.03-.04 1.42-.66
                        2.66-.66 1.24 0 1.59.66 2.68.64 1.1-.02
                        1.8-1.01 2.48-2 .78-1.15 1.1-2.26
                        1.12-2.32-.02-.01-2.15-.83-2.17-3.27ZM15.1
                        6.63c.56-.68.94-1.63.84-2.58-.81.03-1.79.54-2.37
                        1.22-.52.6-.98 1.56-.86 2.48.9.07
                        1.83-.46 2.39-1.12Z" />
                    </svg>
                  </span>
                  <span class="appstore-btn__copy">
                    <span class="appstore-btn__small"
                      >Download on the</span>
                    <span class="appstore-btn__big">App Store</span>
                  </span>
                </a>
                <span class="learn-install__or">or with Homebrew</span>
              </div>

              <div class="code"
                aria-label="Install KiwiDesk with Homebrew">
                <div class="code__bar">
                  <span class="code__dot" aria-hidden="true"></span>
                  <span class="code__dot" aria-hidden="true"></span>
                  <span class="code__dot" aria-hidden="true"></span>
                  <span class="code__title">Terminal</span>
                  <button class="code__copy" id="copyBrew"
                    type="button" data-copy={brewCmd}
                    aria-label="Copy install commands">
                    <svg class="code__copy-icon" width="15"
                      height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"
                      aria-hidden="true">
                      <rect x="9" y="9" width="12" height="12"
                        rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1
                        2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <span class="code__copy-label">Copy</span>
                  </button>
                </div>
                <pre><code><span class="prompt">$</span> brew install --cask kiwidesk
<span class="prompt">$</span> kiwidesk service start
<span class="cmt"># that's it — KiwiDesk is now running in your menu bar</span></code></pre>
              </div>

              <p class="learn__store-note">
                <svg viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <path d="M12 3 5 6v5c0 4 3 7 7 8 4-1 7-4
                    7-8V6l-7-3Z" />
                </svg>
                Requires macOS 14 or later. The App Store link is a
                placeholder while we finish the launch — Homebrew
                works today.
              </p>

              <p class="learn-sub">The one permission it asks for</p>
              <p>
                The first time you open KiwiDesk, macOS asks you to
                grant <strong>Accessibility</strong> access. This is
                the normal, expected prompt — and it's the only
                thing KiwiDesk needs from you. To tidy your screen,
                it has to be able to move and resize your windows,
                and macOS keeps that ability behind this permission.
                A short onboarding wizard walks you to the right spot
                in <strong>System Settings › Privacy &amp; Security ›
                Accessibility</strong> and helps you switch it on.
              </p>

              <div class="learn-callout learn-callout--trust">
                <span class="learn-callout__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.9"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3 5 6v5c0 4 3 7 7 8 4-1 7-4
                      7-8V6l-7-3Z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                </span>
                <div class="learn-callout__body">
                  <h3>What it never does</h3>
                  <p>
                    KiwiDesk stays entirely in normal user space, so
                    the things people worry about simply aren't part
                    of how it works:
                  </p>
                  <ul class="learn-checklist">
                    <li>
                      <span class="learn-checklist__check"
                        aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                      </span>
                      It never asks you to disable SIP (your Mac's
                      built-in System Integrity Protection). Your
                      Mac's protections stay exactly as they are.
                    </li>
                    <li>
                      <span class="learn-checklist__check"
                        aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                      </span>
                      It never needs Input Monitoring. Its keyboard
                      shortcuts use a built-in macOS mechanism, so it
                      isn't — and can't be — a keylogger.
                    </li>
                  </ul>
                </div>
              </div>

              <p class="learn-sub">Your first tidy window</p>
              <p>
                With the permission granted, KiwiDesk gets to work.
                The moment you have a window open, you'll see it
                settle neatly into place — filling its share of the
                screen, edge to edge, with no overlap. Open a second
                and the two share the space side by side. Nothing is
                buried, nothing is hunted for. You keep working the
                way you always do; the arranging just happens.
              </p>

              <div class="learn-snap" aria-hidden="true">
                <svg viewBox="0 0 320 150"
                  preserveAspectRatio="xMidYMid meet">
                  <rect x="18" y="24" width="96" height="70" rx="6"
                    class="tile tile--ghost" />
                  <path d="M132 59h34m0 0-9-9m9 9-9 9" fill="none"
                    stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" stroke-linejoin="round"
                    style="color: var(--text-faint)" />
                  <rect x="188" y="18" width="56" height="112" rx="6"
                    class="tile" />
                  <rect x="248" y="18" width="56" height="53" rx="6"
                    class="tile tile--accent" />
                  <rect x="248" y="77" width="56" height="53" rx="6"
                    class="tile" />
                </svg>
              </div>
            </section>

            <!-- ===== 2. The layouts ===== -->
            <section class="learn-section" id="layouts">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow">The shapes</span>
                <h2>The layouts</h2>
              </div>
              <p>
                A “layout” is just the shape your windows arrange
                themselves into. KiwiDesk has six. You don't have to
                learn them all — most people find one they like and
                stay there. Here's each, in plain language.
              </p>
              <div class="layouts">
                {layouts.map((l) => (
                  <article class="layout-card">
                    <div class="layout-card__diagram"
                      aria-hidden="true">
                      <Fragment set:html={layoutDiagram(l.name)} />
                    </div>
                    <h3>{l.name}</h3>
                    <p>{l.desc}</p>
                  </article>
                ))}
              </div>
            </section>

            <!-- ===== 3. Finding your favorite ===== -->
            <section class="learn-section" id="favorite">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >Make it yours</span>
                <h2>Finding your favorite</h2>
              </div>
              <p>
                The best way to find your layout is to try a few and
                feel which one suits your day. Open the Settings
                window from KiwiDesk's menu-bar icon, go to
                <strong>Layout</strong>, and pick a mode for the
                space you're on. Your windows rearrange right away, so
                you can see each one live — switch, look, switch
                again.
              </p>
              <p>
                When one feels right, it's already saved for that
                space. You can even give different spaces different
                layouts: a focused <strong>stack</strong> for
                writing, a wide <strong>scrolling</strong> row for
                research, whatever fits.
              </p>
              <div class="learn-callout">
                <span class="learn-callout__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.9"
                    stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 16v-4M12 8h.01" />
                  </svg>
                </span>
                <div class="learn-callout__body">
                  <h3>It's okay to change your mind</h3>
                  <p>
                    Nothing here is permanent. Switch layouts as
                    often as you like — there's no wrong choice, and
                    you can always go back. KiwiDesk only ever moves
                    and resizes windows; it never touches your files
                    or your apps.
                  </p>
                </div>
              </div>
            </section>

            <!-- ===== 4. The Settings app ===== -->
            <section class="learn-section" id="settings">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >Point and click</span>
                <h2>The Settings app</h2>
              </div>
              <p>
                Everything is point-and-click — you never need to
                edit a file. Open <strong>Settings</strong> from the
                KiwiDesk menu in your menu bar. A sidebar on the left
                groups things into <strong>Design</strong> (the look
                and feel of the profile you're working on) and
                <strong>System</strong> (settings that apply
                everywhere). Here's what each section is for.
              </p>
              <ul class="learn-tour">
                {tour.map((s) => (
                  <li>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </li>
                ))}
              </ul>
            </section>

            <!-- ===== 5. FAQ ===== -->
            <section class="learn-section" id="faq">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >Good questions</span>
                <h2>FAQ</h2>
              </div>
              <div class="learn-faq">
                <details class="learn-faq__item">
                  <summary class="learn-faq__q">
                    Do I need to know Lua or write any code?
                    <svg class="learn-faq__icon" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <div class="learn-faq__a">
                    <p>
                      No. The Settings app covers everything —
                      layouts, gaps, monitors, shortcuts, app rules —
                      all with clicks and sliders. Lua is there for
                      tinkerers who want to script their setup, but
                      it's entirely optional. Most people never open
                      a config file.
                    </p>
                  </div>
                </details>

                <details class="learn-faq__item">
                  <summary class="learn-faq__q">
                    Does it replace Mission Control or Spaces?
                    <svg class="learn-faq__icon" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <div class="learn-faq__a">
                    <p>
                      No — it works alongside them. KiwiDesk arranges
                      the windows within your workspaces; your macOS
                      desktops and Mission Control keep working just
                      as they do now. You can even assign a different
                      setup to each Mission Control desktop, so it
                      switches automatically as you move between them.
                    </p>
                  </div>
                </details>

                <details class="learn-faq__item">
                  <summary class="learn-faq__q">
                    Is my data private?
                    <svg class="learn-faq__icon" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <div class="learn-faq__a">
                    <p>
                      Yes. KiwiDesk runs entirely on your Mac, in
                      normal user space. It only moves and resizes
                      windows — it never reads your files, and it
                      isn't a keylogger (its shortcuts use a built-in
                      macOS mechanism, not keyboard monitoring). It
                      never asks you to weaken your Mac's built-in
                      protections.
                    </p>
                  </div>
                </details>

                <details class="learn-faq__item">
                  <summary class="learn-faq__q">
                    Will it slow down my Mac or drain the battery?
                    <svg class="learn-faq__icon" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <div class="learn-faq__a">
                    <p>
                      KiwiDesk is a small, native macOS app built to
                      sit quietly in the background. It only does work
                      when your windows actually change, and its
                      animations run at each display's own natural
                      refresh rate. Day to day, you shouldn't notice
                      it in the background at all. If you'd rather it
                      not animate when switching desktops, that's a
                      one-click setting in Behavior.
                    </p>
                  </div>
                </details>

                <details class="learn-faq__item">
                  <summary class="learn-faq__q">
                    How do I uninstall it?
                    <svg class="learn-faq__icon" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor"
                      stroke-width="2.2" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <div class="learn-faq__a">
                    <p>
                      Quit KiwiDesk from its menu-bar icon and remove
                      the app like any other. If you installed it with
                      Homebrew, run
                      <code>brew uninstall --cask kiwidesk</code>.
                      The moment it's off, your windows behave exactly
                      like normal macOS windows again — free to drag,
                      resize, and overlap. Nothing sticks, and nothing
                      of yours was ever changed.
                    </p>
                  </div>
                </details>
              </div>
            </section>

            <!-- ===== 6. Is KiwiDesk for you? ===== -->
            <section class="learn-section" id="is-it-for-me">
              <div class="learn-section__head">
                <span class="learn-section__eyebrow"
                  >A quick gut-check</span>
                <h2>Is KiwiDesk for you?</h2>
              </div>
              <p>
                If you spend even a little of your day dragging
                windows around, you'll probably feel the difference.
                A few everyday moments, before and after:
              </p>
              <div class="learn-scenarios">
                {scenarios.map((s) => (
                  <article class="learn-scenario">
                    <div class="learn-scenario__who">
                      <span class="learn-scenario__badge">
