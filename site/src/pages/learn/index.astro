    <script>
      const html = document.documentElement;

      // ---- Theme toggle (shared `starlight-theme` key) ----
      const themeToggle = document.getElementById("themeToggle");
      const syncTheme = () => {
        const dark = html.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(dark));
      };
      syncTheme();
      themeToggle?.addEventListener("click", () => {
        const next =
          html.dataset.theme === "dark" ? "light" : "dark";
        html.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch (e) {
          /* storage unavailable — theme still applies in-page */
        }
        syncTheme();
      });
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          if (e.newValue === "light" || e.newValue === "dark") {
            html.dataset.theme = e.newValue;
            syncTheme();
          }
        }
      });

      // ---- Nav background on scroll ----
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav?.classList.add("scrolled");
        else nav?.classList.remove("scrolled");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // ---- Copy the install commands ----
      const copyBtn = document.getElementById("copyBrew");
      const copyLabel = copyBtn?.querySelector(".code__copy-label");
      copyBtn?.addEventListener("click", async () => {
        const text = copyBtn.getAttribute("data-copy") || "";
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.classList.add("is-copied");
          if (copyLabel) copyLabel.textContent = "Copied";
          setTimeout(() => {
            copyBtn.classList.remove("is-copied");
            if (copyLabel) copyLabel.textContent = "Copy";
          }, 1600);
        } catch (e) {
          /* clipboard blocked — no-op */
        }
      });

      // ---- Active-section highlight in the TOC ----
      // Nice-to-have: as each section scrolls into view, mark its
      // TOC link aria-current so the reader always knows where they
      // are. Both the desktop rail and mobile dropdown share the
      // same [data-toc] links, so one observer updates both.
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-toc]")
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>(".learn-section[id]")
      );
      const setActive = (id: string) => {
        tocLinks.forEach((a) => {
          const on = a.getAttribute("data-toc") === id;
          if (on) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        });
      };

      if ("IntersectionObserver" in window && sections.length) {
        // Track which sections are currently intersecting; the
        // topmost one wins the highlight.
        const visible = new Set<string>();
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const id = e.target.id;
              if (e.isIntersecting) visible.add(id);
              else visible.delete(id);
            });
            // Pick the first section (in document order) that's
            // visible, so scrolling down advances predictably.
            const current = sections.find((s) => visible.has(s.id));
            if (current) setActive(current.id);
          },
          { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
        );
        sections.forEach((s) => io.observe(s));
      }

      // ---- Close the mobile TOC after a jump ----
      const tocMobile = document.getElementById(
        "tocMobile"
      ) as HTMLDetailsElement | null;
      tocMobile
        ?.querySelectorAll(".learn-toc__link")
        .forEach((link) => {
          link.addEventListener("click", () => {
            tocMobile.open = false;
          });
        });
    </script>
