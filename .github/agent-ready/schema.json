{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "type",
    "slug",
    "scope",
    "subject",
    "body",
    "not_verified"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "partial",
        "blocked"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "feat",
        "fix",
        "refactor",
        "perf",
        "test",
        "docs",
        "chore"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,50}$"
    },
    "subject": {
      "type": "string",
      "description": "Commit subject without type or scope: lower-case, imperative, no period, e.g. 'keep the master ratio on swap'."
    },
    "body": {
      "type": "string",
      "description": "PR body in Markdown."
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "description": "Conventional Commit scope from AGENTS.md (e.g. layout, tiling, ax), or empty."
    }
  }
}
